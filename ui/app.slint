import { ListView, ScrollView } from "std-widgets.slint";
// Geist, scaled up 3% in the file so it reads the same size as Inter did.
import "../assets/fonts/GeistVariable.ttf";

export struct TrackItem {
    source-index: int,
    number: string,
    title: string,
    artists: string,
    album: string,
    duration: string,
    uri: string,
    art: image,
    has-art: bool,
}

export struct HomeCard {
    title: string,
    subtitle: string,
    art: image,
    has-art: bool,
    round: bool,
}

export struct HomeSection {
    title: string,
    cards: [HomeCard],
    tiles: bool,
    expanded: bool,
}

export struct SearchSuggestion {
    title: string,
    subtitle: string,
    index: int,
    art: image,
}

export struct LyricLine {
    words: string,
    // When it starts in the song. Zero for every line when the lyrics aren't synced.
    start-ms: int,
}

export global AppTheme {
    // A cached row or panel is drawn as a texture, which blurs if it lands between
    // pixels. At 125% or 150% the layout puts things on half pixels, so those scales
    // draw directly: sharp, at a higher CPU cost.
    in-out property <bool> can-cache: true;
    in-out property <color> window-bg: #121214;
    in-out property <color> card-bg: #18181b;
    in-out property <color> panel: #ffffff0d;
    in-out property <color> focus-ring: #ffffff3c;
    in-out property <color> elevated-bg: #212125;
    in-out property <color> border: #242429;
    in-out property <color> hover-bg: #1f1f23;
    in-out property <color> active-bg: #2c2c32;
    in-out property <color> selected-bg: #28282e;
    in-out property <color> pressed-bg: #323238;
    in-out property <color> button-bg: #1e1e21;
    in-out property <color> disabled-bg: #161618;
    in-out property <color> disabled-border: #242429;
    in-out property <color> text: #f5f5f7;
    in-out property <color> secondary-text: #cdcdd2;
    in-out property <color> subtle-text: #a0a0a8;
    in-out property <color> muted-text: #76767e;
    in-out property <color> accent: #1ed760;
    in-out property <color> on-accent: #000000;
    in-out property <color> accent-soft: #1ed76028;
    in-out property <color> accent-border: #1ed7606e;
    in-out property <color> track-bg: #3e3e44;
    in-out property <color> control-fg: #f5f5f7;
    in-out property <color> warning: #f5a524;
    in-out property <color> danger: #e5484d;
    in-out property <color> ambient: #18181b;
    in-out property <color> on-ambient: #ffffffe6;
    in-out property <color> on-ambient-soft: #ffffffa6;
    in-out property <bool> is-light: false;
    in-out property <bool> reduce-motion: false;
    in-out property <bool> flat: false;
    in-out property <duration> motion-duration: reduce-motion ? 0ms : 90ms;
    in-out property <duration> motion-spring: reduce-motion ? 0ms : 180ms;
    in-out property <duration> motion-slow: reduce-motion ? 0ms : 280ms;
    // Rows light up at once and let go quickly, leaving a short trail behind the cursor.
    in-out property <duration> motion-trail-in: reduce-motion ? 0ms : 30ms;
    in-out property <duration> motion-trail-out: reduce-motion ? 0ms : 280ms;
}

// ─── Primitives ────────────────────────────────────────────────────────────

// Glass: an even, faint fill and a thin rim, with no highlight from any one edge.
// Slint has no backdrop blur, so what sits behind stays sharp: anything that has
// to stay readable over content gets a dark tint as its background.
// Goes first inside a panel with `cache-rendering-hint`. A cached panel starts at its
// topmost, leftmost child, and when that child sits between pixels the whole panel
// blurs. This holds the start at the panel's own corner. It needs a background, even
// a clear one: without any, Slint treats it as having no size and ignores it.
component CacheAnchor inherits Rectangle {
    background: transparent;
}

component GlassPane inherits Rectangle {
    in property <float> strength: 1;
    in property <length> radius: 10px;
    property <color> ink: AppTheme.is-light ? #000000 : #ffffff;

    border-radius: root.radius;
    clip: true;
    border-width: 1px;
    border-color: root.ink.with-alpha(0.1 * root.strength);

    Rectangle {
        background: root.ink.with-alpha(0.04 * root.strength);
    }
    @children
}

// A pane of glass that forms behind a row: it lights at once, a glint crosses it
// once, and it lets go a little slower, leaving a short trail behind the cursor.
component GlassHover inherits Rectangle {
    in property <bool> lit: false;
    in property <float> strength: 0.8;
    in property <length> radius: 10px;
    property <color> ink: AppTheme.is-light ? #000000 : #ffffff;
    property <float> glint: root.lit ? 1 : 0;
    property <float> glint-at: 0.07 + root.glint * 0.86;
    animate glint { duration: root.lit && !AppTheme.reduce-motion ? 480ms : 0ms; easing: ease-out; }
    property <float> shown: root.lit ? 1 : 0;
    animate shown { duration: root.lit ? AppTheme.motion-trail-in : AppTheme.motion-trail-out; easing: ease-out; }

    // Only there while it shows: anything see-through gets its own texture from Slint, even when
    // fully clear, and a list has one of these on every row.
    if root.shown > 0.004 : GlassPane {
        x: 0px;
        y: 1px;
        width: parent.width;
        height: parent.height - 2px;
        strength: root.strength;
        radius: root.radius;
        opacity: root.shown;
    }
    if root.lit && root.glint < 0.99 : Rectangle {
        x: 0px;
        y: 1px;
        width: parent.width;
        height: parent.height - 2px;
        border-radius: root.radius;
        background: @linear-gradient(100deg, root.ink.with-alpha(0) root.glint-at - 0.07, root.ink.with-alpha(0.11 * (1 - root.glint)) root.glint-at, root.ink.with-alpha(0) root.glint-at + 0.07);
    }
}

// Text that goes somewhere: brightens, and an underline draws in on hover.
component LinkText inherits Rectangle {
    in property <string> text;
    in property <length> size: 13px;
    in property <color> tint: AppTheme.subtle-text;
    callback clicked();

    preferred-width: label.preferred-width;
    min-width: 0px;
    height: label.preferred-height;

    label := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: self.preferred-height;
        text: root.text;
        color: link-touch.has-hover ? AppTheme.text : root.tint;
        font-size: root.size;
        horizontal-alignment: left;
        overflow: elide;
        animate color { duration: AppTheme.motion-duration; easing: ease-out; }
    }
    link-touch := TouchArea {
        mouse-cursor: root.text != "" ? pointer : default;
        clicked => { if (root.text != "") { root.clicked(); } }
    }
}

// A song's artists, each opening its own page.
// Each name opens its own artist. Names keep their length, and a line too long for its
// space fades out at the end.
component ArtistLinks inherits Rectangle {
    in property <[string]> names;
    in property <length> size: 13px;
    in property <color> tint: AppTheme.subtle-text;
    callback clicked(string);

    preferred-width: line.preferred-width;
    min-width: 0px;
    height: line.preferred-height;
    clip: true;

    line := HorizontalLayout {
        x: 0px;
        width: self.preferred-width;
        alignment: start;
        for name[index] in root.names : HorizontalLayout {
            LinkText { text: name; size: root.size; tint: root.tint; clicked => { root.clicked(name); } }
            if index < root.names.length - 1 : HorizontalLayout {
                padding-right: root.size * 0.3;
                Text { text: ","; color: root.tint; font-size: root.size; }
            }
        }
    }
    if line.preferred-width > root.width : Rectangle {
        x: root.width - self.width;
        width: min(40px, root.width);
        background: @linear-gradient(90deg, AppTheme.window-bg.with-alpha(0) 0%, AppTheme.window-bg 100%);
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 18px;
    in property <color> icon-color: AppTheme.subtle-text;
    in property <bool> active: false;
    in property <bool> show-dot: false;
    in property <bool> enabled: true;
    in property <bool> show-backdrop: true;
    in property <angle> icon-rotation: 0deg;
    // Acts as the button goes down instead of when it comes back up.
    in property <bool> acts-on-press: false;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: self.height / 2;
    background: !root.enabled || !root.show-backdrop ? transparent : (touch.pressed ? AppTheme.pressed-bg : (touch.has-hover ? AppTheme.hover-bg : transparent));
    animate background { duration: AppTheme.motion-duration; easing: ease-out; }

    property <percent> icon-scale: !root.enabled ? 100% : (touch.pressed ? 88% : (touch.has-hover ? 112% : 100%));

    Rectangle {
        visible: !root.show-backdrop && root.enabled;
        width: touch.pressed ? root.height * 0.9 : root.height * 1.05;
        height: self.width;
        border-radius: self.height / 2;
        background: AppTheme.text;
        opacity: touch.pressed ? 0.12 : 0;
        animate opacity { duration: touch.pressed ? 60ms : AppTheme.reduce-motion ? 0ms : 420ms; easing: ease-out; }
        animate width { duration: touch.pressed ? 60ms : AppTheme.reduce-motion ? 0ms : 420ms; easing: ease-out; }
    }

    Image {
        source: root.icon;
        colorize: !root.enabled ? AppTheme.disabled-border : (root.active ? AppTheme.accent : (touch.has-hover ? AppTheme.text : root.icon-color));
        width: root.icon-size;
        height: root.icon-size;
        image-fit: contain;
        transform-rotation: root.icon-rotation;
        transform-scale-x: root.icon-scale;
        transform-scale-y: root.icon-scale;
        animate colorize { duration: AppTheme.motion-duration; easing: ease-out; }
        animate transform-scale-x, transform-scale-y { duration: touch.pressed ? 70ms : AppTheme.motion-spring; easing: ease-out; }
    }

    Rectangle {
        property <length> dot: root.show-dot ? 4px : 0px;
        width: self.dot;
        height: self.dot;
        border-radius: self.dot / 2;
        background: AppTheme.accent;
        y: parent.height - 5px - self.dot / 2;
        animate dot { duration: AppTheme.motion-spring; easing: ease-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        pointer-event(event) => {
            if (root.acts-on-press && event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.clicked();
            }
        }
        clicked => {
            if (!root.acts-on-press) {
                root.clicked();
            }
        }
    }
}

component PlayButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 34px;
    callback clicked();

    width: root.size + 4px;
    height: root.size + 4px;

    Rectangle {
        width: touch.pressed ? root.size * 0.86 : root.size * 1.05;
        height: self.width;
        border-radius: self.height / 2;
        background: AppTheme.text;
        opacity: touch.pressed ? 0.14 : (touch.has-hover ? 0.05 : 0);
        animate opacity { duration: touch.pressed ? 60ms : AppTheme.reduce-motion ? 0ms : 380ms; easing: ease-out; }
        animate width { duration: touch.pressed ? 60ms : AppTheme.reduce-motion ? 0ms : 380ms; easing: ease-out; }
    }

    Image {
        source: root.icon;
        colorize: AppTheme.control-fg;
        width: root.size * 0.56;
        height: root.size * 0.56;
        image-fit: contain;
        transform-scale-x: touch.pressed ? 90% : (touch.has-hover ? 103% : 100%);
        transform-scale-y: touch.pressed ? 90% : (touch.has-hover ? 103% : 100%);
        animate transform-scale-x, transform-scale-y { duration: touch.pressed ? 70ms : AppTheme.motion-spring; easing: ease-out; }
    }

    // Acts as the button goes down instead of when it comes back up.
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.clicked();
            }
        }
    }
}

// The displayed value only follows `value` while not dragging, so the
// binding from the parent is never broken by user interaction.
component SlimSlider inherits Rectangle {
    in property <int> value;
    in property <int> maximum: 100;
    in property <string> tooltip-text: "";
    in property <bool> show-bar: true;
    out property <bool> hovering: root.hot;
    out property <int> pointer-value: value-from-pointer;
    out property <bool> dragging: false;
    out property <int> display-value: root.dragging ? root.drag-value : root.value;
    callback changed(int);
    callback moved-to(int);

    property <int> drag-value: 0;
    property <int> safe-maximum: max(1, root.maximum);
    property <float> ratio: max(0.0, min(1.0, root.display-value * 1.0 / root.safe-maximum));
    property <bool> hot: touch.has-hover || root.dragging;
    property <length> bar-height: root.hot ? 4px : 2px;
    property <int> value-from-pointer: round(max(0.0, min(1.0, touch.mouse-x / max(root.width, 1px))) * root.safe-maximum);

    height: 20px;
    background: transparent;

    animate bar-height { duration: AppTheme.motion-duration; easing: ease-out; }

    Rectangle {
        visible: root.show-bar;
        y: (parent.height - root.bar-height) / 2;
        width: parent.width;
        height: root.bar-height;
        border-radius: root.bar-height / 2;
        background: AppTheme.track-bg;

        Rectangle {
            x: 0px;
            width: parent.width * root.ratio;
            height: parent.height;
            border-radius: parent.border-radius;
            background: root.hot ? AppTheme.accent : AppTheme.control-fg;
            animate background { duration: AppTheme.motion-duration; easing: ease-out; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.dragging = true;
                root.drag-value = root.value-from-pointer;
                root.moved-to(root.drag-value);
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.changed(root.drag-value);
            }
        }
        moved => {
            if (root.dragging) {
                root.drag-value = root.value-from-pointer;
                root.moved-to(root.drag-value);
            }
        }
    }

    if touch.has-hover && root.tooltip-text != "" : Rectangle {
        x: max(0px, min(parent.width - self.width, touch.mouse-x - self.width / 2));
        y: -30px;
        width: 52px;
        height: 22px;
        border-radius: 6px;
        background: AppTheme.elevated-bg;
        Text {
            text: root.tooltip-text;
            color: AppTheme.text;
            font-size: 11px;
        }
    }
}

// Appears while scrolling or when the pointer reaches the edge, then fades.
component OverlayScrollBar inherits Rectangle {
    in property <length> viewport-y;
    in property <length> viewport-height;
    in property <length> visible-height;
    in property <length> bottom-inset: 96px;
    callback scroll-to(length);

    property <length> range: max(0px, root.viewport-height - root.visible-height);
    property <length> rail: max(1px, root.height - root.bottom-inset);
    property <length> thumb: root.viewport-height <= 0px ? root.rail : max(36px, root.rail * (root.visible-height / root.viewport-height));
    property <length> thumb-y: root.range <= 0px ? 0px : (root.rail - root.thumb) * max(0, min(1, -root.viewport-y / root.range));
    property <bool> scrolling: false;
    property <length> grab: 0px;
    property <bool> hot: strip.has-hover || strip.pressed;

    width: 12px;
    visible: root.range > 1px;

    changed viewport-y => {
        root.scrolling = true;
        fade.running = true;
        fade.restart();
    }

    fade := Timer {
        interval: 1000ms;
        running: false;
        triggered => {
            root.scrolling = false;
            self.running = false;
        }
    }

    Rectangle {
        x: parent.width - self.width - 2px;
        y: root.thumb-y;
        width: root.hot ? 6px : 3px;
        height: root.thumb;
        border-radius: self.width / 2;
        background: AppTheme.text;
        opacity: root.hot ? 0.45 : (root.scrolling ? 0.28 : 0);
        animate width { duration: AppTheme.motion-duration; easing: ease-out; }
        animate opacity { duration: AppTheme.motion-slow; easing: ease-out; }
    }

    strip := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.grab = self.mouse-y >= root.thumb-y && self.mouse-y <= root.thumb-y + root.thumb ? self.mouse-y - root.thumb-y : root.thumb / 2;
                root.scroll-to(-root.range * max(0, min(1, (self.mouse-y - root.grab) / max(1px, root.rail - root.thumb))));
            }
        }
        moved => {
            if (self.pressed) {
                root.scroll-to(-root.range * max(0, min(1, (self.mouse-y - root.grab) / max(1px, root.rail - root.thumb))));
            }
        }
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <length> button-width: 120px;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> ghost: false;
    callback clicked();

    width: root.button-width;
    height: 32px;
    property <length> grow: !root.enabled ? 0px : (touch.pressed ? -3px : (touch.has-hover ? 3px : 0px));
    animate grow { duration: AppTheme.motion-spring; easing: ease-out; }

    Rectangle {
        width: parent.width + root.grow;
        height: parent.height + root.grow;
        border-radius: self.height / 2;
        background: !root.enabled ? AppTheme.disabled-bg
            : root.primary ? (touch.pressed ? AppTheme.accent.darker(0.2) : (touch.has-hover ? AppTheme.accent.brighter(0.1) : AppTheme.accent))
            : AppTheme.text.with-alpha(touch.pressed ? 0.15 : (touch.has-hover ? 0.11 : (root.ghost ? 0 : 0.07)));
        border-color: root.primary ? transparent : (root.enabled ? AppTheme.text.with-alpha(0.06) : AppTheme.disabled-border);
        border-width: 1px;
        animate background { duration: AppTheme.motion-duration; easing: ease-out; }
    }

    Text {
        text: root.text;
        color: !root.enabled ? AppTheme.muted-text : (root.primary ? AppTheme.on-accent : AppTheme.text);
        font-size: 13px;
        font-weight: root.primary ? 700 : 600;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component RoundedArtwork inherits Rectangle {
    in property <image> source;
    in property <length> artwork-size: 40px;
    in property <length> radius: 4px;
    in property <bool> zoom: false;

    width: root.artwork-size;
    height: root.artwork-size;
    border-radius: root.radius;
    background: AppTheme.elevated-bg;
    clip: true;

    // Shows through until the artwork arrives, or if there is none.
    Path {
        commands: "M6 13 L6 3.5 L13 2 L13 11.5 M6 13 A2 2 0 1 1 2 13 A2 2 0 1 1 6 13 M13 11.5 A2 2 0 1 1 9 11.5 A2 2 0 1 1 13 11.5";
        viewbox-width: 16;
        viewbox-height: 16;
        width: root.artwork-size * 0.42;
        height: root.artwork-size * 0.42;
        fill: transparent;
        stroke: AppTheme.muted-text;
        stroke-width: 1.2px;
    }

    Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        transform-scale-x: root.zoom ? 103% : 100%;
        transform-scale-y: root.zoom ? 103% : 100%;
        animate transform-scale-x, transform-scale-y { duration: AppTheme.motion-spring; easing: ease-out; }
    }
}

// How a playlist reads everywhere: cover, name, and a line under it.
component PlaylistRowContent inherits HorizontalLayout {
    in property <image> art;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> hovered: false;
    in property <bool> emphasized: false;
    in property <length> lead: 8px;
    in property <float> words: 1;

    padding-right: 8px;
    padding-left: root.lead;
    spacing: 12px;

    Rectangle {
        width: 44px;
        RoundedArtwork {
            source: root.art;
            artwork-size: 42px;
            zoom: root.hovered;
        }
    }

    Rectangle {
        horizontal-stretch: 1;
        if root.words > 0.01 : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            opacity: root.words;
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.title;
                    color: AppTheme.text;
                    font-size: 14px;
                    font-weight: root.emphasized ? 600 : 400;
                    overflow: elide;
                }
                Text {
                    text: root.subtitle;
                    color: AppTheme.muted-text;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }
}

// Shrinks the library to its covers, or brings it back.
component LibrarySizeButton inherits Rectangle {
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: size-touch.has-hover ? AppTheme.hover-bg : transparent;
    animate background { duration: AppTheme.motion-duration; easing: ease-out; }
    Path {
        commands: "M4 3 L12 3 A1.5 1.5 0 0 1 13.5 4.5 L13.5 11.5 A1.5 1.5 0 0 1 12 13 L4 13 A1.5 1.5 0 0 1 2.5 11.5 L2.5 4.5 A1.5 1.5 0 0 1 4 3 Z M6.5 3 L6.5 13";
        viewbox-width: 16;
        viewbox-height: 16;
        width: 16px;
        height: 16px;
        fill: transparent;
        stroke: size-touch.has-hover ? AppTheme.text : AppTheme.subtle-text;
        stroke-width: 1.3px;
    }
    size-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Fades from the previous cover to the new one when the track changes.
component CrossfadeArt inherits Rectangle {
    in property <image> source;
    in property <length> artwork-size: 56px;
    in property <length> radius: 8px;
    in property <bool> zoom: false;
    in property <float> rest-zoom: 1.0;
    // Something else draws the picture for now. The shadow stays.
    in property <bool> hide-art: false;

    property <float> hover-zoom: root.zoom ? 1.02 : 1.0;
    animate hover-zoom { duration: AppTheme.motion-slow; easing: ease-out; }
    property <bool> showing-b: false;
    property <image> art-a;
    property <image> art-b;

    init => { self.art-a = root.source; }
    changed source => {
        if (root.showing-b) {
            root.art-a = root.source;
        } else {
            root.art-b = root.source;
        }
        root.showing-b = !root.showing-b;
    }

    width: root.artwork-size;
    height: root.artwork-size;
    border-radius: root.radius;
    background: root.hide-art ? transparent : AppTheme.elevated-bg;
    clip: true;

    // Only the upper picture fades. The lower one stays opaque under it, so halfway through
    // a change the background doesn't show through both and dim the cover.
    property <float> b-fade: root.showing-b ? 1 : 0;
    animate b-fade { duration: AppTheme.motion-slow; easing: ease-in-out; }

    Image {
        source: root.art-a;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        visible: !root.hide-art && root.b-fade < 0.99;
        transform-scale-x: root.hover-zoom * root.rest-zoom;
        transform-scale-y: root.hover-zoom * root.rest-zoom;
    }
    Image {
        source: root.art-b;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        visible: !root.hide-art && root.b-fade > 0.01;
        // Fully opaque once it has faded in, as anything see-through gets a texture of its own.
        opacity: root.b-fade < 0.99 ? root.b-fade : 1;
        transform-scale-x: root.hover-zoom * root.rest-zoom;
        transform-scale-y: root.hover-zoom * root.rest-zoom;
    }
}

component Divider inherits Rectangle {
    background: AppTheme.border;
}

component CaptionButton inherits Rectangle {
    in property <string> commands;
    in property <bool> danger: false;
    // The maximize button's input goes through Windows (for Snap Layouts), so
    // its hover and press states are set from outside instead of by a TouchArea.
    in property <bool> external-hover: false;
    in property <bool> external-pressed: false;
    in property <bool> handles-input: true;
    callback clicked();

    property <bool> hovered: root.external-hover || caption-touch.has-hover;
    property <bool> pressed: root.external-pressed || caption-touch.pressed;

    width: 46px;
    height: 40px;
    background: root.pressed ? (root.danger ? #c50f1f : AppTheme.active-bg) : (root.hovered ? (root.danger ? #e81123 : AppTheme.hover-bg) : transparent);
    animate background { duration: AppTheme.motion-duration; easing: ease-out; }

    Path {
        commands: root.commands;
        viewbox-width: 12;
        viewbox-height: 12;
        width: 11px;
        height: 11px;
        fill: transparent;
        stroke: root.hovered && root.danger ? #ffffff : AppTheme.text;
        stroke-width: 1px;
    }

    caption-touch := TouchArea {
        enabled: root.handles-input;
        clicked => { root.clicked(); }
    }
}

// The mini player's pin, full size and close buttons, drawn like the caption buttons.
component MiniWindowButton inherits Rectangle {
    in property <string> commands;
    in property <string> label;
    in property <bool> lit: false;
    in property <bool> danger: false;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    background: touch.pressed ? (root.danger ? #c50f1f : AppTheme.active-bg) : (touch.has-hover ? (root.danger ? #e81123 : AppTheme.hover-bg) : transparent);
    animate background { duration: AppTheme.motion-duration; easing: ease-out; }

    Path {
        commands: root.commands;
        viewbox-width: 12;
        viewbox-height: 12;
        width: 10px;
        height: 10px;
        fill: root.lit ? AppTheme.accent : transparent;
        stroke: touch.has-hover && root.danger ? #ffffff : (root.lit ? AppTheme.accent : (touch.has-hover ? AppTheme.text : AppTheme.subtle-text));
        stroke-width: 1px;
        animate stroke { duration: AppTheme.motion-duration; easing: ease-out; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ─── Settings rows ─────────────────────────────────────────────────────────

// A sliding pill of glass over a few choices. The Settings tabs use it too.
component GlassSegments inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <length> segment-width: 76px;
    in property <length> segment-height: 26px;
    in property <length> text-size: 12px;
    callback chosen(int);

    property <length> inset: 3px;

    width: root.options.length * root.segment-width + 2 * root.inset;
    height: root.segment-height + 2 * root.inset;
    border-radius: self.height / 2;
    background: AppTheme.text.with-alpha(0.05);

    Rectangle {
        x: root.inset + root.selected * root.segment-width;
        y: root.inset;
        width: root.segment-width;
        height: root.segment-height;
        border-radius: self.height / 2;
        background: AppTheme.text.with-alpha(0.11);
        border-width: 1px;
        border-color: AppTheme.text.with-alpha(0.06);
        animate x { duration: AppTheme.motion-slow; easing: ease-out; }
    }
    for option[index] in root.options : Rectangle {
        x: root.inset + index * root.segment-width;
        y: root.inset;
        width: root.segment-width;
        height: root.segment-height;
        Text {
            text: option;
            color: index == root.selected ? AppTheme.text : (segment-touch.has-hover ? AppTheme.secondary-text : AppTheme.subtle-text);
            font-size: root.text-size;
            font-weight: 600;
            animate color { duration: AppTheme.motion-duration; easing: ease-out; }
        }
        segment-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.chosen(index); }
        }
    }
}

// A label on the left, its description under it, and whatever control goes on the right.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <length> control-width: 44px;
    in property <bool> clickable: false;
    out property <bool> pressed: row-touch.pressed;
    callback clicked();

    height: root.description == "" ? 46px : 60px;

    GlassHover { radius: 9px; strength: 0.7; lit: row-touch.has-hover; }
    row-touch := TouchArea {
        mouse-cursor: root.clickable ? pointer : default;
        clicked => {
            if (root.clickable) {
                root.clicked();
            }
        }

        Text {
            x: 14px;
            y: root.description == "" ? (root.height - self.height) / 2 : 11px;
            width: root.width - root.control-width - 42px;
            text: root.label;
            color: AppTheme.text;
            font-size: 14px;
            font-weight: 500;
            overflow: elide;
        }
        if root.description != "" : Text {
            x: 14px;
            y: 31px;
            width: root.width - root.control-width - 42px;
            text: root.description;
            color: AppTheme.subtle-text;
            font-size: 12px;
            overflow: elide;
        }
        Rectangle {
            x: root.width - root.control-width - 14px;
            width: root.control-width;
            @children
        }
    }
}

component SettingToggle inherits SettingRow {
    in-out property <bool> checked;
    callback toggled();

    clickable: true;
    control-width: 38px;
    clicked => {
        root.checked = !root.checked;
        root.toggled();
    }

    Rectangle {
        width: 38px;
        height: 22px;
        border-radius: 11px;
        background: root.checked ? AppTheme.accent : AppTheme.text.with-alpha(0.13);
        animate background { duration: AppTheme.motion-spring; easing: ease-out; }

        Rectangle {
            x: root.checked ? parent.width - self.width - 3px : 3px;
            width: root.pressed ? 20px : 16px;
            height: 16px;
            border-radius: 8px;
            background: root.checked ? AppTheme.on-accent : AppTheme.text.with-alpha(0.8);
            animate x, width { duration: AppTheme.motion-spring; easing: ease-out; }
            animate background { duration: AppTheme.motion-spring; easing: ease-out; }
        }
    }
}

component SettingSegments inherits SettingRow {
    in property <[string]> options;
    in property <int> selected;
    in property <length> segment-width: 72px;
    callback chosen(int);

    control-width: segments.width;
    segments := GlassSegments {
        options: root.options;
        selected: root.selected;
        segment-width: root.segment-width;
        chosen(index) => { root.chosen(index); }
    }
}

component AccentSwatch inherits Rectangle {
    in property <color> tint;
    in property <bool> chosen;
    callback clicked();

    width: 28px;
    height: 28px;
    property <length> dot: swatch-touch.pressed ? 14px : (swatch-touch.has-hover ? 20px : 18px);
    animate dot { duration: AppTheme.motion-spring; easing: ease-out; }

    Rectangle {
        width: 26px;
        height: 26px;
        border-radius: 13px;
        border-width: 1.5px;
        border-color: root.chosen ? AppTheme.text.with-alpha(0.75) : transparent;
        animate border-color { duration: AppTheme.motion-duration; easing: ease-out; }
    }
    Rectangle {
        width: root.dot;
        height: root.dot;
        border-radius: self.width / 2;
        background: root.tint;
    }
    swatch-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A text box. What's typed takes effect on Enter or on leaving the box.
component GlassField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback committed();

    property <bool> dirty: false;
    function commit() {
        if (root.dirty) {
            root.dirty = false;
            root.committed();
        }
    }

    height: 32px;
    border-radius: 9px;
    clip: true;
    background: AppTheme.text.with-alpha(field-input.has-focus ? 0.09 : (field-touch.has-hover ? 0.08 : 0.05));
    border-width: 1px;
    border-color: field-input.has-focus ? AppTheme.focus-ring : AppTheme.text.with-alpha(0.06);
    animate background, border-color { duration: AppTheme.motion-duration; easing: ease-out; }

    field-touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { field-input.focus(); }
    }
    if root.text == "" : Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.placeholder;
        color: AppTheme.muted-text;
        font-size: 13px;
        horizontal-alignment: left;
        overflow: elide;
    }
    field-input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        color: AppTheme.text;
        font-size: 13px;
        single-line: true;
        vertical-alignment: center;
        edited => { root.dirty = true; }
        accepted => { root.commit(); }
        changed has-focus => {
            if (!self.has-focus) {
                root.commit();
            }
        }
    }
}

// A shortcut. Clicked, it listens: the keys pressed next become the shortcut, while Esc or a
// click anywhere else leaves it as it was.
component ShortcutField inherits Rectangle {
    in property <string> text;
    in property <bool> listening;
    // What's held so far, or why the last key can't be used.
    in property <string> keys;
    in property <bool> refused;
    // The button went down here, so the press isn't a click elsewhere.
    callback pressed();
    callback clicked();

    height: 32px;
    border-radius: 9px;
    background: AppTheme.text.with-alpha(root.listening ? 0.09 : (touch.has-hover ? 0.08 : 0.05));
    border-width: 1px;
    border-color: root.listening ? AppTheme.focus-ring : AppTheme.text.with-alpha(0.06);
    animate background, border-color { duration: AppTheme.motion-duration; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pressed();
            }
        }
        clicked => { root.clicked(); }
    }
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: !root.listening ? root.text : root.keys != "" ? root.keys : "Press keys…";
        color: !root.listening ? AppTheme.text
            : root.refused ? AppTheme.warning
            : root.keys != "" ? AppTheme.text : AppTheme.muted-text;
        font-size: 13px;
        overflow: elide;
    }
}

// A heading and a pane of glass holding its rows. Drawn once and kept, as it's mostly text.
component SettingsSection inherits Rectangle {
    in property <string> title;
    in property <length> scroll-y;
    in property <length> view-height;

    height: 32px + section-rows.preferred-height;

    Text {
        x: 4px;
        y: 0px;
        height: 24px;
        text: root.title;
        color: AppTheme.text;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: -0.1px;
        vertical-alignment: center;
    }
    // Slint draws cached items even out of view, so sections out of view are skipped.
    // The cache goes inside: see the note on the right panel.
    Rectangle {
        y: 32px;
        height: section-rows.preferred-height;
        visible: root.y + root.height + root.scroll-y > 0px && root.y + root.scroll-y < root.view-height;
        Rectangle {
            cache-rendering-hint: AppTheme.can-cache;
            CacheAnchor { }
            GlassPane { radius: 13px; strength: 0.8; }
            section-rows := VerticalLayout {
                padding: 5px;
                spacing: 1px;
                @children
            }
        }
    }
}

// ─── Loading ───────────────────────────────────────────────────────────────

// A stand-in for something still loading.
component Bone inherits Rectangle {
    background: AppTheme.text.with-alpha(0.07);
    border-radius: 4px;
}

// Holds Bones and breathes gently. It waits a moment first, so a quick load never flashes it.
component LoadingShade inherits Rectangle {
    in property <bool> paused: false;
    property <float> reveal: 0;
    init => { self.reveal = 1; }
    animate reveal { delay: 120ms; duration: AppTheme.reduce-motion ? 1ms : 180ms; easing: ease-out; }
    opacity: self.reveal * (AppTheme.reduce-motion || root.paused ? 0.8 : 0.72 + 0.28 * sin(animation-tick() / 1100ms * 360deg));
}

// ─── Lists ─────────────────────────────────────────────────────────────────

// A round glass play button that fades in over a card. Acts as soon as it's pressed.
component HomeCardPlay inherits Rectangle {
    in property <bool> shown;
    callback play();

    property <float> reveal: root.shown ? 1 : 0;
    animate reveal { duration: AppTheme.reduce-motion ? 0ms : (root.shown ? 150ms : 110ms); easing: ease-out; }

    // Exists only while it shows: every card has one, and hidden it would still cost a clip each frame.
    if root.reveal > 0.01 : face := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        property <float> glass: touch.pressed ? 0.76 : (touch.has-hover ? 0.96 : 0.86);
        animate glass { duration: AppTheme.motion-duration; easing: ease-out; }
        property <float> push: touch.pressed ? 0.96 : (touch.has-hover ? 1.03 : 1);
        animate push { duration: touch.pressed ? 50ms : AppTheme.motion-spring; easing: ease-out; }

        // The shadow, already blurred. A drop shadow would be blurred again for each step of the fade.
        Image {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2 + 2px;
            width: root.width * 2.05;
            height: root.height * 2.05;
            source: @image-url("../assets/soft-round.png");
            opacity: 0.3 * root.reveal;
        }
        // The colours fade rather than the element, which would need a layer each time.
        Rectangle {
            border-radius: self.height / 2;
            background: AppTheme.accent.with-alpha(face.glass * root.reveal);
            border-width: 1px;
            border-color: #ffffff.with-alpha(0.35 * root.reveal);
            transform-scale-x: (0.94 + 0.06 * root.reveal) * face.push;
            transform-scale-y: (0.94 + 0.06 * root.reveal) * face.push;

            // A path, so it stays sharp at any size: an icon image is drawn once and then stretched.
            Path {
                width: parent.height * 0.38;
                height: parent.height * 0.38;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M8 5.2v13.6c0 .8.9 1.3 1.6.9l10.8-6.8c.6-.4.6-1.3 0-1.7L9.6 4.3C8.9 3.9 8 4.4 8 5.2z";
                fill: AppTheme.on-accent.with-alpha(root.reveal);
                stroke-width: 0px;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.play();
                }
            }
        }
    }
}

// A mix, album or artist on Home.
component HomeCardView inherits Rectangle {
    in property <HomeCard> card;
    // While Home is resizing, the picture's size on screen as a share of its final size.
    // Scaling costs one texture per picture. Resizing would redraw it and its words every frame.
    in property <float> art-scale: 1;
    // The words change width partway through that, with the subtitle faded out.
    in property <length> words-width: root.art-size;
    in property <float> words-fade: 1;
    callback open();
    callback play();

    property <length> art-size: root.width - 16px;
    property <length> art-shown: root.art-size * root.art-scale;
    // The art lifts towards the cursor, and a shadow forms under it.
    property <float> lift: touch.has-hover ? 1 : 0;
    animate lift { duration: AppTheme.motion-spring; easing: ease-out; }
    property <length> art-y: 8px - root.lift * 3px;

    GlassHover {
        x: 0px;
        y: 0px;
        width: root.art-shown + 16px;
        height: root.art-shown + 56px;
        radius: 12px;
        lit: touch.has-hover;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }

        Rectangle {
            x: 8px;
            y: root.art-y;
            width: root.art-size;
            height: root.art-size;
            transform-origin: { x: 0px, y: 0px };
            transform-scale-x: root.art-scale;
            transform-scale-y: root.art-scale;

            // Not under a round picture, which it would show around.
            if !root.card.round && root.lift > 0.01 : Image {
                x: -10px;
                y: -4px;
                width: root.art-size + 20px;
                height: root.art-size + 22px;
                source: @image-url("../assets/soft-edge.png", nine-slice(15 28));
                colorize: #000000;
                opacity: max(0, root.lift) * 0.4;
            }
            RoundedArtwork {
                x: 0px;
                y: 0px;
                source: root.card.art;
                artwork-size: root.art-size;
                radius: root.card.round ? root.art-size / 2 : 8px;
                zoom: touch.has-hover;
            }
        }
        // Cached, the words cost laying out text only when they change, which is most of a
        // frame's work. They also glide with the picture: text drawn directly snaps to whole
        // pixels as it moves. Each cache stays at its parent's origin: placed further in, it
        // can measure as empty while its card is hidden, and then stays empty for good.
        Rectangle {
            x: 8px;
            y: root.art-shown + 15px;
            width: root.words-width;
            height: 49px;
            Rectangle {
                y: 0px;
                height: 18px;
                cache-rendering-hint: AppTheme.can-cache;
                CacheAnchor { }
                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    text: root.card.title;
                    color: AppTheme.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }
            }
            Rectangle {
                y: 18px;
                height: 31px;
                Rectangle {
                    opacity: root.words-fade;
                    cache-rendering-hint: AppTheme.can-cache;
                    CacheAnchor { }
                    Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: root.card.subtitle;
                        color: touch.has-hover ? AppTheme.secondary-text : AppTheme.subtle-text;
                        animate color { duration: AppTheme.motion-duration; easing: ease-out; }
                        font-size: 12px;
                        wrap: word-wrap;
                        overflow: elide;
                        vertical-alignment: top;
                    }
                }
            }
        }
        HomeCardPlay {
            x: root.art-shown + 8px - self.width - 8px;
            y: root.art-y + root.art-shown - self.height - 8px;
            width: 40px;
            height: 40px;
            shown: touch.has-hover;
            play => { root.play(); }
        }
    }
}

// A small shortcut at the top of Home.
component HomeTileView inherits Rectangle {
    in property <HomeCard> card;
    // The tile's width on screen while Home is resizing.
    in property <length> shown-width: root.width;
    callback open();
    callback play();

    property <length> nudge: touch.has-hover ? 3px : 0px;
    animate nudge { duration: AppTheme.motion-spring; easing: ease-out; }

    Rectangle {
        x: 0px;
        width: root.shown-width;
        border-radius: 8px;
        background: AppTheme.hover-bg;
        GlassHover { radius: 8px; lit: touch.has-hover; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }

        RoundedArtwork {
            x: 6px;
            y: (root.height - self.height) / 2;
            source: root.card.art;
            artwork-size: 44px;
            radius: root.card.round ? 22px : 6px;
            zoom: touch.has-hover;
        }
        // Laid out for the final width at once, and uncovered as the tile reaches it.
        Rectangle {
            x: 60px + root.nudge;
            width: root.shown-width - 70px;
            clip: true;
            Rectangle {
                x: 0px;
                width: root.width - 60px - (touch.has-hover ? 47px : 10px);
                cache-rendering-hint: AppTheme.can-cache;
                CacheAnchor { }
                Text {
                    x: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: root.card.title;
                    color: AppTheme.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        HomeCardPlay {
            x: root.shown-width - self.width - 9px;
            y: (root.height - self.height) / 2;
            width: 30px;
            height: 30px;
            shown: touch.has-hover;
            play => { root.play(); }
        }
    }
}

// The bars beside the song that's playing. They bounce while it plays and settle into a still
// shape when it pauses. A timer steps them about 30 times a second: a declared animation would
// redraw the whole window at the full frame rate for as long as the song played, and at this size
// the steps can't be told apart from that.
component PlayingBars inherits Rectangle {
    in property <bool> moving;
    in property <color> tint;
    width: 16px;
    height: 14px;

    // Each bar's height when still, as a share of the whole.
    property <[float]> rest: [0.5, 0.86, 0.64, 0.36];
    // Each bar mixes two waves. Every one fits a whole number of times into ten seconds, so the
    // count wraps there without a jump.
    property <[float]> slow: [1.1, 1.6, 1.3, 1.9];
    property <[float]> fast: [2.3, 1.9, 2.7, 2.1];
    property <[float]> offset: [0, 0.35, 0.7, 0.15];
    property <int> step: 0;
    property <float> time: self.step / 30;
    // Eases between still and bouncing, so pausing settles the bars instead of freezing them.
    property <float> energy: root.moving ? 1 : 0;
    animate energy { duration: AppTheme.motion-slow; easing: ease-out; }

    Timer {
        interval: 33ms;
        running: root.moving;
        triggered => { root.step = mod(root.step + 1, 300); }
    }

    for i in 4 : Rectangle {
        property <float> wave: 0.56 + 0.3 * sin((root.time * root.slow[i] + root.offset[i]) * 360deg)
            + 0.14 * sin((root.time * root.fast[i] + root.offset[i] * 2) * 360deg);
        property <float> level: max(0.14, min(1, root.rest[i] + (self.wave - root.rest[i]) * root.energy));
        // On whole pixels, so the bars stay sharp at any scale.
        x: round(i * 4.5px / 1phx) * 1phx;
        width: max(1phx, round(2.2px / 1phx) * 1phx);
        height: max(2px, round(root.height * self.level / 1phx) * 1phx);
        y: root.height - self.height;
        border-radius: 1.1px;
        background: root.tint;
    }
}

component TrackRow inherits Rectangle {
    in property <TrackItem> item;
    in property <bool> playing;
    in property <bool> paused;
    // Nobody can see the row move, so its bars hold still.
    in property <bool> unseen;
    in property <bool> selected;
    in property <bool> show-album: true;
    in property <image> playing-icon;
    in property <image> placeholder-icon;
    callback play();
    callback select();
    callback context(length, length);

    height: 48px;
    border-radius: 6px;
    // Laying out text is most of a frame's work. Cached, a row costs that only when it changes.
    cache-rendering-hint: AppTheme.can-cache;
    // These buttons exist only while they show. Hidden, each would still cost a clip every time
    // its row is drawn, which across a screen of rows is a large part of a frame.
    property <float> play-fade: row-touch.has-hover ? 1 : 0;
    animate play-fade { duration: AppTheme.motion-duration; }
    property <float> play-grow: row-touch.has-hover ? 1 : 0.94;
    animate play-grow { duration: AppTheme.motion-spring; easing: ease-out; }
    property <float> more-fade: row-touch.has-hover || root.selected ? 1 : 0;
    animate more-fade { duration: AppTheme.motion-duration; }
    GlassHover { strength: root.playing || root.selected ? 1.1 : 0.8; lit: root.playing || root.selected || row-touch.has-hover; }

    row-touch := TouchArea {
        clicked => { root.select(); }
        double-clicked => { root.play(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.select();
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 16px;
        spacing: 12px;

        Rectangle {
            width: 30px;

            Text {
                text: root.item.number;
                color: AppTheme.muted-text;
                font-size: 13px;
                opacity: !row-touch.has-hover && !root.playing ? 1 : 0;
                animate opacity { duration: AppTheme.motion-duration; }
            }
            if root.playing : PlayingBars {
                moving: !root.paused && !root.unseen && !row-touch.has-hover && !AppTheme.reduce-motion;
                tint: root.paused ? AppTheme.subtle-text : AppTheme.accent;
                animate tint { duration: AppTheme.motion-duration; }
                opacity: row-touch.has-hover ? 0 : 1;
                animate opacity { duration: AppTheme.motion-duration; }
            }
            if root.play-fade > 0.01 : Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: play-touch.has-hover ? AppTheme.active-bg : transparent;
                opacity: root.play-fade;
                animate background { duration: AppTheme.motion-duration; }
                property <float> push: play-touch.pressed ? 0.96 : (play-touch.has-hover ? 1.03 : 1);
                animate push { duration: AppTheme.motion-spring; easing: ease-out; }
                transform-scale-x: root.play-grow * self.push;
                transform-scale-y: root.play-grow * self.push;
                Path {
                    width: 15px;
                    height: 15px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M8 5.2v13.6c0 .8.9 1.3 1.6.9l10.8-6.8c.6-.4.6-1.3 0-1.7L9.6 4.3C8.9 3.9 8 4.4 8 5.2z";
                    fill: AppTheme.text;
                    stroke-width: 0px;
                }
                play-touch := TouchArea {
                    enabled: row-touch.has-hover;
                    mouse-cursor: pointer;
                    clicked => { root.play(); }
                }
            }
        }

        Rectangle {
            width: 40px;
            if root.item.has-art : RoundedArtwork {
                source: root.item.art;
                artwork-size: 38px;
                zoom: row-touch.has-hover;
            }
            if !root.item.has-art : Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 4px;
                background: AppTheme.elevated-bg;
                Image {
                    source: root.placeholder-icon;
                    colorize: AppTheme.muted-text;
                    width: 16px;
                    height: 16px;
                    image-fit: contain;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 5;
            preferred-width: 0px;
            min-width: 0px;
            Text {
                text: root.item.title;
                color: root.playing ? AppTheme.accent : AppTheme.text;
                animate color { duration: AppTheme.motion-duration; }
                font-size: 14px;
                font-weight: root.playing ? 600 : 400;
                overflow: elide;
            }
            Text {
                text: root.item.artists;
                color: AppTheme.subtle-text;
                font-size: 12px;
                overflow: elide;
            }
        }

        if root.show-album : Rectangle {
            horizontal-stretch: 3;
            preferred-width: 0px;
            min-width: 0px;
            Text {
                x: 0px;
                width: parent.width;
                text: root.item.album;
                color: AppTheme.subtle-text;
                font-size: 13px;
                horizontal-alignment: left;
                overflow: elide;
            }
        }

        Rectangle {
            width: 48px;
            Text {
                x: 0px;
                width: parent.width;
                text: root.item.duration;
                color: AppTheme.subtle-text;
                font-size: 13px;
                horizontal-alignment: right;
            }
        }

        Rectangle {
            width: 26px;
            if root.more-fade > 0.01 : Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: more-touch.has-hover ? AppTheme.active-bg : transparent;
                opacity: root.more-fade;
                animate background { duration: AppTheme.motion-duration; }
                // Rectangles: a path of strokes this short comes out with nothing drawn.
                for dot in 3 : Rectangle {
                    x: 8px + dot * 4px;
                    y: 12px;
                    width: 2px;
                    height: 2px;
                    border-radius: 1px;
                    background: AppTheme.secondary-text;
                }
                more-touch := TouchArea {
                    enabled: row-touch.has-hover || root.selected;
                    mouse-cursor: pointer;
                    clicked => {
                        root.select();
                        root.context(self.absolute-position.x + 4px, self.absolute-position.y + 28px);
                    }
                }
            }
        }
    }
    }
}

component QueueGlyph inherits Rectangle {
    in property <string> commands: "M4 4 L12 12 M12 4 L4 12";
    in property <bool> enabled: true;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: glyph-touch.has-hover && root.enabled ? AppTheme.active-bg : transparent;
    Path {
        commands: root.commands;
        viewbox-width: 16;
        viewbox-height: 16;
        width: 14px;
        height: 14px;
        fill: transparent;
        stroke: root.enabled ? (glyph-touch.has-hover ? AppTheme.text : AppTheme.subtle-text) : AppTheme.disabled-border;
        stroke-width: 1.6px;
    }
    glyph-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component BarGlyph inherits Rectangle {
    in property <string> commands;
    in property <bool> filled: false;
    in property <bool> lit: false;
    callback clicked();

    width: 28px;
    height: 28px;
    property <length> glyph: glyph-touch.pressed ? 14px : 16px;
    animate glyph { duration: glyph-touch.pressed ? 70ms : AppTheme.motion-spring; easing: ease-out; }

    Path {
        commands: root.commands;
        viewbox-width: 24;
        viewbox-height: 24;
        width: root.glyph;
        height: root.glyph;
        fill: root.filled ? AppTheme.accent : transparent;
        stroke: root.lit ? AppTheme.accent : (glyph-touch.has-hover ? AppTheme.text : AppTheme.subtle-text);
        stroke-width: 1.6px;
        animate stroke { duration: AppTheme.motion-duration; easing: ease-out; }
    }
    glyph-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Rectangles rather than one path: a path with several parts is drawn with wide soft edges,
// which makes dots this small come out over three pixels across.
component GripDots inherits Rectangle {
    in property <brush> fill;
    width: 14px;
    height: 14px;
    for dot in 6 : Rectangle {
        x: 4px + mod(dot, 2) * 4px;
        y: 2px + floor(dot / 2) * 4px;
        width: 2px;
        height: 2px;
        border-radius: 1px;
        background: root.fill;
    }
}

// What a queue row is dragged by. Heights are the pointer's in the window, as the row
// under it moves when the list scrolls.
component QueueGrip inherits Rectangle {
    callback lift(length);
    callback carry(length);
    callback put-down();
    callback wheel(length);

    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: grip-touch.has-hover ? AppTheme.active-bg : transparent;
    GripDots {
        fill: grip-touch.has-hover ? AppTheme.text : AppTheme.subtle-text;
    }
    grip-touch := TouchArea {
        // Windows has no grabbing hand: asking for one gets four-way arrows.
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.lift(self.absolute-position.y + self.mouse-y);
            } else if (event.kind == PointerEventKind.cancel || (event.kind == PointerEventKind.up && event.button == PointerEventButton.left)) {
                root.put-down();
            }
        }
        moved => { root.carry(self.absolute-position.y + self.mouse-y); }
        scroll-event(event) => {
            root.wheel(event.delta-y);
            return accept;
        }
    }
}

component QueueRow inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <image> art;
    in property <bool> editable: false;
    in property <color> title-color: AppTheme.text;
    in property <color> artist-color: AppTheme.muted-text;
    in property <bool> on-screen: true;
    // Being dragged, so the grip has to stay.
    in property <bool> lifted: false;
    callback remove();
    callback clicked();
    callback lift(length);
    callback carry(length);
    callback put-down();
    callback wheel(length);

    height: 50px;
    border-radius: 6px;
    // A cached row redrawn while out of view stays blank for good, as Slint keeps the empty
    // result, so rows out of view are skipped. The cache goes inside: see the right panel's note.
    visible: root.on-screen;
    Rectangle {
    cache-rendering-hint: AppTheme.can-cache;
    CacheAnchor {}
    GlassHover { lit: queue-touch.has-hover; }

    queue-touch := TouchArea {
    mouse-cursor: pointer;
    clicked => { root.clicked(); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 10px;

        Rectangle {
            width: 40px;
            RoundedArtwork {
                source: root.art;
                artwork-size: 38px;
                zoom: queue-touch.has-hover;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 0px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: root.title-color;
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: root.artist;
                color: root.artist-color;
                font-size: 12px;
                overflow: elide;
            }
        }

        if root.editable && (queue-touch.has-hover || root.lifted) : Rectangle {
            property <float> reveal: 0;
            init => { self.reveal = 1; }
            animate reveal { duration: AppTheme.motion-spring; easing: ease-out; }
            width: 52px;
            opacity: self.reveal;
            HorizontalLayout {
                spacing: 0px;
                VerticalLayout { alignment: center; QueueGlyph { clicked => { root.remove(); } } }
                VerticalLayout {
                    alignment: center;
                    QueueGrip {
                        lift(pointer) => { root.lift(pointer); }
                        carry(pointer) => { root.carry(pointer); }
                        put-down => { root.put-down(); }
                        wheel(delta) => { root.wheel(delta); }
                    }
                }
            }
        }
    }
    }
    }
}

// The songs coming up. A row is dragged by its grip: a copy of it follows the pointer, the
// others slide out of its way, and only when it has landed does the new order go to the app.
component QueueList inherits Rectangle {
    in property <[string]> titles;
    in property <[string]> artists;
    in property <[image]> images;
    in property <bool> editable;
    in property <length> viewport-y;
    in property <length> visible-height;
    in property <length> content-height;
    // Set while a row is in motion, as replacing the rows then would lose it.
    in-out property <bool> busy;
    callback scroll-to(length);
    callback play(int);
    callback remove(int);
    callback reorder(int, int);

    property <length> pitch: 54px;
    property <int> count: root.titles.length;
    property <int> lifted: -1;
    property <int> slot: -1;
    property <bool> landing: false;
    property <int> leaving: -1;

    // Taken when the row is picked up, so what follows stays true as the list scrolls.
    property <length> pointer: 0px;
    property <length> top-at-lift: 0px;
    property <length> scroll-at-lift: 0px;
    property <length> grabbed-at: 0px;
    // The bar covers the bottom of what's in view.
    property <length> view-bottom: root.visible-height - 96px;
    // Follows the pointer, but stays in the list and in sight.
    property <length> carried-y: clamp(
        root.pointer - root.top-at-lift - (root.viewport-y - root.scroll-at-lift) - root.grabbed-at,
        max(0px, -root.y - root.viewport-y),
        min((root.count - 1) * root.pitch, root.view-bottom - 50px - root.y - root.viewport-y));

    // The list scrolls when the pointer nears either end of what's in view.
    property <length> edge: 48px;
    property <length> pointer-in-view: root.pointer - root.top-at-lift + root.y + root.scroll-at-lift;
    property <float> pull-up: root.y + root.viewport-y < root.edge ? clamp((root.edge - root.pointer-in-view) / root.edge, 0, 1) : 0;
    property <float> pull-down: root.y + root.viewport-y + root.height > root.view-bottom ? clamp((root.pointer-in-view - root.view-bottom + root.edge) / root.edge, 0, 1) : 0;
    property <bool> edge-scrolling: root.lifted >= 0 && !root.landing && (root.pull-up > 0 || root.pull-down > 0);
    property <duration> edge-clock: root.edge-scrolling ? animation-tick() : 0ms;
    property <duration> edge-last: 0ms;
    property <length> edge-carry: 0px;

    height: max(0px, root.count * root.pitch - 4px);

    changed edge-clock => {
        if (root.edge-clock > 0ms && root.edge-last > 0ms) {
            root.edge-carry += (root.pull-down * root.pull-down - root.pull-up * root.pull-up) * 620px * ((root.edge-clock - root.edge-last) / 1s);
            let whole = round(root.edge-carry / 1phx) * 1phx;
            if (whole != 0px) {
                root.edge-carry -= whole;
                root.scroll-by(-whole);
            }
        }
        root.edge-last = root.edge-clock;
    }
    changed viewport-y => { root.find-slot(); }

    function scroll-by(delta: length) {
        root.scroll-to(clamp(root.viewport-y + delta, min(0px, root.visible-height - root.content-height), 0px));
    }
    function find-slot() {
        if (root.lifted >= 0 && !root.landing) {
            root.slot = clamp(round(root.carried-y / root.pitch), 0, root.count - 1);
        }
    }
    function pick-up(index: int, pointer: length) {
        if (root.lifted >= 0 || root.leaving >= 0) {
            return;
        }
        root.busy = true;
        root.pointer = pointer;
        root.top-at-lift = self.absolute-position.y;
        root.scroll-at-lift = root.viewport-y;
        root.grabbed-at = pointer - root.top-at-lift - index * root.pitch;
        root.slot = index;
        root.lifted = index;
    }
    function put-down(index: int) {
        if (index != root.lifted || root.landing) {
            return;
        }
        root.landing = true;
        if (AppTheme.motion-spring == 0ms) {
            root.finish();
        } else {
            settle.running = true;
            settle.restart();
        }
    }
    function leave(index: int) {
        if (root.lifted >= 0 || root.leaving >= 0) {
            return;
        }
        if (AppTheme.motion-spring == 0ms) {
            root.remove(index);
            return;
        }
        root.busy = true;
        root.leaving = index;
        settle.running = true;
        settle.restart();
    }
    function finish() {
        settle.running = false;
        root.busy = false;
        if (root.lifted >= 0) {
            let from = root.lifted;
            root.lifted = -1;
            root.landing = false;
            root.reorder(from, root.slot);
        } else if (root.leaving >= 0) {
            let gone = root.leaving;
            root.leaving = -1;
            root.remove(gone);
        }
    }
    pure function shift(index: int) -> length {
        if (root.leaving >= 0) {
            return index > root.leaving ? -root.pitch : 0px;
        }
        if (root.lifted < 0) {
            return 0px;
        }
        if (index > root.lifted && index <= root.slot) {
            return -root.pitch;
        }
        if (index < root.lifted && index >= root.slot) {
            return root.pitch;
        }
        return 0px;
    }

    settle := Timer {
        interval: AppTheme.motion-spring;
        running: false;
        triggered => { root.finish(); }
    }

    for title[index] in root.titles : QueueRow {
        y: index * root.pitch + root.shift(index);
        // Only moved by what happens here: a new list just appears.
        animate y { duration: root.busy ? AppTheme.motion-spring : 0ms; easing: ease-out; }
        // A copy follows the pointer while a row is dragged, so the row itself leaves a gap. It's only
        // clear rather than hidden: Slint takes a hidden row as the pointer having left, and ends the drag.
        opacity: root.leaving == index || root.lifted == index ? 0 : 1;
        animate opacity { duration: root.leaving >= 0 ? AppTheme.motion-duration : 0ms; easing: ease-out; }
        on-screen: self.y + self.height + root.y + root.viewport-y > 0px && self.y + root.y + root.viewport-y < root.visible-height;
        lifted: root.lifted == index;
        title: title;
        artist: root.artists[index];
        art: root.images[index];
        editable: root.editable;
        clicked => { root.play(index); }
        remove => { root.leave(index); }
        lift(pointer) => { root.pick-up(index, pointer); }
        carry(pointer) => {
            if (index == root.lifted && !root.landing) {
                root.pointer = pointer;
                root.find-slot();
            }
        }
        put-down => { root.put-down(index); }
        wheel(delta) => { root.scroll-by(delta); }
    }

    // The dragged row. It starts out looking just like the lit row it replaces, then darkens
    // to stay readable over the rows it passes, as Slint can't blur what's behind.
    if root.lifted >= 0 : Rectangle {
        property <bool> up: false;
        init => { self.up = true; }
        property <float> raised: self.up && !root.landing ? 1 : 0;
        animate raised { duration: AppTheme.motion-spring; easing: ease-out; }
        y: root.landing ? root.slot * root.pitch : root.carried-y;
        animate y { duration: root.landing ? AppTheme.motion-spring : 0ms; easing: ease-out; }
        height: 50px;

        Rectangle {
            y: 1px;
            height: parent.height - 2px;
            border-radius: 10px;
            background: AppTheme.window-bg.with-alpha(0.82 * parent.raised);
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #000000.with-alpha(0.5 * parent.raised);
        }
        // Cached, so the words glide with the pointer rather than snapping to whole pixels.
        Rectangle {
            cache-rendering-hint: AppTheme.can-cache;
            CacheAnchor {}
            GlassPane {
                y: 1px;
                height: parent.height - 2px;
                strength: 1.1;
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 10px;
                Rectangle {
                    width: 40px;
                    RoundedArtwork {
                        source: root.images[root.lifted];
                        artwork-size: 38px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.titles[root.lifted];
                        color: AppTheme.text;
                        font-size: 13px;
                        overflow: elide;
                    }
                    Text {
                        text: root.artists[root.lifted];
                        color: AppTheme.muted-text;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                Rectangle {
                    width: 52px;
                    GripDots {
                        x: 32px;
                        fill: AppTheme.text;
                    }
                }
            }
        }
    }
}

component DeviceRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    in property <bool> active;
    // Connecting to this device: a ring turns at the end of the row.
    in property <bool> busy;
    in property <image> spinner;
    in property <bool> shown: true;
    in property <int> order: 0;
    callback clicked();

    height: 52px;
    border-radius: 8px;
    GlassHover { lit: device-hover.has-hover || root.busy; }

    property <float> fade: root.shown ? 1 : 0;
    animate fade {
        delay: root.shown && !AppTheme.reduce-motion ? root.order * 45ms + 60ms : 0ms;
        duration: AppTheme.motion-slow;
        easing: ease-out;
    }
    opacity: self.fade > 0.01 ? self.fade : 1;
    visible: self.fade > 0.01;

    HorizontalLayout {
        x: root.shown ? 0px : 18px;
        width: parent.width;
        padding-left: 10px;
        padding-right: 12px;
        spacing: 14px;
        animate x {
            delay: root.shown && !AppTheme.reduce-motion ? root.order * 45ms + 60ms : 0ms;
            duration: AppTheme.motion-slow;
            easing: ease-out;
        }

        Rectangle {
            width: 22px;
            Image {
                source: root.icon;
                colorize: root.active ? AppTheme.accent : (device-hover.has-hover ? AppTheme.text : AppTheme.subtle-text);
                width: 20px;
                height: 20px;
                image-fit: contain;
                transform-scale-x: device-hover.has-hover ? 114% : 100%;
                transform-scale-y: device-hover.has-hover ? 114% : 100%;
                animate colorize { duration: AppTheme.motion-duration; easing: ease-out; }
                animate transform-scale-x, transform-scale-y { duration: AppTheme.motion-spring; easing: ease-out; }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 0px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: root.active ? AppTheme.accent : AppTheme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.active ? "Current device" : root.subtitle;
                color: root.active ? AppTheme.accent : AppTheme.muted-text;
                font-size: 12px;
                overflow: elide;
            }
        }

        Rectangle {
            width: 16px;
            property <float> show: root.busy ? 1 : 0;
            animate show { duration: AppTheme.motion-slow; easing: ease-out; }
            visible: self.show > 0.01;
            opacity: self.show;
            Image {
                source: root.spinner;
                colorize: AppTheme.accent;
                width: 16px;
                height: 16px;
                image-fit: contain;
                // Ticks only while connecting, so a still list costs nothing.
                transform-rotation: root.busy && !AppTheme.reduce-motion ? animation-tick() / 800ms * 360deg : 0deg;
            }
        }
    }

    device-hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> hint: "";
    callback clicked();

    height: 32px;
    GlassHover { lit: menu-touch.has-hover; radius: 7px; strength: 1; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: AppTheme.text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.hint;
            color: AppTheme.subtle-text;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    menu-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The song's lyrics, large, in place of the page. Synced lyrics light up the line being sung
// and keep it a third of the way down. Turning the wheel lets them be read ahead, and they go
// back to the song a few seconds after. Clicking a line plays from it.
component LyricsView inherits Rectangle {
    in property <[LyricLine]> lines;
    in property <int> current: -1;
    in property <string> state;
    in property <string> provider;
    in property <bool> has-track;
    callback seek(int);
    callback close();

    // Lines run no wider than this, so they read as lines rather than a wall of words, and the
    // column sits in the middle, as the stage's cover does.
    // A narrow middle, with both sidebars open in a small window, keeps more of its width for the
    // words and sets them smaller.
    property <length> margin: self.width < 480px ? 24px : 40px;
    property <length> measure: min(self.width - 2 * self.margin, 760px);
    property <length> side: (self.width - self.measure) / 2;
    property <length> type-size: self.width < 460px ? 22px : (self.width < 620px ? 26px : 32px);
    // What the floating player bar covers at the bottom.
    property <length> bar-room: 80px;

    if !root.has-track || root.state == "loading" || root.state == "none" || root.state == "error" || root.state == "" : VerticalLayout {
        height: parent.height - root.bar-room;
        alignment: center;
        padding: 40px;
        spacing: 8px;
        Text {
            text: !root.has-track ? "Nothing playing"
                : (root.state == "none" ? "No lyrics for this song"
                : (root.state == "error" ? "Couldn't load the lyrics" : "Finding the lyrics…"));
            color: root.state == "loading" || root.state == "" ? AppTheme.subtle-text : AppTheme.text;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.2px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.has-track && root.state == "error" : Text {
            text: "Spotify didn't answer. They'll be tried again with the next song.";
            color: AppTheme.subtle-text;
            font-size: 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if root.has-track && root.state == "synced" : synced := Rectangle {
        clip: true;
        // Where the line being sung is in the column, which it reports.
        property <length> active-top: 0px;
        property <length> active-height: 0px;
        property <length> follow: root.current < 0 ? 0px : min(0px, (self.height - root.bar-room) * 0.36 - self.active-top - self.active-height / 2);
        // Scrolled by hand: the view stays where it was put.
        property <bool> holding: false;
        property <length> held-at: 0px;
        property <length> offset: self.holding ? self.held-at : self.follow;
        animate offset { duration: AppTheme.reduce-motion || self.holding ? 0ms : 480ms; easing: ease-out; }
        hold := Timer {
            interval: 3500ms;
            running: false;
            triggered => {
                synced.holding = false;
                self.running = false;
            }
        }

        wheel := TouchArea {
            scroll-event(event) => {
                if (!synced.holding) {
                    synced.held-at = synced.offset;
                    synced.holding = true;
                }
                synced.held-at = max(-(column.preferred-height - synced.height * 0.4), min(40px, synced.held-at + event.delta-y));
                hold.running = true;
                hold.restart();
                return accept;
            }

            column := VerticalLayout {
                y: synced.offset;
                height: self.preferred-height;
                padding-left: root.side;
                padding-right: root.side;
                padding-top: 36px;
                padding-bottom: 200px;
                spacing: 2px;

                for line[index] in root.lines : row := Rectangle {
                    property <bool> active: index == root.current;
                    height: words.preferred-height + 16px;
                    // The line being sung reports where it is, and again when the panel is made
                    // wider or narrower and the lines wrap differently. Its place is read only once
                    // the line has been made: lines are made while the column works out its size,
                    // and reading a line's place then is a loop that Slint stops by crashing.
                    property <bool> placed: false;
                    Timer {
                        interval: 1ms;
                        running: !row.placed;
                        triggered => { row.placed = true; }
                    }
                    property <length> top-if-sung: self.placed && self.active ? self.y : -1px;
                    property <length> height-if-sung: self.placed && self.active ? self.height : -1px;
                    function report() {
                        if (self.active) {
                            synced.active-top = self.y;
                            synced.active-height = self.height;
                        }
                    }
                    changed top-if-sung => { self.report(); }
                    changed height-if-sung => { self.report(); }
                    words := Text {
                        y: 8px;
                        width: parent.width;
                        text: line.words;
                        wrap: word-wrap;
                        font-size: root.type-size;
                        font-weight: 700;
                        letter-spacing: -0.4px;
                        color: parent.active ? AppTheme.text
                            : (line-touch.has-hover ? AppTheme.text.transparentize(0.3)
                            : (index < root.current ? AppTheme.text.transparentize(0.55) : AppTheme.text.transparentize(0.7)));
                        animate color { duration: AppTheme.reduce-motion ? 0ms : 260ms; easing: ease-out; }
                        // Lines fade out as they leave by the top, rather than being cut off.
                        opacity: max(0, min(1, (row.y + synced.offset + row.height / 2) / 64px));
                    }
                    line-touch := TouchArea {
                        width: words.width;
                        mouse-cursor: pointer;
                        clicked => {
                            synced.holding = false;
                            root.seek(line.start-ms);
                        }
                    }
                }
                if root.provider != "" : Text {
                    height: 48px;
                    text: "Lyrics provided by " + root.provider;
                    color: AppTheme.muted-text;
                    font-size: 12px;
                    vertical-alignment: bottom;
                }
            }
        }
    }

    if root.has-track && root.state == "unsynced" : ScrollView {
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: self.visible-width;
        VerticalLayout {
            width: parent.visible-width;
            padding-left: root.side;
            padding-right: root.side;
            padding-top: 36px;
            padding-bottom: 200px;
            spacing: 14px;
            alignment: start;
            Text {
                text: "These lyrics aren't synced to the song.";
                color: AppTheme.muted-text;
                font-size: 13px;
            }
            for line in root.lines : Text {
                text: line.words;
                wrap: word-wrap;
                font-size: root.type-size - 4px;
                font-weight: 700;
                letter-spacing: -0.3px;
                color: AppTheme.text.transparentize(0.15);
            }
            if root.provider != "" : Text {
                height: 48px;
                text: "Lyrics provided by " + root.provider;
                color: AppTheme.muted-text;
                font-size: 12px;
                vertical-alignment: bottom;
            }
        }
    }

    // Back to the page underneath.
    QueueGlyph {
        x: parent.width - self.width - 16px;
        y: 12px;
        clicked => { root.close(); }
    }
}

// The edge between a side and the middle, dragged to make the side wider or narrower. A
// faint line shows where it is once the pointer finds it.
component SideGrip inherits Rectangle {
    // How far the pointer is from where it took hold, each time it moves.
    callback dragged(length);
    callback dropped();
    // Double-clicked: back to the usual width.
    callback reset();

    width: 8px;
    Rectangle {
        width: 2px;
        y: 14px;
        height: max(0px, parent.height - 110px);
        border-radius: 1px;
        background: AppTheme.text;
        opacity: grip-touch.pressed ? 0.26 : (grip-touch.has-hover ? 0.14 : 0);
        animate opacity { duration: AppTheme.motion-duration; easing: ease-out; }
    }
    grip-touch := TouchArea {
        mouse-cursor: ew-resize;
        moved => {
            if (self.pressed) {
                root.dragged(self.mouse-x - self.pressed-x);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dropped();
            }
        }
        double-clicked => { root.reset(); }
    }
}

// The glass body of a popup menu.
component MenuSurface inherits Rectangle {
    in property <float> density: 0.82;

    // A real drop shadow left a white line along the bottom of the popup.
    Image {
        x: -20px;
        y: -16px;
        width: parent.width + 40px;
        height: parent.height + 40px;
        source: @image-url("../assets/soft-edge.png", nine-slice(15 28));
        colorize: #000000;
        opacity: 0.35;
    }

    GlassPane {
        radius: 11px;
        // Dark enough that what's behind doesn't fight the menu's own text.
        background: AppTheme.window-bg.with-alpha(root.density);
        @children
    }
}

// ─── Setup guide ───────────────────────────────────────────────────────────

// Where the guide is: a short pill for each page, the current one long.
component GuidePills inherits HorizontalLayout {
    in property <int> count;
    in property <int> current;
    spacing: 6px;
    alignment: start;
    for index in root.count : VerticalLayout {
        alignment: center;
        Rectangle {
            width: index + 1 == root.current ? 22px : 6px;
            height: 6px;
            border-radius: 3px;
            background: index + 1 <= root.current ? AppTheme.accent : AppTheme.text.with-alpha(0.14);
            animate width { duration: AppTheme.motion-slow; easing: ease-out; }
            animate background { duration: AppTheme.motion-slow; easing: ease-out; }
        }
    }
}

// One page of the guide: a title, a line under it, then what the page holds. It rises into place
// as it opens.
component GuidePage inherits Rectangle {
    in property <string> title;
    in property <string> lead;
    property <float> reveal: 0;
    init => { self.reveal = 1; }
    animate reveal { duration: AppTheme.motion-slow; easing: ease-out; }
    height: page-rows.preferred-height;
    opacity: self.reveal;

    page-rows := VerticalLayout {
        y: (1 - root.reveal) * 8px;
        height: self.preferred-height;
        spacing: 0px;
        Text {
            text: root.title;
            color: AppTheme.text;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.3px;
            wrap: word-wrap;
        }
        Rectangle { height: 6px; }
        Text {
            text: root.lead;
            color: AppTheme.subtle-text;
            font-size: 14px;
            wrap: word-wrap;
        }
        Rectangle { height: 22px; }
        @children
    }
}

// A numbered step in making a Spotify app, with room on the right for a button.
component GuideStep inherits Rectangle {
    in property <int> number;
    in property <string> title;
    in property <string> detail;
    in property <length> control-width: 0px;
    height: max(46px, step-text.preferred-height + 8px);

    Rectangle {
        x: 0px;
        y: 4px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: AppTheme.accent-soft;
        border-width: 1px;
        border-color: AppTheme.accent-border;
        Text {
            text: root.number;
            color: AppTheme.accent;
            font-size: 12px;
            font-weight: 700;
        }
    }
    step-text := VerticalLayout {
        x: 38px;
        y: 4px;
        width: root.width - 38px - (root.control-width > 0px ? root.control-width + 14px : 0px);
        height: self.preferred-height;
        spacing: 2px;
        Text {
            text: root.title;
            color: AppTheme.text;
            font-size: 14px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.detail;
            color: AppTheme.subtle-text;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
    Rectangle {
        x: root.width - root.control-width;
        y: 4px;
        width: root.control-width;
        height: 32px;
        @children
    }
}

// Three dots taking turns, for a wait on the browser. A timer steps them a few times a second,
// so the window isn't redrawn at the full frame rate while the browser is in front.
component WaitingDots inherits Rectangle {
    width: 26px;
    height: 14px;
    property <int> lit: 0;
    Timer {
        interval: 220ms;
        running: !AppTheme.reduce-motion;
        triggered => { root.lit = mod(root.lit + 1, 3); }
    }
    for index in 3 : Rectangle {
        x: index * 10px;
        y: (root.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: AppTheme.accent;
        opacity: AppTheme.reduce-motion || index == root.lit ? 1 : 0.3;
    }
}

// A key, as in "press Ctrl K".
component KeyCap inherits Rectangle {
    in property <string> text;
    width: key-text.preferred-width + 14px;
    height: 22px;
    border-radius: 5px;
    background: AppTheme.text.with-alpha(0.07);
    border-width: 1px;
    border-color: AppTheme.text.with-alpha(0.1);
    key-text := Text {
        text: root.text;
        color: AppTheme.secondary-text;
        font-size: 11px;
        font-weight: 600;
    }
}

// A tip: the keys, then what they do.
component GuideTip inherits HorizontalLayout {
    in property <[string]> keys;
    in property <string> text;
    spacing: 5px;
    alignment: start;
    for key in root.keys : VerticalLayout {
        alignment: center;
        KeyCap { text: key; }
    }
    Text {
        text: root.text;
        color: AppTheme.subtle-text;
        font-size: 12px;
        vertical-alignment: center;
    }
}

// ─── Window ────────────────────────────────────────────────────────────────

export component AppWindow inherits Window {
    callback scale_changed();
    property <float> window-scale: 1px / 1phx;
    changed window-scale => {
        AppTheme.can-cache = round(self.window-scale) == self.window-scale;
        root.scale_changed();
    }
    function format-ms(ms: int) -> string {
        return floor(ms / 60000) + ":" + (Math.mod(floor(ms / 1000), 60) < 10 ? "0" : "") + Math.mod(floor(ms / 1000), 60);
    }

    // Connection & now playing
    in-out property <string> client_id;
    in-out property <string> redirect_uri;
    in-out property <string> connection_status: "Not connected";
    // Why Spotlight can't keep up with Spotify just now, such as "Offline", or "" while it can.
    in-out property <string> sync_trouble: "";
    in-out property <string> player_status: "Offline";
    in-out property <bool> signed_in: false;
    in-out property <string> track_title: "Nothing playing";
    in-out property <[string]> track_artists: [""];
    in-out property <string> track_album: "";
    in-out property <string> track_release_date: "";
    in-out property <string> current_track_uri: "";
    in-out property <string> playing_device_name: "";
    in-out property <string> active_device_name: "";
    in-out property <string> local_device_name: "Spotlight PC";
    in-out property <string> stream_quality: "";
    in-out property <image> album_art;
    in-out property <string> elapsed: "0:00";
    in-out property <string> duration: "0:00";
    in-out property <int> progress_ms: 0;
    in-out property <int> progress_max_ms: 100;
    in-out property <int> volume_percent: 100;
    in-out property <int> previous_volume_percent: 100;
    in-out property <bool> muted: false;
    in-out property <bool> is_playing: false;
    in-out property <bool> shuffle_enabled: false;
    in-out property <string> repeat_mode: "off";

    // Icons
    in-out property <image> spotlight_logo;
    in-out property <image> play_icon;
    in-out property <image> pause_icon;
    in-out property <image> previous_icon;
    in-out property <image> next_icon;
    in-out property <image> search_icon;
    in-out property <image> refresh_icon;
    in-out property <image> settings_icon;
    in-out property <image> playlist_icon;
    in-out property <image> device_icon;
    in-out property <image> queue_icon;
    in-out property <image> shuffle_icon;
    in-out property <image> repeat_icon;
    in-out property <image> volume_icon;
    in-out property <image> volume_low_icon;
    in-out property <image> mute_icon;
    in-out property <image> repeat_one_icon;
    in-out property <image> fullscreen_icon;
    in-out property <image> plus_icon;
    in-out property <image> lyrics_icon;
    in-out property <image> mini_player_icon;
    // Recently played's cover, drawn like Liked Songs'.
    in-out property <image> history_art;

    // Updates, from Spotlight's releases on GitHub.
    in-out property <string> app_version;
    in-out property <bool> check_for_updates: true;
    // Empty until a check finds a newer version, then its number, such as "1.1.0".
    in-out property <string> update_version: "";
    // What's under way: "", "checking", "downloading" or "installing".
    in-out property <string> update_busy: "";
    in-out property <float> update_progress: 0;
    // The last check's answer when there's nothing to install: "Up to date", or why it failed.
    in-out property <string> update_note: "";
    // Why the last try at installing failed.
    in-out property <string> update_error: "";
    // False for a copy that can only link to the download, such as a build from source.
    in-out property <bool> update_installs_here: false;
    // Update was pressed for a file GitHub lists no checksum for, so it asks once more.
    in-out property <bool> update_confirming: false;
    // How much the covers saved on this PC take, worked out as Settings opens.
    in-out property <string> cover_cache_note: "";
    in-out property <bool> cover_cache_clearable: false;
    callback measure_cover_cache();
    callback clear_cover_cache();
    callback check_for_update();
    callback install_update();
    callback open_update_notes();

    // Settings
    in-out property <bool> artwork_enabled: true;
    in-out property <bool> show_artist_column: true;
    in-out property <bool> show_time_column: true;
    in-out property <bool> compact_sidebars: false;
    in-out property <string> theme_mode: "Dark";
    in-out property <string> accent_color: "Green";
    in-out property <string> audio_quality: "Normal";
    in-out property <string> output_device: "";
    in property <[string]> output_devices;
    in-out property <bool> output_device_missing: false;
    in-out property <bool> normalize_volume: true;
    in-out property <bool> autoplay_similar: true;
    // Seconds a song fades into the next as it ends. Zero is off.
    in-out property <int> crossfade_seconds: 0;
    in-out property <bool> remember_volume: true;
    in-out property <bool> resume_on_startup: false;
    in-out property <bool> global_hotkeys: true;
    in-out property <bool> media_keys_enabled: true;
    in-out property <string> play_pause_hotkey: "Ctrl+Alt+P";
    in-out property <string> next_hotkey: "Ctrl+Alt+N";
    in-out property <string> previous_hotkey: "Ctrl+Alt+B";
    in-out property <string> shuffle_hotkey: "Ctrl+Alt+S";
    in-out property <string> repeat_hotkey: "Ctrl+Alt+R";
    in-out property <string> hotkey_warning: "";
    // The shortcut box listening for keys, by its action, or "" when none is.
    in-out property <string> recording_shortcut: "";
    // Shown in the listening box: the keys held so far, or why the last one can't be used.
    in-out property <string> shortcut_keys: "";
    in-out property <bool> shortcut_refused: false;
    in-out property <bool> minimize_to_tray: false;
    in-out property <bool> close_to_tray: false;
    in-out property <bool> start_minimized: false;
    in-out property <bool> tray_at_sign_in: true;
    in-out property <bool> low_resource_mode: true;
    in-out property <bool> reduce_animations: false;
    in-out property <bool> disable_background_effects: true;
    in-out property <bool> album_colors: true;
    in-out property <string> log_level: "Info";
    in-out property <bool> developer_mode: false;
    in-out property <string> status_log: "Ready.";

    // Library & tracks
    in-out property <[string]> playlist_titles;
    in-out property <[string]> playlist_subtitles;
    in-out property <[image]> playlist_images;
    in-out property <[TrackItem]> track_rows;
    in-out property <string> track_view_title: "Liked Songs";
    in-out property <string> track_view_meta: "";
    in-out property <bool> track_view_loading: false;
    // Only part of a long library list is loaded, and the rest can be, at the list's end.
    in-out property <bool> track_view_more: false;
    in-out property <bool> track_view_more_busy: false;
    callback load_more_tracks();
    // The same for the library's playlists, at the sidebar's end.
    in-out property <bool> more_playlists: false;
    in-out property <bool> more_playlists_busy: false;
    callback load_more_playlists();
    in-out property <bool> show_home: false;
    in-out property <[HomeSection]> home_sections: [];
    in-out property <bool> home_loading: false;
    in-out property <string> home_error: "";
    in-out property <bool> tracks_have_album: false;
    in-out property <string> track_filter: "";
    in-out property <string> search_query: "";
    in-out property <[SearchSuggestion]> search_suggestions;
    in-out property <int> selected_playlist_index: -1;
    in-out property <int> selected_liked_song_index: -1;

    // Devices & queue
    in-out property <[string]> device_titles;
    in-out property <[string]> device_subtitles;
    in-out property <[string]> device_badges;
    in-out property <[image]> device_images;
    in-out property <[bool]> device_is_active;
    in-out property <[bool]> device_is_local;
    in-out property <int> selected_device_index: -1;
    in-out property <bool> device_switching: false;
    in-out property <image> spinner_icon;
    in-out property <[image]> queue_images;
    in-out property <[string]> queue_titles;
    in-out property <[string]> queue_artists;
    in-out property <bool> queue_reorder_enabled: false;
    in-out property <bool> queue_busy: false;
    in-out property <string> queue_summary: "";

    // View state
    in-out property <bool> show_settings: false;
    in-out property <int> inspector_tab: 1; // 0 closed, 1 now playing, 2 devices
    // What closing the device list goes back to.
    property <int> inspector-return: 1;
    // What the right panel shows, which stays put while the panel slides shut.
    property <int> inspector-face: 1;
    changed inspector_tab => {
        if (root.inspector_tab > 0) {
            root.inspector-face = root.inspector_tab;
        }
    }
    // The lyrics, in place of the page. They and the stage take the same place, so one
    // opening closes the other.
    in-out property <bool> lyrics_open: false;
    changed lyrics_open => {
        if (root.lyrics_open) {
            root.stage_open = false;
            root.lyrics_wanted();
        }
    }

    // Lyrics for the song playing, while they are open.
    in-out property <[LyricLine]> lyrics_lines: [];
    // The line being sung, or -1 before the first or when they aren't synced.
    in-out property <int> lyrics_line: -1;
    // "loading", "synced", "unsynced", "none" or "error". "" before any are asked for.
    in-out property <string> lyrics_state: "";
    in-out property <string> lyrics_provider: "";
    // The lyrics opened, or the song changed while they were open.
    callback lyrics_wanted();
    in-out property <bool> stage_open: false;
    changed stage_open => {
        if (root.stage_open) {
            root.lyrics-behind-stage = root.lyrics_open;
            root.lyrics_open = false;
        }
    }
    // The stage opened over the lyrics, which come back when it's closed. Moving to another
    // page closes both.
    property <bool> lyrics-behind-stage: false;
    public function close-stage() {
        root.stage_open = false;
        if (root.lyrics-behind-stage) {
            root.lyrics_open = true;
        }
        root.lyrics-behind-stage = false;
    }
    // The stage cover leans away from the pointer. Slint can't draw that in perspective, so
    // while it leans the app draws it (art_tilt.rs) into stage_tilt_image, shown in its place.
    out property <bool> stage_tilting: stage.tilted;
    out property <float> stage_tilt_x: stage.tilt-x;
    out property <float> stage_tilt_y: stage.tilt-y;
    out property <length> stage_tilt_canvas: stage.tilt-canvas;
    out property <length> stage_art_shown: stage.shown-size;
    out property <float> stage_art_zoom: stage.drift;
    out property <length> stage_art_radius: 14px;
    in-out property <image> stage_tilt_image;
    // Set by the app once it has drawn the leaning cover. Until then Slint draws it flat.
    in-out property <bool> stage_tilt_ready: false;
    in-out property <bool> track_liked: false;
    in-out property <string> track_view_kicker: "Search results";
    in-out property <image> track_view_art;
    in-out property <bool> track_view_has_art: false;
    // A neutral surface a step above the window, in either theme.
    property <color> surface: AppTheme.window-bg.mix(#808080, 0.93);
    changed current_track_uri => {
        root.check_liked();
        root.now_playing_changed();
        if (root.lyrics_open) {
            root.lyrics_wanted();
        }
    }
    // For Windows' media controls and the taskbar's buttons.
    callback now_playing_changed();
    changed track_title => { root.now_playing_changed(); }
    changed is_playing => { root.now_playing_changed(); }
    property <int> device-spins: 0;
    property <angle> device-spin-angle: root.device-spins * 360deg;
    animate device-spin-angle { duration: AppTheme.reduce-motion ? 0ms : 800ms; easing: ease-in-out; }
    in-out property <int> previous_playlist_index: 0;
    in-out property <int> search_highlight: -1;
    in-out property <int> track_context_index: -1;
    in-out property <length> track_context_popup_x: 360px;
    in-out property <length> track_context_popup_y: 180px;
    in-out property <string> track_context_uri: "";
    in-out property <string> track_context_title: "";
    in-out property <bool> track_context_liked: false;
    in-out property <bool> track_context_has_album: true;
    // Before the song menu shows, so it can say whether the song is liked.
    callback track_menu_opened(int);
    // artist, album, radio, copy-link, like or unlike, for a row in the list shown.
    callback track_menu_action(string, int);
    callback open_history();
    // A name, and a song to put in it or "".
    callback create_playlist(string, string);
    in-out property <bool> picker_open: false;
    in-out property <string> picker_uri: "";
    in-out property <string> picker_song: "";
    in-out property <string> picker_query: "";
    in-out property <[int]> picker_indices: [];
    in-out property <int> picker_cursor: 0;
    callback filter_playlist_picker(string);
    callback add_to_playlist(string, int);
    in-out property <string> toast_text: "";
    in-out property <bool> toast_error: false;
    in-out property <bool> toast_visible: false;
    in-out property <bool> window_maximized: false;
    // Running on a Mac, which draws the window's own three buttons at the left of the top bar,
    // moves the window by the bar's empty parts, and has its own names for things.
    in property <bool> is_mac: false;
    // The Mac's full screen, which has none of those buttons.
    in property <bool> mac_full_screen: false;
    // Running on Linux, which keeps Windows' top bar and buttons but has no tray, no
    // shortcuts of its own in the background and no updates to fetch.
    in property <bool> is_linux: false;
    // Only Windows has those.
    property <bool> is-windows: !root.is_mac && !root.is_linux;
    // Whether a window may keep itself above the others. Not under Wayland.
    in property <bool> can_keep_on_top: true;
    // Linux only: whether Spotlight opens as the owner signs in.
    in-out property <bool> open_at_sign_in: false;
    callback open_at_sign_in_changed(bool);
    property <bool> mac-buttons-shown: root.is_mac && !root.mac_full_screen;
    property <string> this-computer: root.is_mac ? "this Mac" : root.is_linux ? "this computer" : "this PC";
    property <string> default-device-label: root.is-windows ? "Windows default" : "System default";
    // The key that goes with a letter for a shortcut, as in "Ctrl+K".
    property <string> command-key: root.is_mac ? "⌘" : "Ctrl+";
    // A press on an empty part of the top bar or of the mini player, for the Mac to move the window by.
    callback drag_window();
    // Minimized or in the tray. Slint still draws frames for such a window, so moving parts stop.
    in-out property <bool> window_hidden: false;
    in-out property <bool> caption_max_hover: false;
    in-out property <bool> caption_max_pressed: false;

    callback save_settings();
    callback save_library_size();
    callback connect_spotify();
    callback sign_out();
    callback refresh_library();
    callback search_tracks(string);
    callback search_changed(string);
    callback filter_tracks(string);
    callback refresh_devices();
    callback play_pause();
    callback previous_track();
    callback next_track();
    callback toggle_shuffle();
    callback cycle_repeat();
    callback seek_to(int);
    callback set_volume(int);
    callback toggle_mute();
    callback activate_playlist(int);
    callback activate_liked_song(int);
    callback track_context_action(string, int);
    callback activate_device(int);
    callback select_playlist(int);
    callback move_queue_item(int, int);
    callback remove_queue_item(int);
    callback play_queue_item(int);
    callback check_liked();
    callback toggle_like();
    callback open_artist(string);
    callback open_album();
    callback home_opened();
    callback refresh_home();
    callback home_section_shown(int, int);
    callback home_toggle_section(int);
    // Opens a Home card's page.
    callback open_home_card(int, int);
    // Plays a Home card's songs, staying on Home.
    callback play_home_card(int, int);
    callback clear_queue();
    callback toggle_fullscreen();
    // The mini player: the window shrinks to a small card of the song playing.
    in-out property <bool> mini_mode: false;
    in-out property <bool> mini_on_top: true;
    callback toggle_mini_player();
    callback mini_on_top_changed(bool);
    // It was dragged, so its window's top left corner is here on the screen now.
    callback mini_moved(int, int);
    changed mini_mode => {
        if (!self.mini_mode) {
            keys.focus();
        }
    }
    callback refresh_output_devices();
    callback cycle_hotkey(string);
    // Starts a shortcut box listening for its action's keys, or with "" stops without a change.
    callback record_shortcut(string);
    // A key went down in the listening box (a Windows key code), or 0 when one was let go,
    // with Ctrl, Alt, Shift and Win as they are after it.
    callback shortcut_key(int, bool, bool, bool, bool);
    callback reset_app_data();
    // Windows treats the empty parts of the top bar as the real title bar, so
    // it needs to know where the interactive parts are.
    callback caption_layout(length, length, bool, bool);
    property <length> caption-search-left: search-box.absolute-position.x;
    // The settings button sits straight after the search box.
    property <length> caption-search-right: search-box.absolute-position.x + search-box.width + 48px;
    property <bool> caption-back: root.in-search && !root.onboarding-shown;
    public function report-caption-layout() {
        root.caption_layout(root.caption-search-left, root.caption-search-right, root.caption-back, root.top-connect-shown);
    }
    changed caption-search-left => { root.report-caption-layout(); }
    changed caption-search-right => { root.report-caption-layout(); }
    changed caption-back => { root.report-caption-layout(); }
    changed top-connect-shown => { root.report-caption-layout(); }

    // ── Setup guide ──
    // Its page: 0 when it's closed, then welcome, making a Spotify app, connecting, and a few
    // choices to finish. It opens by itself while nobody is signed in.
    in-out property <int> onboarding_step: 0;
    // How connecting is going: "" before it starts, "library" while the browser asks to let
    // Spotlight in, "player" while it asks again for playing on this PC, then "done" or
    // "failed".
    in-out property <string> connect_stage: "";
    in-out property <string> connect_error: "";
    // Whether playing on this PC was signed in too, or put off.
    in-out property <bool> player_ready: true;
    callback open_link(string);
    callback copy_text(string) -> bool;
    // Stops waiting on the browser for whichever sign-in is open.
    callback cancel_sign_in();
    // What's wrong with a Client ID, or nothing.
    pure callback client_id_problem(string) -> string;
    property <bool> onboarding-shown: root.onboarding_step > 0 && !root.show_settings && !root.mini_mode;
    property <bool> top-connect-shown: !root.signed_in && !root.onboarding-shown;
    property <bool> connect-busy: root.connect_stage == "library" || root.connect_stage == "player";
    changed connect_stage => {
        if (root.connect_stage == "done" && root.onboarding_step == 3) {
            root.onboarding_step = 4;
        }
    }
    function close-onboarding() {
        root.onboarding_step = 0;
        if (root.signed_in) {
            root.open_home();
        }
        keys.focus();
    }
    property <bool> shortcut-field-pressed: false;
    callback pointer_pressed(length, length);
    pointer_pressed(x, y) => {
        // A click anywhere but a shortcut box stops the one listening. This runs after the
        // press has reached the box, and sometimes after the click too.
        if (root.shortcut-field-pressed) {
            root.shortcut-field-pressed = false;
        } else if (root.recording_shortcut != "") {
            root.record_shortcut("");
        }
        // Clicking anywhere else leaves a focused search or filter box.
        if (search-input.has-focus) {
            let left = search-box.absolute-position.x;
            let top = search-box.absolute-position.y;
            let bottom = top + search-box.height + (root.search_query == "" ? 0px : 90px + root.search_suggestions.length * 50px);
            if (x < left || x > left + search-box.width || y < top || y > bottom) {
                root.search_highlight = -1;
                keys.focus();
            }
        } else if (filter-input.has-focus) {
            let left = filter-box.absolute-position.x;
            let top = filter-box.absolute-position.y;
            if (x < left || x > left + filter-box.width || y < top || y > top + filter-box.height) {
                keys.focus();
            }
        }
    }
    callback minimize_window();
    callback close_window();
    // The window can be seen again. Runs before its first frame is drawn.
    callback window_shown();

    property <bool> has-track: root.current_track_uri != "" || root.track_title != "Nothing playing";
    // The queue goes with it, along with any row in motion.
    changed has-track => { root.queue_busy = false; }
    // Nothing Slint draws follows these while the cover leans, so it's told to draw again.
    callback stage_tilt_redraw();
    changed album_art => {
        root.now_playing_changed();
        if (stage.show-tilt) {
            root.stage_tilt_redraw();
        }
    }
    property <bool> show-inspector: root.inspector_tab > 0;
    // The two sides' widths as last dragged. Rust sets them from the saved settings.
    in-out property <length> library_width: 272px;
    in-out property <length> panel_width: 348px;
    // While a side is being dragged it follows the pointer straight away, and nothing that
    // usually eases along with a side does.
    property <bool> sides-dragging: false;
    // Drags stop where the middle would get narrower than it is in the smallest window.
    pure function library-limit() -> length {
        return max(240px, min(420px, root.width - (root.show-inspector ? root.panel_width : 0px) - 480px));
    }
    pure function panel-limit() -> length {
        return max(300px, min(520px, root.width - root.library-target - 480px));
    }
    // A drag lands now, so nothing eases into place after it.
    function sides-dropped() {
        root.sides-dragging = false;
        root.sides-settled = root.sides-target;
        root.library-settled = root.library-target;
        root.panel-words = root.sides-target;
        root.save_library_size();
    }
    // Where the panel is heading. Home lays out for the width it will end up with, straight
    // away, then moves there in step with the panel. Following the panel's width instead
    // changes the number of columns on the way, and every card jumps in size each time.
    property <length> panel-target: root.show-inspector ? root.panel_width : 0px;
    // The library, small or full, in step with the panel.
    property <length> library-small: 76px;
    property <length> library-target: root.compact_sidebars ? root.library-small : root.library_width;
    property <length> library-settled: 272px;
    property <bool> library-moving: root.library-target != root.library-settled && !AppTheme.reduce-motion && !root.sides-dragging;
    // Its words go before it narrows and come back once it has room.
    property <float> library-words: root.compact_sidebars ? 0 : 1;
    animate library-words {
        duration: AppTheme.reduce-motion ? 0ms : (root.compact_sidebars ? 90ms : 170ms);
        delay: AppTheme.reduce-motion || root.compact_sidebars ? 0ms : 150ms;
        easing: ease-out;
    }
    // In the small library, a cover's name appears beside it.
    property <int> library-tip: -1;
    property <length> library-tip-y: 0px;
    function library-row-hover(index: int, hovered: bool, top: length) {
        if (hovered) {
            root.library-tip = index;
            root.library-tip-y = top;
        } else if (root.library-tip == index) {
            root.library-tip = -1;
        }
    }
    // What Home gives up beside it: the panel, and the library past its small size.
    property <length> sides-target: root.panel-target + root.library-target - root.library-small;
    property <length> sides-settled: 544px;
    property <bool> panel-moving: root.sides-target != root.sides-settled && !AppTheme.reduce-motion && !root.sides-dragging;
    panel-settle := Timer {
        interval: 340ms;
        running: false;
        triggered => {
            root.sides-settled = root.sides-target;
            root.library-settled = root.library-target;
            self.running = false;
        }
    }
    panel-words-swap := Timer {
        interval: 110ms;
        running: false;
        triggered => {
            root.panel-words = root.sides-target;
            self.running = false;
        }
    }
    changed sides-target => {
        panel-settle.running = true;
        panel-settle.restart();
        panel-words-swap.running = true;
        panel-words-swap.restart();
    }
    // The window, less the margins and the small library. Nothing here depends on the sides'
    // widths as they move, so the words on the cards don't have to be drawn again every frame.
    property <length> home-width-closed: root.width - 24px - root.library-small;
    pure function home-cols-for(panel: length) -> int {
        return max(2, floor((root.home-width-closed - panel - 22px) / 188px));
    }
    pure function home-cell-for(panel: length) -> length {
        let cols = root.home-cols-for(panel);
        return floor((root.home-width-closed - panel - 32px - 10px * (cols - 1)) / cols / 1phx) * 1phx;
    }
    property <length> home-cards-span: root.home-width-closed - root.sides-target - 32px;
    property <int> home-card-cols: root.home-cols-for(root.sides-target);
    property <int> home-card-cols-wide: root.home-cols-for(0px);
    property <length> home-card-cell: root.home-cell-for(root.sides-target);
    property <length> home-tiles-span: root.home-width-closed - root.sides-target - 36px;
    property <int> home-tile-cols: root.home-tiles-span >= 760px ? 4 : 2;
    property <length> home-tile-cell: floor((root.home-tiles-span - 8px * (root.home-tile-cols - 1)) / root.home-tile-cols / 1phx) * 1phx;
    // The sizes on screen, which catch up with those.
    property <length> home-card-cell-shown: root.home-card-cell;
    animate home-card-cell-shown { duration: root.panel-moving ? AppTheme.motion-slow : 0ms; easing: ease-in-out; }
    property <length> home-tile-cell-shown: root.home-tile-cell;
    animate home-tile-cell-shown { duration: root.panel-moving ? AppTheme.motion-slow : 0ms; easing: ease-in-out; }
    // Subtitles break into lines differently at a new width. So that they don't jump, they
    // fade out first, change while they can't be seen, and fade back in.
    property <length> panel-words: 544px;
    property <length> home-words-cell: AppTheme.reduce-motion || root.sides-dragging ? root.home-card-cell : root.home-cell-for(root.panel-words);
    property <float> home-words-fade: AppTheme.reduce-motion || root.sides-dragging || root.panel-words == root.sides-target ? 1 : 0;
    animate home-words-fade { duration: AppTheme.reduce-motion ? 0ms : (root.panel-words == root.sides-target ? 170ms : 100ms); easing: ease-out; }
    property <bool> in-search: root.selected_playlist_index < 0 && !root.show_home;
    // Search results are a list to pick from, not something to play through, so they show
    // just the songs: the search itself is still in the box above.
    property <bool> search-page: root.in-search && root.track_view_kicker == "Search results";
    // A list page opened from Home goes back there.
    property <bool> back-to-home: false;
    property <string> output-label: root.active_device_name == "" ? "No active device"
        : (root.active_device_name == root.local_device_name ? (root.is_mac ? "This Mac" : root.is_linux ? "This computer" : "This PC") : root.active_device_name);
    property <length> row-height: 48px;
    property <bool> reset-armed: false;
    property <int> suggestion-count: root.search_suggestions.length + 1;

    // A page arrives with a fade and a short rise, and its rows follow one after another.
    // Each run first drops to the start with no animation, then eases back up.
    property <float> page-in: 1;
    property <float> rows-in: 1;
    property <bool> page-restart: false;
    property <bool> rows-restart: false;
    animate page-in { duration: root.page-restart ? 0ms : 240ms; easing: ease-out; }
    animate rows-in { duration: root.rows-restart ? 0ms : 420ms; easing: linear; }
    Timer {
        interval: 1ms;
        running: root.page-restart || root.rows-restart;
        triggered => {
            if (root.page-restart) {
                root.page-restart = false;
                root.page-in = 1;
            }
            if (root.rows-restart) {
                root.rows-restart = false;
                root.rows-in = 1;
            }
        }
    }
    pure function arrive(t: float, order: int) -> float {
        let p = max(0, min(1, (t - min(order, 10) * 0.045) / 0.55));
        return 1 - (1 - p) * (1 - p);
    }
    // Whole pixels, as cached rows blur between them.
    pure function rise(reach: float) -> length {
        return round((1 - reach) * 12px / 1phx) * 1phx;
    }
    function rows-enter() {
        if (!AppTheme.reduce-motion) {
            root.rows-restart = true;
            root.rows-in = 0;
        }
    }
    function page-enter() {
        if (!AppTheme.reduce-motion) {
            root.page-restart = true;
            root.page-in = 0;
            root.rows-enter();
        }
    }
    changed track_view_loading => {
        if (!root.track_view_loading) {
            root.rows-enter();
        }
    }
    changed home_sections => { root.rows-enter(); }

    property <angle> home-spin: root.home_loading && !AppTheme.reduce-motion && !root.window_hidden ? animation-tick() / 900ms * 360deg : 0deg;

    // Only around a Show all or Show less, so a row's height otherwise follows the window at once.
    property <bool> home-resizing: false;
    home-resize-end := Timer {
        interval: 340ms;
        running: false;
        triggered => {
            root.home-resizing = false;
            self.running = false;
        }
    }
    function toggle-home-section(section: int) {
        root.home-resizing = !AppTheme.reduce-motion;
        home-resize-end.running = true;
        home-resize-end.restart();
        root.home_toggle_section(section);
    }

    function toggle-devices() {
        if (root.inspector_tab == 2) {
            root.inspector_tab = root.inspector-return;
        } else {
            root.inspector-return = root.inspector_tab;
            root.inspector_tab = 2;
            root.refresh_devices();
            root.device-spins += 1;
        }
    }

    public function open-home() {
        root.page-enter();
        root.show_settings = false;
        root.stage_open = false;
        root.lyrics_open = false;
        root.selected_playlist_index = -1;
        root.selected_liked_song_index = -1;
        root.track_filter = "";
        root.back-to-home = false;
        root.show_home = true;
        root.home_opened();
    }

    public function open-playlist(index: int) {
        root.page-enter();
        root.show_home = false;
        root.back-to-home = false;
        root.show_settings = false;
        root.stage_open = false;
        root.lyrics_open = false;
        root.selected_playlist_index = index;
        root.selected_liked_song_index = -1;
        root.track_view_title = root.playlist_titles[index];
        root.track_view_meta = "";
        root.track_filter = "";
        root.track_rows = [];
        root.select_playlist(index);
        track-list.viewport-y = 0px;
    }

    public function scroll-tracks-top() {
        track-list.viewport-y = 0px;
    }

    function scroll-to-selection() {
        let top = root.selected_liked_song_index * root.row-height;
        if (top < -track-list.viewport-y) {
            track-list.viewport-y = -top;
        } else if (top + root.row-height > -track-list.viewport-y + track-list.visible-height) {
            track-list.viewport-y = -(top + root.row-height - track-list.visible-height);
        }
    }

    // Row numbers shift when a filter goes away, so keep the same song selected.
    function clear-filter() {
        let source = root.selected_liked_song_index >= 0 && root.selected_liked_song_index < root.track_rows.length - 1
            ? root.track_rows[root.selected_liked_song_index].source-index : -1;
        root.track_filter = "";
        root.filter_tracks("");
        root.selected_liked_song_index = source;
        if (source >= 0) {
            root.scroll-to-selection();
        }
        keys.focus();
    }

    function go-back() {
        if (root.show_settings) {
            root.show_settings = false;
        } else if (root.in-search) {
            if (root.back-to-home) {
                root.open-home();
            } else {
                root.open-playlist(max(0, root.previous_playlist_index));
            }
        }
    }

    function run-search() {
        if (root.search_query == "") {
            return;
        }
        root.page-enter();
        if (root.show_home) {
            root.back-to-home = true;
            root.show_home = false;
        }
        if (!root.in-search) {
            root.previous_playlist_index = root.selected_playlist_index;
        }
        root.show_settings = false;
        root.stage_open = false;
        root.lyrics_open = false;
        root.selected_liked_song_index = -1;
        root.search_tracks(root.search_query);
        root.search_highlight = -1;
        keys.focus();
    }

    function accept-suggestion() {
        if (root.search_highlight >= 0 && root.search_highlight < root.search_suggestions.length) {
            root.open-playlist(root.search_suggestions[root.search_highlight].index);
            root.search_query = "";
            root.search_highlight = -1;
            root.search_changed("");
            keys.focus();
        } else {
            root.run-search();
        }
    }

    function leave-for-detail() {
        root.page-enter();
        if (root.show_home) {
            root.back-to-home = true;
            root.show_home = false;
        }
        if (!root.in-search) {
            root.previous_playlist_index = root.selected_playlist_index;
        }
        root.show_settings = false;
        root.stage_open = false;
        root.lyrics_open = false;
        root.selected_liked_song_index = -1;
    }

    function show-artist(name: string) {
        root.leave-for-detail();
        root.open_artist(name);
    }

    function show-album() {
        root.leave-for-detail();
        root.open_album();
    }

    // The listening history, a page like an album's. The Rust side names it this way.
    property <bool> history-open: root.in-search && root.track_view_kicker == "History";
    function show-history() {
        root.leave-for-detail();
        root.track_filter = "";
        root.open_history();
    }

    // Naming a new playlist, with a song to put in it or "".
    in-out property <bool> new_playlist_open: false;
    in-out property <string> new_playlist_name: "";
    property <string> new-playlist-song: "";
    function open-new-playlist(song-uri: string) {
        root.new-playlist-song = song-uri;
        root.new_playlist_name = "My Playlist #" + root.playlist_titles.length;
        root.new_playlist_open = true;
        new-playlist-input.focus();
        new-playlist-input.select-all();
    }
    function close-new-playlist() {
        root.new_playlist_open = false;
        keys.focus();
    }
    function make-new-playlist() {
        if (root.new_playlist_name.is-empty) {
            return;
        }
        root.create_playlist(root.new_playlist_name, root.new-playlist-song);
        root.close-new-playlist();
    }

    function play-selected() {
        if (root.selected_liked_song_index >= 0 && root.selected_liked_song_index < root.track_rows.length - 1) {
            root.activate_liked_song(root.track_rows[root.selected_liked_song_index].source-index);
        }
    }

    function nudge-volume(delta: int) {
        root.volume_percent = max(0, min(100, root.volume_percent + delta));
        root.muted = root.volume_percent == 0;
        root.set_volume(root.volume_percent);
    }

    function play-view() {
        if (root.show_home) {
            return;
        }
        if (root.in-search || root.track_filter != "") {
            if (root.track_rows.length > 0) {
                root.activate_liked_song(root.track_rows[0].source-index);
            }
        } else {
            root.activate_playlist(root.selected_playlist_index);
        }
    }

    function move-selection(delta: int) {
        if (root.track_rows.length == 0 || root.show_home) {
            return;
        }
        root.selected_liked_song_index = max(0, min(root.track_rows.length - 2, root.selected_liked_song_index + delta));
        root.scroll-to-selection();
    }

    function open-picker(uri: string, song: string) {
        if (uri == "") {
            return;
        }
        root.picker_uri = uri;
        root.picker_song = song;
        root.picker_query = "";
        root.picker_cursor = 0;
        root.filter_playlist_picker("");
        picker-list.viewport-y = 0px;
        root.picker_open = true;
        picker-input.focus();
    }

    function close-picker() {
        root.picker_open = false;
        keys.focus();
    }

    function pick-playlist(playlist-index: int) {
        root.add_to_playlist(root.picker_uri, playlist-index);
        root.close-picker();
    }

    function move-picker-cursor(delta: int) {
        if (root.picker_indices.length == 0) {
            return;
        }
        root.picker_cursor = max(0, min(root.picker_indices.length - 1, root.picker_cursor + delta));
        // Keep the highlighted row in view.
        if (root.picker_cursor * 56px + picker-list.viewport-y < 0px) {
            picker-list.viewport-y = -(root.picker_cursor * 56px);
        }
        if ((root.picker_cursor + 1) * 56px + picker-list.viewport-y > picker-list.visible-height) {
            picker-list.viewport-y = picker-list.visible-height - (root.picker_cursor + 1) * 56px;
        }
    }

    changed show_settings => {
        root.reset-armed = false;
        if (!root.show_settings && root.recording_shortcut != "") {
            root.record_shortcut("");
        }
        if (root.show_settings) {
            root.refresh_output_devices();
            root.measure_cover_cache();
        }
        keys.focus();
    }

    title: "Spotlight";
    // Linux draws no frame of its own around the window. The top bar is all there is.
    no-frame: root.is_linux;
    // The size the window opens at. Rust reads these to center it before it first shows.
    out property <length> opening-width: 1600px;
    out property <length> opening-height: 940px;
    preferred-width: self.opening-width;
    preferred-height: self.opening-height;
    min-width: 1100px;
    min-height: 640px;
    background: AppTheme.window-bg;
    default-font-family: "Geist";

    // The whole window takes on the album's color, fading into the base. Not behind the
    // setup guide, which is plain, so the top bar above it matches.
    Rectangle {
        background: AppTheme.flat || root.onboarding-shown ? AppTheme.window-bg : AppTheme.ambient;
        animate background { duration: AppTheme.reduce-motion ? 0ms : 450ms; easing: ease-in-out; }
    }
    Rectangle {
        // The mini player is short enough to keep its color all the way down.
        background: root.mini_mode
            ? @linear-gradient(180deg, AppTheme.window-bg.transparentize(0.55) 0%, AppTheme.window-bg.transparentize(0.25) 100%)
            : @linear-gradient(180deg, AppTheme.window-bg.transparentize(1) 0%, AppTheme.window-bg.transparentize(0.25) 45%, AppTheme.window-bg 90%);
    }

    keys := FocusScope {
        visible: !root.mini_mode;
        init => { self.focus(); }
        capture-key-pressed(event) => {
            if (root.new_playlist_open) {
                if (event.text == Key.Escape) {
                    root.close-new-playlist();
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.make-new-playlist();
                    return accept;
                }
                return reject;
            }
            if (root.picker_open) {
                if (event.text == Key.Escape) {
                    root.close-picker();
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.move-picker-cursor(1);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.move-picker-cursor(-1);
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (root.picker_indices.length > 0) {
                        root.pick-playlist(root.picker_indices[root.picker_cursor]);
                    }
                    return accept;
                }
                return reject;
            }
            if (event.modifiers.control && (event.text == "k" || event.text == "l")) {
                search-input.focus();
                return accept;
            }
            if (event.modifiers.control && event.text == "f") {
                if (!root.show_settings && root.signed_in) {
                    root.stage_open = false;
                    root.lyrics_open = false;
                    // Search results have no filter, so it refines the search instead.
                    if (root.search-page) {
                        search-input.focus();
                    } else {
                        filter-input.focus();
                    }
                }
                return accept;
            }
            if (event.modifiers.control && event.text == ",") {
                root.show_settings = !root.show_settings;
                return accept;
            }
            if (event.modifiers.control && event.text == Key.UpArrow) {
                root.nudge-volume(5);
                return accept;
            }
            if (event.modifiers.control && event.text == Key.DownArrow) {
                root.nudge-volume(-5);
                return accept;
            }
            return reject;
        }
        key-pressed(event) => {
            // Ctrl+Left/Right stay word navigation while typing in a text box.
            if (event.modifiers.control && event.text == Key.RightArrow) {
                root.next_track();
                return accept;
            }
            if (event.modifiers.control && event.text == Key.LeftArrow) {
                root.previous_track();
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.LeftArrow) {
                root.go-back();
                return accept;
            }
            if (event.text == " ") {
                root.play_pause();
                return accept;
            }
            if (event.text == "/") {
                search-input.focus();
                return accept;
            }
            if (root.show_settings && event.text != Key.Escape) {
                return reject;
            }
            if (event.text == Key.UpArrow) {
                root.move-selection(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-selection(1);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.move-selection(10);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.move-selection(-10);
                return accept;
            }
            if (event.text == Key.Return) {
                if (event.modifiers.shift && root.selected_liked_song_index >= 0 && root.selected_liked_song_index < root.track_rows.length - 1) {
                    root.track_context_action("play-next", root.track_rows[root.selected_liked_song_index].source-index);
                } else {
                    root.play-selected();
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.stage_open && !root.show_settings) {
                    root.close-stage();
                } else if (root.lyrics_open && !root.show_settings) {
                    root.lyrics_open = false;
                } else if (root.track_filter != "" && !root.show_settings) {
                    root.clear-filter();
                } else {
                    root.go-back();
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;

            // ── Top bar ───────────────────────────────────────────────
            Rectangle {
                height: 56px;
                cache-rendering-hint: AppTheme.can-cache;
                CacheAnchor { }

                // The bar's own controls lie over this, so they take their presses first.
                if root.is_mac : TouchArea {
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.drag_window();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: root.mac-buttons-shown ? 88px : 12px;
                    padding-right: root.is_mac ? 12px : 146px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;

                    Rectangle {
                        width: 112px;
                        Image {
                            x: 3px;
                            source: root.spotlight_logo;
                            width: 22px;
                            height: 22px;
                            image-fit: contain;
                        }
                        Text {
                            x: 32px;
                            text: "Spotlight";
                            color: AppTheme.text;
                            font-size: 14px;
                            font-weight: 600;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        width: 36px;
                        if root.caption-back : Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: back-touch.has-hover ? AppTheme.hover-bg : transparent;
                            Path {
                                commands: "M10 3 L5 8 L10 13";
                                viewbox-width: 16;
                                viewbox-height: 16;
                                width: 16px;
                                height: 16px;
                                fill: transparent;
                                stroke: AppTheme.secondary-text;
                                stroke-width: 1.8px;
                            }
                            back-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.go-back(); }
                            }
                        }
                    }

                    search-box := Rectangle {
                        horizontal-stretch: 3;
                        max-width: 520px;
                        min-width: 260px;
                        height: 40px;
                        // Scale lives on this inner layer: a transform on the box
                        // itself would distort its reported position.
                        Rectangle {
                            border-radius: 20px;
                            background: search-input.has-focus ? AppTheme.selected-bg : (search-hover.has-hover ? AppTheme.selected-bg : AppTheme.hover-bg);
                            animate background { duration: AppTheme.motion-duration; easing: ease-out; }
                            border-color: search-input.has-focus ? AppTheme.focus-ring : transparent;
                            border-width: 1px;
                            width: parent.width + (search-input.has-focus ? 10px : 0px);
                            height: parent.height + (search-input.has-focus ? 2px : 0px);
                            animate border-color { duration: AppTheme.motion-duration; easing: ease-out; }
                            animate width, height { duration: AppTheme.motion-spring; easing: ease-out; }
                        }

                        search-hover := TouchArea {
                            mouse-cursor: text;
                            clicked => { search-input.focus(); }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;

                            Rectangle {
                                width: 16px;
                                Image {
                                    source: root.search_icon;
                                    colorize: search-input.has-focus ? AppTheme.text : AppTheme.muted-text;
                                    width: 16px;
                                    height: 16px;
                                    image-fit: contain;
                                    transform-scale-x: search-input.has-focus ? 116% : 100%;
                                    transform-scale-y: search-input.has-focus ? 116% : 100%;
                                    animate colorize { duration: AppTheme.motion-duration; }
                                    animate transform-scale-x, transform-scale-y { duration: AppTheme.motion-spring; easing: ease-out; }
                                }
                            }

                            FocusScope {
                                horizontal-stretch: 1;
                                capture-key-pressed(event) => {
                                    if (event.text == Key.DownArrow && !event.modifiers.control) {
                                        root.search_highlight = Math.mod(root.search_highlight + 1, root.suggestion-count);
                                        return accept;
                                    }
                                    if (event.text == Key.UpArrow && !event.modifiers.control) {
                                        root.search_highlight = root.search_highlight <= 0 ? root.suggestion-count - 1 : root.search_highlight - 1;
                                        return accept;
                                    }
                                    if (event.text == Key.Escape) {
                                        root.search_query = "";
                                        root.search_highlight = -1;
                                        root.search_changed("");
                                        keys.focus();
                                        return accept;
                                    }
                                    return reject;
                                }

                                Rectangle {
                                    if root.search_query == "" : Text {
                                        x: 0px;
                                        width: parent.width;
                                        text: "Search songs or jump to a playlist   " + root.command-key + "K";
                                        color: AppTheme.muted-text;
                                        font-size: 14px;
                                        horizontal-alignment: left;
                                    }
                                    search-input := TextInput {
                                        x: 0px;
                                        width: parent.width;
                                        color: AppTheme.text;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        single-line: true;
                                        text <=> root.search_query;
                                        edited => {
                                            root.search_highlight = -1;
                                            root.search_changed(self.text);
                                        }
                                        accepted => { root.accept-suggestion(); }
                                    }
                                }
                            }
                        }
                    }

                    settings-button := Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: root.show_settings || settings-touch.has-hover ? AppTheme.selected-bg : AppTheme.hover-bg;
                        animate background { duration: AppTheme.motion-duration; easing: ease-out; }
                        Image {
                            source: root.settings_icon;
                            colorize: root.show_settings || settings-touch.has-hover ? AppTheme.text : AppTheme.subtle-text;
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                            transform-rotation: root.show_settings ? 90deg : (settings-touch.has-hover ? 45deg : 0deg);
                            transform-scale-x: settings-touch.pressed ? 88% : 100%;
                            transform-scale-y: settings-touch.pressed ? 88% : 100%;
                            animate colorize { duration: AppTheme.motion-duration; easing: ease-out; }
                            animate transform-rotation { duration: AppTheme.reduce-motion ? 0ms : 360ms; easing: ease-out; }
                            animate transform-scale-x, transform-scale-y { duration: AppTheme.motion-spring; easing: ease-out; }
                        }
                        // A new version is out: the update waits at the top of Settings.
                        if root.update_version != "" : Rectangle {
                            x: parent.width - 13px;
                            y: 5px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: AppTheme.accent;
                        }
                        settings-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show_settings = !root.show_settings; }
                        }
                    }

                    // Quiet, and only while it lasts, so the app doesn't look stuck.
                    if root.sync_trouble != "" && root.signed_in : Rectangle {
                        width: trouble-text.preferred-width + 34px;
                        height: 28px;
                        border-radius: 14px;
                        background: AppTheme.text.with-alpha(0.05);
                        Rectangle {
                            x: 13px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: AppTheme.warning;
                        }
                        trouble-text := Text {
                            x: 25px;
                            text: root.sync_trouble;
                            color: AppTheme.secondary-text;
                            font-size: 12px;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if root.top-connect-shown : Rectangle {
                        width: 150px;
                        TextButton {
                            text: "Connect Spotify";
                            primary: true;
                            button-width: 140px;
                            enabled: root.client_id != "";
                            clicked => { root.connect_spotify(); }
                        }
                    }
                }

                if !root.is_mac : CaptionButton {
                    x: parent.width - 138px;
                    y: 0px;
                    commands: "M1 6 L11 6";
                    clicked => { root.minimize_window(); }
                }
                if !root.is_mac : CaptionButton {
                    x: parent.width - 92px;
                    y: 0px;
                    commands: root.window_maximized
                        ? "M1 3 L9 3 L9 11 L1 11 Z M3 3 L3 1 L11 1 L11 9 L9 9"
                        : "M1 1 L11 1 L11 11 L1 11 Z";
                    handles-input: false;
                    external-hover: root.caption_max_hover;
                    external-pressed: root.caption_max_pressed;
                }
                if !root.is_mac : CaptionButton {
                    x: parent.width - 46px;
                    y: 0px;
                    danger: true;
                    commands: "M1 1 L11 11 M11 1 L1 11";
                    clicked => { root.close_window(); }
                }
            }

            // ── Body ──────────────────────────────────────────────────
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;
                padding-left: 8px;
                padding-right: 8px;

                // Library
                Rectangle {
                    width: root.library-target;
                    clip: true;
                    animate width { duration: root.sides-dragging ? 0ms : AppTheme.motion-slow; easing: ease-in-out; }
                    // Everything in it changes while it moves, so a picture of it would be no help.
                    cache-rendering-hint: AppTheme.can-cache && !root.library-moving && !root.sides-dragging;
                    CacheAnchor { }

                    VerticalLayout {
                        padding-top: 14px;
                        spacing: 6px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            home-nav := Rectangle {
                                height: 42px;
                                border-radius: 8px;
                                GlassHover { strength: root.show_home ? 1.1 : 0.8; lit: root.show_home || home-nav-touch.has-hover; }
                                Path {
                                    x: root.compact_sidebars ? 21px : 16px;
                                    animate x { duration: AppTheme.motion-slow; easing: ease-in-out; }
                                    width: 18px;
                                    height: 18px;
                                    commands: "M2 8.2 L9 2 L16 8.2 L16 16 L11 16 L11 11 L7 11 L7 16 L2 16 Z";
                                    viewbox-width: 18;
                                    viewbox-height: 18;
                                    fill: root.show_home ? AppTheme.text : AppTheme.secondary-text;
                                }
                                Text {
                                    x: 46px + self.nudge;
                                    width: 80px;
                                    opacity: root.library-words > 0.01 ? root.library-words : 1;
                                    visible: root.library-words > 0.01;
                                    property <length> nudge: home-nav-touch.has-hover ? 2px : 0px;
                                    animate nudge { duration: AppTheme.motion-spring; easing: ease-out; }
                                    text: "Home";
                                    color: root.show_home ? AppTheme.text : AppTheme.secondary-text;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                home-nav-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.open-home();
                                        keys.focus();
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Rectangle {
                                height: 42px;
                                border-radius: 8px;
                                property <bool> open: root.history-open;
                                GlassHover { strength: parent.open ? 1.1 : 0.8; lit: parent.open || history-nav-touch.has-hover; }
                                // A clock.
                                Path {
                                    x: root.compact_sidebars ? 21px : 16px;
                                    animate x { duration: AppTheme.motion-slow; easing: ease-in-out; }
                                    width: 18px;
                                    height: 18px;
                                    commands: "M9 2.25 A6.75 6.75 0 1 1 8.99 2.25 Z M9 5.5 L9 9 L11.6 10.6";
                                    viewbox-width: 18;
                                    viewbox-height: 18;
                                    fill: transparent;
                                    stroke: parent.open ? AppTheme.text : AppTheme.secondary-text;
                                    stroke-width: 1.6px;
                                }
                                Text {
                                    x: 46px + self.nudge;
                                    width: 160px;
                                    opacity: root.library-words > 0.01 ? root.library-words : 1;
                                    visible: root.library-words > 0.01;
                                    property <length> nudge: history-nav-touch.has-hover ? 2px : 0px;
                                    animate nudge { duration: AppTheme.motion-spring; easing: ease-out; }
                                    text: "Recently played";
                                    color: parent.open ? AppTheme.text : AppTheme.secondary-text;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                history-nav-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-history();
                                        keys.focus();
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 30px;
                            Text {
                                x: 18px;
                                width: 180px;
                                opacity: root.library-words > 0.01 ? root.library-words : 1;
                                visible: root.library-words > 0.01;
                                text: "Your Library";
                                color: AppTheme.text;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            if root.library-words > 0.01 : IconButton {
                                x: parent.width - 108px;
                                y: 0px;
                                width: 30px;
                                height: 30px;
                                opacity: root.library-words;
                                icon: root.plus_icon;
                                icon-size: 16px;
                                clicked => { root.open-new-playlist(""); }
                            }
                            if root.library-words > 0.01 : IconButton {
                                x: parent.width - 74px;
                                y: 0px;
                                width: 30px;
                                height: 30px;
                                opacity: root.library-words;
                                icon: root.refresh_icon;
                                icon-size: 14px;
                                clicked => { root.refresh_library(); }
                            }
                            // Stays at the column's edge as it moves, and ends up over the covers.
                            LibrarySizeButton {
                                property <length> inset: root.compact_sidebars ? 23px : 14px;
                                animate inset { duration: AppTheme.motion-slow; easing: ease-in-out; }
                                x: parent.width - self.inset - self.width;
                                clicked => {
                                    root.compact_sidebars = !root.compact_sidebars;
                                    root.save_library_size();
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;

                            library-scroll := ScrollView {
                                // Whole pixels by any route: wheel, touchpad, scrollbar. Cached rows blur between pixels.
                                changed viewport-y => { self.viewport-y = round(self.viewport-y / 1phx) * 1phx; }
                                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                viewport-width: self.visible-width;

                                VerticalLayout {
                                    x: 0px;
                                    width: library-scroll.visible-width;
                                    alignment: start;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-bottom: 100px;

                                    for title[index] in root.playlist_titles : Rectangle {
                                        height: 54px;
                                        // Slint draws cached items even out of view, and a hidden row would still cost a clip,
                                        // so a row out of view holds nothing.
                                        if (index + 1) * 54px + library-scroll.viewport-y > 0px && index * 54px + library-scroll.viewport-y < library-scroll.visible-height : library-row := Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            width: parent.width;
                                            height: parent.height;
                                            property <bool> chosen: root.selected_playlist_index == index && !root.show_settings;
                                            border-radius: 8px;
                                            // The glass narrows with the column. What's on it keeps its full
                                            // width and is cut off at the edge, so the words stay still.
                                            GlassHover { strength: library-row.chosen ? 1.1 : 0.8; lit: library-row.chosen || playlist-hover.has-hover; }

                                            playlist-hover := TouchArea {
                                                changed has-hover => { root.library-row-hover(index, self.has-hover, self.absolute-position.y); }
                                                clicked => {
                                                    root.open-playlist(index);
                                                    keys.focus();
                                                }
                                                double-clicked => {
                                                    root.open-playlist(index);
                                                    root.activate_playlist(index);
                                                }

                                                Rectangle {
                                                    x: 0px;
                                                    width: root.library_width - 16px;
                                                    cache-rendering-hint: AppTheme.can-cache;
                                                    PlaylistRowContent {
                                                        art: root.playlist_images[index];
                                                        title: title;
                                                        subtitle: root.playlist_subtitles[index];
                                                        hovered: playlist-hover.has-hover;
                                                        emphasized: library-row.chosen;
                                                        lead: library-row.lead;
                                                        words: root.library-words;
                                                    }
                                                }
                                            }

                                            property <length> lead: playlist-hover.has-hover && !root.compact_sidebars ? 10px : 8px;
                                            animate lead { duration: AppTheme.motion-spring; easing: ease-out; }
                                        }
                                    }
                                    // The library has more playlists than are loaded.
                                    if root.more_playlists : Rectangle {
                                        height: 52px;
                                        TextButton {
                                            x: (parent.width - self.width) / 2;
                                            text: root.more_playlists_busy ? (root.compact_sidebars ? "…" : "Loading…") : (root.compact_sidebars ? "More" : "Load more playlists");
                                            button-width: min(parent.width - 8px, 172px);
                                            enabled: !root.more_playlists_busy;
                                            clicked => { root.load_more_playlists(); }
                                        }
                                    }
                                }
                            }

                            OverlayScrollBar {

                                x: parent.width - self.width;

                                y: 0px;

                                height: parent.height;
                                viewport-y: library-scroll.viewport-y;
                                viewport-height: library-scroll.viewport-height;
                                visible-height: library-scroll.visible-height;
                                scroll-to(y) => { library-scroll.viewport-y = y; }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 8px;
                    if !root.compact_sidebars : SideGrip {
                        height: parent.height;
                        dragged(dx) => {
                            root.sides-dragging = true;
                            root.library_width = round(max(240px, min(root.library-limit(), root.library_width + dx)) / 1px) * 1px;
                        }
                        dropped => { root.sides-dropped(); }
                        reset => {
                            root.library_width = 272px;
                            root.save_library_size();
                        }
                    }
                }

                // Main
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    // Signed out
                    if !root.signed_in : VerticalLayout {
                        alignment: center;
                        spacing: 14px;
                        padding: 40px;

                        Image {
                            source: root.spotlight_logo;
                            height: 72px;
                            image-fit: contain;
                        }
                        Text {
                            text: "Connect your Spotify account";
                            color: AppTheme.text;
                            font-size: 24px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.client_id == ""
                                ? "Add your Spotify app Client ID in Settings first."
                                : "Spotlight signs in through your browser. Nothing plays until you press play.";
                            color: AppTheme.subtle-text;
                            font-size: 14px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            TextButton {
                                text: "Connect Spotify";
                                primary: true;
                                button-width: 160px;
                                enabled: root.client_id != "";
                                clicked => { root.connect_spotify(); }
                            }
                            if root.client_id == "" : TextButton {
                                text: "Set up";
                                button-width: 130px;
                                clicked => { root.onboarding_step = 1; }
                            }
                        }
                    }

                    // Home
                    Rectangle {
                        property <float> fade: root.stage_open || root.lyrics_open ? 0 : 1;
                        animate fade { duration: AppTheme.motion-spring; easing: ease-out; }
                        visible: root.signed_in && root.show_home && self.fade > 0.01;
                        opacity: self.fade > 0.01 ? self.fade : 1;

                        VerticalLayout {
                            spacing: 0px;

                            Rectangle {
                                height: 62px;
                                Rectangle {
                                    y: root.rise(root.page-in);
                                    opacity: root.page-in;
                                    HorizontalLayout {
                                        padding-left: 24px;
                                        padding-right: 18px;
                                        alignment: stretch;
                                        Text {
                                            text: "Home";
                                            color: AppTheme.text;
                                            font-size: 26px;
                                            font-weight: 700;
                                            letter-spacing: -0.3px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                icon: root.refresh_icon;
                                                icon-size: 16px;
                                                icon-rotation: root.home-spin;
                                                clicked => { root.refresh_home(); }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;

                                home-list := ListView {
                                    changed viewport-y => { self.viewport-y = round(self.viewport-y / 1phx) * 1phx; }
                                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                                    for section[si] in root.home_sections : home-row := Rectangle {
                                        // The first picture in every row lines up with the page's title.
                                        property <length> left: section.tiles ? 18px : 16px;
                                        property <length> gap: section.tiles ? 8px : 10px;
                                        property <int> cols: section.tiles ? root.home-tile-cols : root.home-card-cols;
                                        property <length> cell: section.tiles ? root.home-tile-cell : root.home-card-cell;
                                        property <length> cell-shown: section.tiles ? root.home-tile-cell-shown : root.home-card-cell-shown;
                                        property <int> shown: section.tiles ? min(section.cards.length, 8) : (section.expanded ? section.cards.length : min(section.cards.length, self.cols));
                                        // With those that slide in and out at the edge as the panel moves.
                                        // Their pictures are kept ready, so they arrive with them.
                                        property <int> sliding: section.tiles ? self.shown : max(self.shown, min(section.cards.length, root.home-card-cols-wide));
                                        property <int> rows: ceil(self.shown / self.cols);
                                        property <length> cell-height: section.tiles ? 56px : self.cell + 56px;
                                        property <length> step: self.cell-height + self.gap;
                                        property <length> step-shown: (section.tiles ? 56px : self.cell-shown + 56px) + self.gap;
                                        property <length> top: section.tiles ? 0px : 46px;
                                        // The list reuses rows as it scrolls.
                                        property <string> wanted: si + "/" + self.sliding;
                                        init => { root.home_section_shown(si, self.sliding); }
                                        changed wanted => { root.home_section_shown(si, self.sliding); }

                                        height: section.cards.length == 0 ? 104px : self.top + self.rows * self.step + 6px;
                                        // Only when opening or closing, or moving with the panel, so resizing the
                                        // window stays immediate.
                                        clip: root.home-resizing;
                                        animate height { duration: root.home-resizing ? 300ms : (root.panel-moving ? AppTheme.motion-slow : 0ms); easing: ease-in-out; }

                                        if !section.tiles && section.cards.length > 0 : Rectangle {
                                            x: 24px;
                                            y: 12px + root.rise(self.reach);
                                            width: root.home-cards-span - 90px;
                                            height: 28px;
                                            property <float> reach: root.arrive(root.rows-in, si * 2);
                                            opacity: self.reach;
                                            Rectangle {
                                                cache-rendering-hint: AppTheme.can-cache;
                                                CacheAnchor { }
                                                Text {
                                                    x: 0px;
                                                    y: 0px;
                                                    width: parent.width;
                                                    text: section.title;
                                                    color: AppTheme.text;
                                                    font-size: 20px;
                                                    font-weight: 700;
                                                    letter-spacing: -0.2px;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                        if !section.tiles && section.cards.length > home-row.cols : Rectangle {
                                            x: home-list.visible-width - 24px - self.width;
                                            y: 16px;
                                            // Whole pixels, so the cached words are sharp at rest.
                                            width: ceil(show-all-label.preferred-width / 1phx) * 1phx + 8px;
                                            height: 20px;
                                            property <float> reach: root.arrive(root.rows-in, si * 2);
                                            opacity: self.reach;
                                            Rectangle {
                                                cache-rendering-hint: AppTheme.can-cache;
                                                CacheAnchor { }
                                                show-all-label := Text {
                                                    text: section.expanded ? "Show less" : "Show all";
                                                    color: show-all-touch.has-hover ? AppTheme.text : AppTheme.secondary-text;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    horizontal-alignment: right;
                                                    animate color { duration: AppTheme.motion-duration; easing: ease-out; }
                                                }
                                            }
                                            show-all-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.toggle-home-section(si); }
                                            }
                                        }

                                        for card[ci] in section.cards : home-cell := Rectangle {
                                            property <float> reach: root.arrive(root.rows-in, si * 2 + ci);
                                            // A card past the end of the row stays on it, off to the side. In an
                                            // opened row, cards move to their new places as the columns change.
                                            property <bool> past-end: ci >= home-row.shown;
                                            property <float> column: self.past-end ? ci : mod(ci, home-row.cols);
                                            property <float> line: self.past-end ? 0 : floor(ci / home-row.cols);
                                            animate column, line { duration: root.panel-moving ? AppTheme.motion-slow : 0ms; easing: ease-in-out; }
                                            property <bool> in-row: !self.past-end || (root.panel-moving && ci < home-row.sliding);
                                            x: home-row.left + self.column * (home-row.cell-shown + home-row.gap);
                                            y: home-row.top + self.line * home-row.step-shown + root.rise(self.reach);
                                            width: home-row.cell;
                                            height: home-row.cell-height;
                                            opacity: self.reach;

                                            if section.tiles && home-cell.in-row : HomeTileView {
                                                card: card;
                                                shown-width: home-row.cell-shown;
                                                open => { root.leave-for-detail(); root.open_home_card(si, ci); keys.focus(); }
                                                play => { root.play_home_card(si, ci); keys.focus(); }
                                            }
                                            if !section.tiles && home-cell.in-row : HomeCardView {
                                                card: card;
                                                art-scale: (home-row.cell-shown - 16px) / (home-row.cell - 16px);
                                                words-width: root.home-words-cell - 16px;
                                                words-fade: root.home-words-fade;
                                                open => { root.leave-for-detail(); root.open_home_card(si, ci); keys.focus(); }
                                                play => { root.play_home_card(si, ci); keys.focus(); }
                                            }
                                        }
                                    }
                                }

                                OverlayScrollBar {
                                    x: parent.width - self.width;
                                    y: 0px;
                                    height: parent.height;
                                    viewport-y: home-list.viewport-y;
                                    viewport-height: home-list.viewport-height;
                                    visible-height: home-list.visible-height;
                                    scroll-to(y) => { home-list.viewport-y = y; }
                                }

                                // The page's shape while it loads: shortcuts, then a row of cards.
                                if root.home_sections.length == 0 && root.home_error == "" : home-bones := LoadingShade {
                                    paused: root.window_hidden;
                                    property <int> tile-cols: root.home-tile-cols;
                                    property <length> tile-width: root.home-tile-cell;
                                    property <length> tiles-height: ceil(8 / self.tile-cols) * 64px;
                                    property <int> card-cols: root.home-card-cols;
                                    property <length> card-width: root.home-card-cell;

                                    for tile[i] in 8 : Bone {
                                        x: 18px + mod(i, home-bones.tile-cols) * (home-bones.tile-width + 8px);
                                        y: floor(i / home-bones.tile-cols) * 64px;
                                        width: home-bones.tile-width;
                                        height: 56px;
                                        border-radius: 8px;
                                    }
                                    Bone {
                                        x: 24px;
                                        y: home-bones.tiles-height + 14px;
                                        width: 180px;
                                        height: 18px;
                                    }
                                    for card[i] in home-bones.card-cols * 2 : Rectangle {
                                        x: 16px + mod(i, home-bones.card-cols) * (home-bones.card-width + 10px);
                                        y: home-bones.tiles-height + 46px + floor(i / home-bones.card-cols) * (home-bones.card-width + 66px);
                                        width: home-bones.card-width;
                                        height: home-bones.card-width + 56px;
                                        Bone { x: 8px; y: 8px; width: parent.width - 16px; height: parent.width - 16px; border-radius: 8px; }
                                        Bone { x: 8px; y: parent.width + 8px; width: (parent.width - 16px) * 0.7; height: 12px; }
                                        Bone { x: 8px; y: parent.width + 27px; width: (parent.width - 16px) * 0.9; height: 10px; }
                                    }
                                }

                                if root.home_sections.length == 0 && root.home_error != "" : VerticalLayout {
                                    alignment: center;
                                    spacing: 12px;
                                    Text {
                                        text: root.home_error;
                                        color: AppTheme.text;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                    if !root.home_loading : HorizontalLayout {
                                        alignment: center;
                                        TextButton {
                                            text: "Try again";
                                            button-width: 110px;
                                            clicked => { root.refresh_home(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Track view
                    Rectangle {
                      property <float> fade: root.stage_open || root.lyrics_open ? 0 : 1;
                      animate fade { duration: AppTheme.motion-spring; easing: ease-out; }
                      visible: root.signed_in && !root.show_home && self.fade > 0.01;
                      opacity: self.fade > 0.01 ? self.fade : 1;
                      VerticalLayout {
                        spacing: 0px;

                        // Hero
                        Rectangle {
                            height: root.search-page ? 0px : 150px;
                            visible: !root.search-page;
                            Rectangle {
                            y: root.rise(root.page-in);
                            opacity: root.page-in;
                            Rectangle {
                            cache-rendering-hint: AppTheme.can-cache;
                            CacheAnchor { }

                            HorizontalLayout {
                                padding-left: 24px;
                                padding-right: 24px;
                                padding-top: 22px;
                                padding-bottom: 8px;
                                spacing: 20px;

                                Rectangle {
                                    width: 120px;
                                    if !root.in-search : RoundedArtwork {
                                        source: root.playlist_images[root.selected_playlist_index];
                                        artwork-size: 120px;
                                        radius: 10px;
                                        zoom: hero-touch.has-hover;
                                        drop-shadow-blur: 24px;
                                        drop-shadow-offset-y: 8px;
                                        drop-shadow-color: #00000070;
                                    }
                                    hero-touch := TouchArea { }
                                    if root.in-search : Rectangle {
                                        width: 120px;
                                        height: 120px;
                                        border-radius: root.track_view_kicker == "Artist" ? 60px : 10px;
                                        background: AppTheme.active-bg;
                                        // Only search has nothing of its own to show here.
                                        Image {
                                            visible: root.track_view_kicker == "Search results";
                                            source: root.search_icon;
                                            colorize: AppTheme.secondary-text;
                                            width: 38px;
                                            height: 38px;
                                            image-fit: contain;
                                        }
                                        // Albums show their cover, artists their photo.
                                        if root.track_view_kicker == "Album" && root.track_rows.length > 1 && root.track_rows[0].has-art : CrossfadeArt {
                                            source: root.track_rows[0].art;
                                            artwork-size: 120px;
                                            radius: 10px;
                                        }
                                        if root.track_view_has_art && root.track_view_kicker != "Search results" : CrossfadeArt {
                                            source: root.track_view_art;
                                            artwork-size: 120px;
                                            radius: root.track_view_kicker == "Artist" ? 60px : 10px;
                                        }
                                        if root.track_view_kicker == "History" : CrossfadeArt {
                                            source: root.history_art;
                                            artwork-size: 120px;
                                            radius: 10px;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 0px;
                                    horizontal-stretch: 1;
                                    preferred-width: 0px;
                                    min-width: 0px;
                                    Text {
                                        text: root.in-search ? root.track_view_kicker : "Playlist";
                                        color: AppTheme.secondary-text;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.track_view_title;
                                        color: AppTheme.text;
                                        font-size: 38px;
                                        font-weight: 700;
                                        letter-spacing: -0.6px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.track_view_loading ? "Loading…" : root.track_view_meta;
                                        color: AppTheme.secondary-text;
                                        font-size: 13px;
                                    }
                                }
                            }
                            }
                            }
                        }

                        // Toolbar. On search results, only a little room under the top bar.
                        Rectangle {
                            height: root.search-page ? 14px : 56px;
                            Rectangle {
                            visible: !root.search-page;
                            y: root.rise(root.page-in);
                            opacity: root.page-in;
                            HorizontalLayout {
                                padding-left: 24px;
                                padding-right: 24px;
                                spacing: 12px;

                                Rectangle {
                                    width: play-pill-label.preferred-width + 52px;
                                    property <length> pill-grow: play-pill.pressed ? -3px : (play-pill.has-hover ? 4px : 0px);
                                    animate pill-grow { duration: AppTheme.motion-spring; easing: ease-out; }
                                    Rectangle {
                                        width: parent.width + parent.pill-grow;
                                        height: 38px + parent.pill-grow;
                                        border-radius: self.height / 2;
                                        background: play-pill.pressed ? AppTheme.accent.darker(0.15) : (play-pill.has-hover ? AppTheme.accent.brighter(0.1) : AppTheme.accent);
                                        animate background { duration: AppTheme.motion-duration; easing: ease-out; }
                                    }
                                    Image {
                                        x: 16px;
                                        source: root.play_icon;
                                        colorize: AppTheme.on-accent;
                                        width: 13px;
                                        height: 13px;
                                        image-fit: contain;
                                    }
                                    play-pill-label := Text {
                                        x: 36px;
                                        text: "Play";
                                        color: AppTheme.on-accent;
                                        font-size: 14px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    play-pill := TouchArea {
                                        height: 38px;
                                        mouse-cursor: pointer;
                                        clicked => { root.play-view(); }
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                Rectangle {
                                    width: 240px;
                                    filter-box := Rectangle {
                                        height: 34px;
                                        Rectangle {
                                            border-radius: 17px;
                                            background: filter-input.has-focus || root.track_filter != "" || filter-hover.has-hover ? AppTheme.selected-bg : AppTheme.hover-bg;
                                            animate background { duration: AppTheme.motion-duration; easing: ease-out; }
                                            border-color: filter-input.has-focus ? AppTheme.focus-ring : transparent;
                                            border-width: 1px;
                                            width: parent.width + (filter-input.has-focus ? 8px : 0px);
                                            height: parent.height + (filter-input.has-focus ? 2px : 0px);
                                            animate border-color { duration: AppTheme.motion-duration; easing: ease-out; }
                                            animate width, height { duration: AppTheme.motion-spring; easing: ease-out; }
                                        }

                                        filter-hover := TouchArea {
                                            mouse-cursor: text;
                                            clicked => { filter-input.focus(); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 6px;
                                            spacing: 8px;
                                            Rectangle {
                                                width: 14px;
                                                Image {
                                                    source: root.search_icon;
                                                    colorize: filter-input.has-focus ? AppTheme.text : AppTheme.subtle-text;
                                                    width: 13px;
                                                    height: 13px;
                                                    image-fit: contain;
                                                    transform-scale-x: filter-input.has-focus ? 116% : 100%;
                                                    transform-scale-y: filter-input.has-focus ? 116% : 100%;
                                                    animate colorize { duration: AppTheme.motion-duration; }
                                                    animate transform-scale-x, transform-scale-y { duration: AppTheme.motion-spring; easing: ease-out; }
                                                }
                                            }
                                            FocusScope {
                                                horizontal-stretch: 1;
                                                capture-key-pressed(event) => {
                                                    if (event.text == Key.DownArrow && !event.modifiers.control) {
                                                        keys.focus();
                                                        root.move-selection(1);
                                                        return accept;
                                                    }
                                                    if (event.text == Key.Escape) {
                                                        root.clear-filter();
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                                if root.track_filter == "" : Text {
                                                    x: 0px;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    vertical-alignment: center;
                                                    text: "Filter   " + root.command-key + "F";
                                                    color: AppTheme.subtle-text;
                                                    font-size: 13px;
                                                    horizontal-alignment: left;
                                                }
                                                filter-input := TextInput {
                                                    x: 0px;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    color: AppTheme.text;
                                                    font-size: 13px;
                                                    vertical-alignment: center;
                                                    single-line: true;
                                                    text <=> root.track_filter;
                                                    edited => {
                                                        root.selected_liked_song_index = -1;
                                                        root.filter_tracks(self.text);
                                                        root.scroll-tracks-top();
                                                    }
                                                    accepted => {
                                                        root.selected_liked_song_index = 0;
                                                        root.scroll-tracks-top();
                                                        keys.focus();
                                                    }
                                                }
                                            }
                                            if root.track_filter != "" : Rectangle {
                                                width: 22px;
                                                QueueGlyph {
                                                    width: 22px;
                                                    height: 22px;
                                                    clicked => { root.clear-filter(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            }
                        }

                        // Column header
                        Rectangle {
                            height: 32px;
                            Rectangle {
                            opacity: root.page-in;
                            Rectangle {
                            cache-rendering-hint: AppTheme.can-cache;
                            CacheAnchor { }
                            HorizontalLayout {
                                x: 18px;
                                width: parent.width - 28px;
                                padding-left: 10px;
                                padding-right: 16px;
                                spacing: 12px;
                                Rectangle { width: 30px; Text { text: "#"; color: AppTheme.muted-text; font-size: 12px; } }
                                Rectangle { width: 40px; }
                                Rectangle {
                                    horizontal-stretch: 5;
                                    preferred-width: 0px;
                                    min-width: 0px;
                                    Text { x: 0px; width: parent.width; text: "Title"; color: AppTheme.muted-text; font-size: 12px; horizontal-alignment: left; }
                                }
                                if root.tracks_have_album : Rectangle {
                                    horizontal-stretch: 3;
                                    preferred-width: 0px;
                                    min-width: 0px;
                                    Text { x: 0px; width: parent.width; text: "Album"; color: AppTheme.muted-text; font-size: 12px; horizontal-alignment: left; }
                                }
                                Rectangle {
                                    width: 48px;
                                    Text { x: 0px; width: parent.width; text: "Time"; color: AppTheme.muted-text; font-size: 12px; horizontal-alignment: right; }
                                }
                                Rectangle { width: 26px; }
                            }
                            Divider {
                                x: 28px;
                                y: parent.height - 1px;
                                width: parent.width - 56px;
                                height: 1px;
                            }
                            }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;

                            track-list := ListView {
                                changed viewport-y => { self.viewport-y = round(self.viewport-y / 1phx) * 1phx; }
                                visible: !root.track_view_loading;
                                x: 18px;
                                width: parent.width - 28px;
                                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                // The final row is empty space, so the last song
                                // can scroll clear of the floating player bar.
                                for row[index] in root.track_rows : Rectangle {
                                  height: row.source-index < 0 ? 104px : 48px;
                                  if row.source-index < 0 && root.track_view_more : TextButton {
                                    x: (parent.width - self.width) / 2;
                                    y: 14px;
                                    text: root.track_view_more_busy ? "Loading…" : "Load more songs";
                                    button-width: 156px;
                                    enabled: !root.track_view_more_busy;
                                    clicked => { root.load_more_tracks(); }
                                  }
                                  if row.source-index >= 0 : Rectangle {
                                  property <float> reach: root.arrive(root.rows-in, index);
                                  y: root.rise(self.reach);
                                  opacity: self.reach;
                                  TrackRow {
                                    item: row;
                                    playing: root.current_track_uri != "" && row.uri == root.current_track_uri;
                                    paused: !root.is_playing;
                                    unseen: root.window_hidden || root.mini_mode || root.show_home || root.stage_open || root.lyrics_open;
                                    selected: root.selected_liked_song_index == index;
                                    show-album: root.tracks_have_album;
                                    playing-icon: root.volume_icon;
                                    placeholder-icon: root.playlist_icon;
                                    select => {
                                        root.selected_liked_song_index = index;
                                        keys.focus();
                                    }
                                    play => {
                                        root.selected_liked_song_index = index;
                                        root.activate_liked_song(row.source-index);
                                        keys.focus();
                                    }
                                    context(x, y) => {
                                        root.track_context_index = row.source-index;
                                        root.track_context_uri = row.uri;
                                        root.track_context_title = row.title;
                                        root.track_context_popup_x = min(x, root.width - 228px);
                                        root.track_context_popup_y = y;
                                        root.track_menu_opened(row.source-index);
                                        track-menu.show();
                                    }
                                  }
                                  }
                                }
                            }

                            OverlayScrollBar {

                                x: parent.width - self.width;

                                y: 0px;

                                height: parent.height;
                                viewport-y: track-list.viewport-y;
                                viewport-height: track-list.viewport-height;
                                visible-height: track-list.visible-height;
                                scroll-to(y) => { track-list.viewport-y = y; }
                            }

                            // The list's shape while it loads.
                            if root.track_view_loading : LoadingShade {
                                paused: root.window_hidden;
                                x: 18px;
                                width: parent.width - 28px;
                                for bone[i] in 12 : Rectangle {
                                    y: i * 48px;
                                    height: 48px;
                                    property <float> vary: mod(i * 7, 5) * 0.04;
                                    Bone { x: 14px; width: 14px; height: 10px; }
                                    Bone { x: 52px; width: 38px; height: 38px; }
                                    Bone { x: 102px; y: 13px; width: (parent.width - 240px) * (0.2 + parent.vary); height: 11px; }
                                    Bone { x: 102px; y: 29px; width: (parent.width - 240px) * (0.12 + parent.vary); height: 9px; }
                                    if root.tracks_have_album : Bone { x: 102px + (parent.width - 240px) * 0.62; width: (parent.width - 240px) * (0.14 + parent.vary); height: 10px; }
                                    Bone { x: parent.width - 86px; width: 30px; height: 10px; }
                                }
                            }

                            if root.track_rows.length == 0 && !root.track_view_loading : VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: root.track_filter != "" ? "No matches for “" + root.track_filter + "”" : (root.history-open ? "Nothing played yet" : (root.in-search ? "No results" : "Nothing here yet"));
                                    color: AppTheme.text;
                                    font-size: 16px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.track_filter != "" ? "Press Esc to clear the filter." : (root.track_view_more ? "The rest of the list isn't loaded yet." : (root.history-open ? "Songs you play show up here." : (root.in-search ? "Try a different search." : "Refresh your library from the sidebar.")));
                                    color: AppTheme.muted-text;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }
                                // Only part of the list is loaded, and none of it is shown.
                                if root.track_view_more : HorizontalLayout {
                                    alignment: center;
                                    padding-top: 8px;
                                    TextButton {
                                        text: root.track_view_more_busy ? "Loading…" : "Load more songs";
                                        button-width: 156px;
                                        enabled: !root.track_view_more_busy;
                                        clicked => { root.load_more_tracks(); }
                                    }
                                }
                            }
                        }
                    }

                    }

                    // Stage: the current song, large, in place of the list.
                    stage := Rectangle {
                        property <float> fade: root.stage_open ? 1 : 0;
                        animate fade { duration: AppTheme.motion-slow; easing: ease-out; }
                        visible: self.fade > 0.01;
                        opacity: self.fade > 0.01 ? self.fade : 1;

                        property <length> art-size: max(200px, min(min(self.width - 96px, self.height - 200px - 70px), 620px));
                        property <length> shown-size: root.stage_open ? self.art-size : self.art-size * 0.88;
                        animate shown-size { duration: AppTheme.reduce-motion ? 0ms : 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                        // Eases in and out over 14 seconds while the stage is open and music plays.
                        // Moves about a fifth of a pixel a step, so 15 steps a second looks the same as
                        // a declared animation, which would redraw at the full frame rate for as long
                        // as the stage stayed open.
                        property <float> drift-phase: 0;
                        property <float> drift-way: 1;
                        property <float> drift: 1 + 0.08 * self.drift-phase * self.drift-phase * (3 - 2 * self.drift-phase);
                        Timer {
                            interval: 66ms;
                            running: root.stage_open && root.is_playing && !AppTheme.reduce-motion && !root.window_hidden;
                            triggered => {
                                stage.drift-phase = max(0, min(1, stage.drift-phase + stage.drift-way * 0.066 / 14));
                                if (stage.drift-phase >= 1) { stage.drift-way = -1; }
                                if (stage.drift-phase <= 0) { stage.drift-way = 1; }
                                if (stage.show-tilt) { root.stage_tilt_redraw(); }
                            }
                        }

                        // The cover leans away from the pointer, as if pressed where it points:
                        // from -1 at the left or top edge to 1 at the right or bottom.
                        property <bool> tilt-on: root.has-track && !AppTheme.reduce-motion && cover-touch.has-hover;
                        property <float> tilt-x: self.tilt-on ? max(-1, min(1, cover-touch.mouse-x / max(1px, cover-touch.width) * 2 - 1)) : 0;
                        property <float> tilt-y: self.tilt-on ? max(-1, min(1, cover-touch.mouse-y / max(1px, cover-touch.height) * 2 - 1)) : 0;
                        // Follows the pointer closely, and settles back slowly once it leaves.
                        animate tilt-x, tilt-y {
                            duration: stage.tilt-on ? 150ms : 650ms;
                            easing: stage.tilt-on ? ease-out : cubic-bezier(0.22, 1, 0.36, 1);
                        }
                        property <bool> tilted: self.tilt-on || abs(self.tilt-x) > 0.002 || abs(self.tilt-y) > 0.002;
                        property <bool> show-tilt: self.tilted && root.stage_tilt_ready;
                        // Room around the cover for the corner that comes forward.
                        property <length> tilt-canvas: self.art-size * 1.2;
                        changed visible => {
                            if (!self.visible) {
                                self.drift-phase = 0;
                                self.drift-way = 1;
                            }
                        }

                        TouchArea {
                            clicked => { root.close-stage(); }
                            scroll-event(event) => { return accept; }
                        }

                        // Placed by hand rather than in a layout: the art's size
                        // follows this area's height, which a layout would feed back.
                        property <length> art-top: max(12px, (self.height - self.art-size - 190px) / 2);
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: stage.art-top;
                            width: stage.art-size;
                            height: stage.art-size;
                            CrossfadeArt {
                                source: root.album_art;
                                artwork-size: stage.shown-size;
                                radius: root.stage_art_radius;
                                rest-zoom: stage.drift;
                                hide-art: stage.show-tilt;
                                drop-shadow-blur: 44px;
                                // The shadow slides out from under the side that comes forward.
                                drop-shadow-offset-x: -10px * stage.tilt-x;
                                drop-shadow-offset-y: 18px - 8px * stage.tilt-y;
                                drop-shadow-color: #00000070;
                            }
                            if stage.show-tilt : Image {
                                width: stage.tilt-canvas;
                                height: stage.tilt-canvas;
                                source: root.stage_tilt_image;
                                image-fit: fill;
                            }
                            // Clicking the cover still closes the stage, as clicking around it does.
                            cover-touch := TouchArea {
                                clicked => { root.close-stage(); }
                            }
                        }
                        VerticalLayout {
                            x: 40px;
                            y: stage.art-top + stage.art-size + 22px;
                            width: parent.width - 80px;
                            height: 96px;
                            alignment: start;
                            spacing: 4px;
                            Text { text: root.track_title; color: AppTheme.text; font-size: 32px; font-weight: 700; letter-spacing: -0.3px; horizontal-alignment: center; overflow: elide; }
                            HorizontalLayout {
                                alignment: center;
                                ArtistLinks { names: root.track_artists; size: 16px; tint: AppTheme.secondary-text; clicked(name) => { root.show-artist(name); } }
                            }
                            HorizontalLayout {
                                alignment: center;
                                LinkText { text: root.track_album; size: 13px; clicked => { root.show-album(); } }
                            }
                        }

                        QueueGlyph {
                            x: parent.width - self.width - 16px;
                            y: 12px;
                            clicked => { root.close-stage(); }
                        }
                    }

                    // Lyrics: the song's words, large, in place of the list.
                    lyrics-page := Rectangle {
                        property <float> fade: root.lyrics_open ? 1 : 0;
                        animate fade { duration: AppTheme.motion-slow; easing: ease-out; }
                        visible: self.fade > 0.01;
                        opacity: self.fade > 0.01 ? self.fade : 1;
                        // Only there while it can be seen.
                        if lyrics-page.fade > 0.01 : LyricsView {
                            lines: root.lyrics_lines;
                            current: root.lyrics_line;
                            state: root.lyrics_state;
                            provider: root.lyrics_provider;
                            has-track: root.has-track;
                            seek(ms) => {
                                root.progress_ms = ms;
                                root.elapsed = root.format-ms(ms);
                                root.seek_to(ms);
                            }
                            close => { root.lyrics_open = false; }
                        }
                    }
                }

                // Right panel: slides open and closed
                Rectangle {
                  width: root.panel-target;
                  clip: true;
                  animate width { duration: root.sides-dragging ? 0ms : AppTheme.motion-slow; easing: ease-in-out; }

                  // Its left edge, the gap before what it shows.
                  if root.show-inspector : SideGrip {
                      x: 0px;
                      height: parent.height;
                      dragged(dx) => {
                          root.sides-dragging = true;
                          root.panel_width = round(max(300px, min(root.panel-limit(), root.panel_width - dx)) / 1px) * 1px;
                      }
                      dropped => { root.sides-dropped(); }
                      reset => {
                          root.panel_width = 348px;
                          root.save_library_size();
                      }
                  }

                  // Now playing + next up
                  Rectangle {
                    x: root.inspector-face == 1 ? 8px : -24px;
                    width: root.panel_width - 8px;
                    height: parent.height;
                    property <float> fade: root.inspector-face == 1 ? 1 : 0;
                    animate fade { duration: AppTheme.motion-spring; easing: ease-out; }
                    visible: self.fade > 0.01;
                    opacity: self.fade > 0.01 ? self.fade : 1;
                    animate x { duration: AppTheme.motion-slow; easing: ease-out; }
                    // The cache goes inside the fade. On the panel itself it would sit outside
                    // `visible`, measure the hidden panel as empty and stay empty for good.
                    Rectangle {
                    cache-rendering-hint: AppTheme.can-cache && parent.fade > 0.01 && !root.sides-dragging;
                    CacheAnchor { }

                    if !root.has-track : VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        padding: 32px;
                        Text { text: "Nothing playing"; color: AppTheme.text; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
                        Text { text: "Double-click a song to start."; color: AppTheme.subtle-text; font-size: 13px; horizontal-alignment: center; }
                    }

                    if root.has-track : Rectangle {
                      np-scroll := ScrollView {
                          changed viewport-y => { self.viewport-y = round(self.viewport-y / 1phx) * 1phx; }
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        viewport-width: self.visible-width;

                        VerticalLayout {
                            x: 0px;
                            width: np-scroll.visible-width;
                            alignment: start;
                            padding: 16px;
                            padding-bottom: 100px;
                            spacing: 4px;

                            // Clicking the art opens the stage; the art moves there.
                            Rectangle {
                                height: root.stage_open ? 0px : root.panel_width - 40px;
                                clip: root.stage_open;
                                opacity: root.stage_open ? 0 : 1;
                                animate height { duration: AppTheme.motion-slow; easing: ease-in-out; }
                                animate opacity { duration: AppTheme.motion-spring; easing: ease-out; }
                                CrossfadeArt {
                                    source: root.album_art;
                                    artwork-size: root.panel_width - 40px;
                                    radius: 12px;
                                    zoom: np-art.has-hover;
                                    drop-shadow-blur: 30px;
                                    drop-shadow-offset-y: 10px;
                                    drop-shadow-color: #00000080;
                                }
                                np-art := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.stage_open = true; }
                                }
                            }
                            Rectangle { height: 12px; }
                            // Geist sets lines taller than Inter did, so the words sit closer here.
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: root.track_title; color: AppTheme.text; font-size: 22px; font-weight: 700; letter-spacing: -0.2px; overflow: elide; }
                                ArtistLinks { names: root.track_artists; size: 14px; tint: AppTheme.secondary-text; clicked(name) => { root.show-artist(name); } }
                                if root.track_album != "" : LinkText { text: root.track_album; size: 13px; clicked => { root.show-album(); } }
                            }
                            Rectangle { height: 6px; }
                            // Where it's playing; opens the device list.
                            Rectangle {
                                height: 36px;
                                border-radius: 8px;
                                background: np-device.pressed ? AppTheme.active-bg : (np-device.has-hover ? AppTheme.selected-bg : AppTheme.hover-bg);
                                animate background { duration: AppTheme.motion-duration; easing: ease-out; }
                                np-device := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-devices(); }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 15px;
                                        Image {
                                            source: root.device_icon;
                                            colorize: AppTheme.secondary-text;
                                            width: 15px;
                                            height: 15px;
                                            image-fit: contain;
                                            transform-scale-x: np-device.has-hover ? 112% : 100%;
                                            transform-scale-y: np-device.has-hover ? 112% : 100%;
                                            animate transform-scale-x, transform-scale-y { duration: AppTheme.motion-spring; easing: ease-out; }
                                        }
                                    }
                                    Text {
                                        text: root.active_device_name == "" ? "Not playing" : root.output-label;
                                        color: AppTheme.text;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text { text: root.stream_quality; color: AppTheme.subtle-text; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            Rectangle { height: 12px; }
                            HorizontalLayout {
                                height: 28px;
                                Text {
                                    text: root.queue_titles.length > 0 ? "Next up" : "Nothing queued";
                                    color: AppTheme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.queue_reorder_enabled && root.queue_titles.length > 0 : TextButton {
                                    text: "Clear";
                                    ghost: true;
                                    button-width: 58px;
                                    height: 26px;
                                    clicked => { root.clear_queue(); }
                                }
                            }
                            QueueList {
                                titles: root.queue_titles;
                                artists: root.queue_artists;
                                images: root.queue_images;
                                editable: root.queue_reorder_enabled;
                                viewport-y: np-scroll.viewport-y;
                                visible-height: np-scroll.visible-height;
                                content-height: np-scroll.viewport-height;
                                busy <=> root.queue_busy;
                                scroll-to(y) => { np-scroll.viewport-y = y; }
                                play(index) => { root.play_queue_item(index); }
                                remove(index) => { root.remove_queue_item(index); }
                                reorder(from, to) => { root.move_queue_item(from, to); }
                            }
                        }
                      }
                      OverlayScrollBar {
                          x: parent.width - self.width;
                          y: 0px;
                          height: parent.height;
                          viewport-y: np-scroll.viewport-y;
                          viewport-height: np-scroll.viewport-height;
                          visible-height: np-scroll.visible-height;
                          scroll-to(y) => { np-scroll.viewport-y = y; }
                      }
                    }
                    }
                  }

                  // Connect to a device
                  Rectangle {
                    x: root.inspector-face == 2 ? 8px : 40px;
                    width: root.panel_width - 8px;
                    height: parent.height;
                    property <float> fade: root.inspector-face == 2 ? 1 : 0;
                    animate fade { duration: AppTheme.motion-spring; easing: ease-out; }
                    visible: self.fade > 0.01;
                    opacity: self.fade > 0.01 ? self.fade : 1;
                    animate x { duration: AppTheme.motion-slow; easing: ease-out; }
                    // The cache goes inside the fade. On the panel itself it would sit outside
                    // `visible`, measure the hidden panel as empty and stay empty for good.
                    Rectangle {
                    cache-rendering-hint: AppTheme.can-cache && parent.fade > 0.01 && !root.sides-dragging;
                    CacheAnchor { }

                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 14px;
                        spacing: 6px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            Text {
                                text: "Connect to a device";
                                color: AppTheme.text;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            IconButton {
                                width: 30px;
                                height: 30px;
                                icon: root.refresh_icon;
                                icon-size: 14px;
                                icon-rotation: root.device-spin-angle;
                                clicked => {
                                    root.refresh_devices();
                                    root.device-spins += 1;
                                }
                            }
                            Rectangle {
                                width: 30px;
                                QueueGlyph { clicked => { root.toggle-devices(); } }
                            }
                        }

                        Rectangle { height: 4px; }

                        if root.device_titles.length == 0 : Text { height: 40px; text: "  Looking for devices…"; color: AppTheme.muted-text; font-size: 13px; vertical-alignment: center; }
                        for title[index] in root.device_titles : DeviceRow {
                            title: title;
                            subtitle: root.device_subtitles[index];
                            icon: root.device_images[index];
                            active: root.device_is_active[index];
                            busy: root.device_switching && root.selected_device_index == index;
                            spinner: root.spinner_icon;
                            shown: root.inspector-face == 2;
                            order: index;
                            clicked => {
                                root.selected_device_index = index;
                                root.activate_device(index);
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                    }
                  }
                }
            }
        }

        // Content fades out as it passes under the floating bar.
        Rectangle {
            y: parent.height - 120px;
            width: parent.width;
            height: 120px;
            background: @linear-gradient(180deg, AppTheme.window-bg.transparentize(1) 0%, AppTheme.window-bg.transparentize(0.13) 40%, AppTheme.window-bg.transparentize(0.08) 100%);
        }

        // ── Player bar ────────────────────────────────────────────
        // Tinted with the album. The song's progress runs along the top edge
        // and washes across the whole bar behind the controls.
        player-bar := Rectangle {
            x: 12px;
            y: parent.height - self.height - 10px;
            width: parent.width - 24px;
            height: 62px;
            border-radius: 10px;
            drop-shadow-blur: 26px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000038;

            property <float> played: max(0.0, min(1.0, seek.display-value * 1.0 / max(1, root.progress_max_ms)));

            GlassPane {
                radius: parent.border-radius;

                Rectangle {
                    y: 0px;
                    width: parent.width;
                    height: seek.hovering ? 4px : 2px;
                    background: AppTheme.text.transparentize(seek.hovering ? 0.88 : 0.96);
                    animate height { duration: AppTheme.motion-duration; easing: ease-out; }
                    Rectangle {
                        x: 0px;
                        width: parent.width * player-bar.played;
                        height: parent.height;
                        border-radius: self.height / 2;
                        background: seek.hovering ? AppTheme.accent : AppTheme.text.transparentize(0.25);
                        animate background { duration: AppTheme.motion-duration; easing: ease-out; }
                    }
                }
            }

            // Clicks on the bar stay on the bar; scrolling passes through.
            TouchArea { }

            Rectangle {
            cache-rendering-hint: AppTheme.can-cache;
            CacheAnchor { }
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 16px;
                spacing: 16px;

                // Track
                HorizontalLayout {
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 320px;
                    alignment: start;
                    spacing: 11px;

                    Rectangle {
                        width: 44px;
                        CrossfadeArt {
                            source: root.album_art;
                            artwork-size: 44px;
                            radius: 8px;
                            zoom: art-touch.has-hover;
                        }
                        art-touch := TouchArea {
                            mouse-cursor: root.has-track ? pointer : default;
                            clicked => {
                                if (root.stage_open) {
                                    root.close-stage();
                                } else if (root.has-track) {
                                    root.stage_open = true;
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: -1px;

                        Text {
                            text: root.track_title;
                            color: AppTheme.text;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        ArtistLinks { names: root.track_artists; size: 12px; clicked(name) => { root.show-artist(name); } }
                    }

                    if root.has-track : HorizontalLayout {
                        alignment: center;
                        spacing: 0px;
                        Rectangle {
                            width: 28px;
                            BarGlyph {
                                commands: "M12 20.5 L4.6 13.1 A4.9 4.9 0 0 1 11.5 6.2 L12 6.7 L12.5 6.2 A4.9 4.9 0 0 1 19.4 13.1 Z";
                                filled: root.track_liked;
                                lit: root.track_liked;
                                clicked => { root.toggle_like(); }
                            }
                        }
                        Rectangle {
                            width: 28px;
                            BarGlyph {
                                commands: "M12 5 L12 19 M5 12 L19 12";
                                clicked => { root.open-picker(root.current_track_uri, root.track_title); }
                            }
                        }
                    }
                }

                // Transport
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    Text {
                        width: 42px;
                        text: seek.dragging ? root.format-ms(seek.display-value) : root.elapsed;
                        color: AppTheme.muted-text;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 8px; }

                    Rectangle {
                        width: 32px;
                        IconButton { width: 32px; height: 32px; icon-size: 15px; show-backdrop: false; icon: root.shuffle_icon; icon-color: AppTheme.muted-text; active: root.shuffle_enabled; show-dot: root.shuffle_enabled; clicked => { root.toggle_shuffle(); } }
                    }
                    Rectangle {
                        width: 34px;
                        IconButton { width: 34px; height: 34px; icon-size: 17px; show-backdrop: false; icon: root.previous_icon; icon-color: AppTheme.secondary-text; acts-on-press: true; clicked => { root.previous_track(); } }
                    }
                    Rectangle {
                        width: 42px;
                        PlayButton {
                            size: 36px;
                            icon: root.is_playing ? root.pause_icon : root.play_icon;
                            clicked => { root.play_pause(); }
                        }
                    }
                    Rectangle {
                        width: 34px;
                        IconButton { width: 34px; height: 34px; icon-size: 17px; show-backdrop: false; icon: root.next_icon; icon-color: AppTheme.secondary-text; acts-on-press: true; clicked => { root.next_track(); } }
                    }
                    Rectangle {
                        width: 32px;
                        IconButton { width: 32px; height: 32px; icon-size: 15px; show-backdrop: false; icon: root.repeat_mode == "track" ? root.repeat_one_icon : root.repeat_icon; icon-color: AppTheme.muted-text; active: root.repeat_mode != "off"; show-dot: root.repeat_mode != "off"; clicked => { root.cycle_repeat(); } }
                    }

                    Rectangle { width: 8px; }
                    Text {
                        width: 42px;
                        text: root.duration;
                        color: AppTheme.muted-text;
                        font-size: 11px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }

                // Time, output and volume
                HorizontalLayout {
                    horizontal-stretch: 1;
                    preferred-width: 0px;
                    min-width: 320px;
                    alignment: end;
                    spacing: 6px;

                    output-chip := Rectangle {
                        property <bool> open: chip-touch.has-hover || root.inspector_tab == 2;
                        width: self.open ? min(chip-label.preferred-width, 120px) + 40px : 32px;
                        animate width { duration: AppTheme.motion-slow; easing: ease-out; }
                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            clip: true;
                            background: chip-touch.pressed ? AppTheme.active-bg : (chip-touch.has-hover ? AppTheme.hover-bg : transparent);
                            animate background { duration: AppTheme.motion-duration; easing: ease-out; }
                            Image {
                                x: 8px;
                                source: root.device_icon;
                                colorize: root.inspector_tab == 2 ? AppTheme.accent : (chip-touch.has-hover ? AppTheme.text : AppTheme.subtle-text);
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                animate colorize { duration: AppTheme.motion-duration; }
                            }
                            chip-label := Text {
                                x: 30px;
                                text: root.output-label;
                                color: root.inspector_tab == 2 ? AppTheme.accent : AppTheme.text;
                                opacity: output-chip.open ? 1 : 0;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 120px;
                                animate opacity { duration: AppTheme.motion-slow; easing: ease-out; }
                                animate color { duration: AppTheme.motion-duration; }
                            }
                            chip-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-devices(); }
                            }
                        }
                    }
                    Rectangle {
                        width: 32px;
                        IconButton { width: 32px; height: 32px; icon-size: 16px; show-backdrop: false; icon: root.lyrics_icon; active: root.lyrics_open && !root.show_settings; clicked => { root.lyrics_open = root.show_settings || !root.lyrics_open; root.show_settings = false; } }
                    }
                    Rectangle {
                        width: 32px;
                        IconButton { width: 32px; height: 32px; icon-size: 16px; show-backdrop: false; icon: root.queue_icon; active: root.inspector_tab == 1; clicked => { root.inspector_tab = root.inspector_tab == 1 ? 0 : 1; } }
                    }
                    Rectangle {
                        width: 32px;
                        IconButton { width: 32px; height: 32px; icon-size: 16px; show-backdrop: false; icon: root.mini_player_icon; clicked => { root.toggle_mini_player(); } }
                    }
                    Rectangle {
                        width: 32px;
                        IconButton {
                            width: 32px;
                            height: 32px;
                            icon-size: 16px;
                            show-backdrop: false;
                            icon: root.muted || root.volume_percent == 0 ? root.mute_icon : (root.volume_percent < 50 ? root.volume_low_icon : root.volume_icon);
                            icon-color: AppTheme.subtle-text;
                            acts-on-press: true;
                            clicked => { root.toggle_mute(); }
                        }
                    }
                    Rectangle {
                        width: 84px;
                        SlimSlider {
                            width: 84px;
                            value: root.volume_percent;
                            maximum: 100;
                            tooltip-text: self.pointer-value + "%";
                            moved-to(v) => {
                                root.volume_percent = v;
                                root.muted = v <= 0;
                                root.set_volume(v);
                            }
                            changed(v) => {
                                root.volume_percent = v;
                                root.muted = v <= 0;
                                if (v > 0) {
                                    root.previous_volume_percent = v;
                                }
                                root.set_volume(v);
                            }
                        }
                    }
                }
            }

            }

            // Seeking: an invisible strip over the top edge drives the line above.
            seek := SlimSlider {
                visible: root.has-track;
                x: 0px;
                y: -7px;
                width: parent.width;
                height: 16px;
                show-bar: false;
                value: root.progress_ms;
                maximum: root.progress_max_ms;
                tooltip-text: root.has-track ? root.format-ms(self.pointer-value) : "";
                changed(v) => {
                    root.progress_ms = v;
                    root.elapsed = root.format-ms(v);
                    root.seek_to(v);
                }
            }
        }

        // ── Add to playlist ───────────────────────────────────────
        Rectangle {
            property <float> fade: root.picker_open ? 1 : 0;
            animate fade { duration: AppTheme.motion-spring; easing: ease-out; }
            visible: root.picker_open || self.fade > 0.01;
            opacity: root.picker_open || self.fade > 0.01 ? self.fade : 1;
            background: #00000080;

            TouchArea {
                y: 56px;
                height: parent.height - 56px;
                clicked => { root.close-picker(); }
                scroll-event(event) => { return accept; }
            }

            Rectangle {
                width: 480px;
                height: min(600px, parent.height - 84px);
                x: (parent.width - self.width) / 2;
                y: max(60px, (parent.height - self.height) / 2) + (root.picker_open ? 0px : 18px);
                animate y { duration: AppTheme.motion-slow; easing: ease-out; }
                border-radius: 12px;
                drop-shadow-blur: 50px;
                drop-shadow-offset-y: 14px;
                drop-shadow-color: #00000090;

                Rectangle {
                    border-radius: parent.border-radius;
                    clip: true;
                    background: root.surface;
                    border-color: AppTheme.text.transparentize(0.92);
                    border-width: 1px;

                    TouchArea { scroll-event(event) => { return accept; } }

                    VerticalLayout {
                        Rectangle {
                            height: 72px;
                            HorizontalLayout {
                                padding-left: 22px;
                                padding-right: 16px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    horizontal-stretch: 1;
                                    Text { text: "Add to playlist"; color: AppTheme.text; font-size: 18px; font-weight: 600; overflow: elide; }
                                    Text { text: root.picker_song; color: AppTheme.muted-text; font-size: 12px; overflow: elide; }
                                }
                                Rectangle {
                                    width: 30px;
                                    QueueGlyph { clicked => { root.close-picker(); } }
                                }
                            }
                        }

                        // Search
                        Rectangle {
                            height: 52px;
                            Rectangle {
                                x: 16px;
                                y: 0px;
                                width: parent.width - 32px;
                                height: 40px;
                                border-radius: 10px;
                                background: AppTheme.text.transparentize(0.95);
                                border-width: 1px;
                                border-color: picker-input.has-focus ? AppTheme.text.transparentize(0.86) : AppTheme.text.transparentize(0.94);
                                animate border-color { duration: AppTheme.motion-duration; easing: ease-out; }

                                Image {
                                    x: 12px;
                                    width: 16px;
                                    height: 16px;
                                    source: root.search_icon;
                                    colorize: picker-input.has-focus ? AppTheme.text : AppTheme.muted-text;
                                    image-fit: contain;
                                    animate colorize { duration: AppTheme.motion-duration; }
                                }
                                if root.picker_query == "" : Text {
                                    x: 38px;
                                    width: parent.width - 50px;
                                    text: "Find a playlist";
                                    color: AppTheme.muted-text;
                                    font-size: 14px;
                                    horizontal-alignment: left;
                                }
                                picker-input := TextInput {
                                    x: 38px;
                                    width: parent.width - 50px;
                                    color: AppTheme.text;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    text <=> root.picker_query;
                                    edited => {
                                        root.picker_cursor = 0;
                                        picker-list.viewport-y = 0px;
                                        root.filter_playlist_picker(self.text);
                                    }
                                }
                            }
                        }

                        // Makes one with the song already in it.
                        Rectangle {
                            height: 56px;
                            Rectangle {
                                x: 8px;
                                width: parent.width - 16px;
                                GlassHover { lit: new-pick-touch.has-hover; }
                                new-pick-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        let song = root.picker_uri;
                                        root.close-picker();
                                        root.open-new-playlist(song);
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 44px;
                                        Rectangle {
                                            width: 42px;
                                            height: 42px;
                                            border-radius: 6px;
                                            background: AppTheme.text.transparentize(0.92);
                                            Image { width: 18px; height: 18px; source: root.plus_icon; colorize: AppTheme.text; image-fit: contain; }
                                        }
                                    }
                                    Text {
                                        text: "New playlist";
                                        color: AppTheme.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;

                            picker-list := ListView {
                                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                for playlist-index[row] in root.picker_indices : Rectangle {
                                    height: 56px;
                                    Rectangle {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        GlassHover { lit: pick-touch.has-hover || root.picker_cursor == row; }
                                        pick-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.pick-playlist(playlist-index); }
                                        }
                                        PlaylistRowContent {
                                            art: root.playlist_images[playlist-index];
                                            title: root.playlist_titles[playlist-index];
                                            subtitle: root.playlist_subtitles[playlist-index];
                                            hovered: pick-touch.has-hover;
                                        }
                                    }
                                }
                            }

                            OverlayScrollBar {
                                x: parent.width - self.width;
                                y: 0px;
                                height: parent.height;
                                viewport-y: picker-list.viewport-y;
                                viewport-height: picker-list.viewport-height;
                                visible-height: picker-list.visible-height;
                                scroll-to(y) => { picker-list.viewport-y = y; }
                            }

                            if root.picker_indices.length == 0 : Text {
                                text: root.picker_query == "" ? "You don't have any playlists yet" : "No playlists match";
                                color: AppTheme.muted-text;
                                font-size: 13px;
                            }
                        }
                    }
                }
            }
        }

        // ── New playlist ──────────────────────────────────────────
        Rectangle {
            property <float> fade: root.new_playlist_open ? 1 : 0;
            animate fade { duration: AppTheme.motion-spring; easing: ease-out; }
            visible: root.new_playlist_open || self.fade > 0.01;
            opacity: root.new_playlist_open || self.fade > 0.01 ? self.fade : 1;
            background: #00000080;

            TouchArea {
                y: 56px;
                height: parent.height - 56px;
                clicked => { root.close-new-playlist(); }
                scroll-event(event) => { return accept; }
            }

            Rectangle {
                width: 420px;
                height: 184px;
                x: (parent.width - self.width) / 2;
                y: max(60px, (parent.height - self.height) / 2 - 60px) + (root.new_playlist_open ? 0px : 18px);
                animate y { duration: AppTheme.motion-slow; easing: ease-out; }
                border-radius: 12px;
                drop-shadow-blur: 50px;
                drop-shadow-offset-y: 14px;
                drop-shadow-color: #00000090;

                Rectangle {
                    border-radius: parent.border-radius;
                    clip: true;
                    background: root.surface;
                    border-color: AppTheme.text.transparentize(0.92);
                    border-width: 1px;

                    TouchArea { }

                    VerticalLayout {
                        padding: 22px;
                        padding-top: 18px;
                        spacing: 14px;

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: root.new-playlist-song == "" ? "New playlist" : "New playlist with this song";
                                color: AppTheme.text;
                                font-size: 18px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Rectangle {
                                width: 30px;
                                QueueGlyph { clicked => { root.close-new-playlist(); } }
                            }
                        }

                        Rectangle {
                            height: 40px;
                            border-radius: 10px;
                            background: AppTheme.text.transparentize(0.95);
                            border-width: 1px;
                            border-color: new-playlist-input.has-focus ? AppTheme.text.transparentize(0.86) : AppTheme.text.transparentize(0.94);
                            animate border-color { duration: AppTheme.motion-duration; easing: ease-out; }
                            if root.new_playlist_name == "" : Text {
                                x: 14px;
                                width: parent.width - 28px;
                                text: "Name";
                                color: AppTheme.muted-text;
                                font-size: 14px;
                                horizontal-alignment: left;
                            }
                            new-playlist-input := TextInput {
                                x: 14px;
                                width: parent.width - 28px;
                                color: AppTheme.text;
                                font-size: 14px;
                                vertical-alignment: center;
                                single-line: true;
                                text <=> root.new_playlist_name;
                                accepted => { root.make-new-playlist(); }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 10px;
                            TextButton {
                                text: "Cancel";
                                button-width: 96px;
                                clicked => { root.close-new-playlist(); }
                            }
                            TextButton {
                                text: "Create";
                                primary: true;
                                button-width: 96px;
                                enabled: root.new_playlist_name != "";
                                clicked => { root.make-new-playlist(); }
                            }
                        }
                    }
                }
            }
        }

        // ── Settings ──────────────────────────────────────────────
        // Floats over the dimmed window. The top bar stays live so the window
        // can still be dragged, minimized and closed. Exists only while open.
        settings-overlay := Rectangle {
            property <float> open: root.show_settings ? 1 : 0;
            animate open { duration: AppTheme.motion-spring; easing: ease-out; }
            visible: self.open > 0.01;
            opacity: self.open > 0.01 ? self.open : 1;
            background: #00000066;

            if root.show_settings || settings-overlay.open > 0.01 : Rectangle {
                TouchArea {
                    y: 56px;
                    height: parent.height - 56px;
                    clicked => { root.show_settings = false; }
                    scroll-event(event) => { return accept; }
                }

                settings-panel := Rectangle {
                    // Which tab shows as current. A tab stays current once clicked until the
                    // next scroll, as the last section may be too short to reach the top.
                    property <int> pinned: -1;
                    property <bool> jumping: false;
                    // Stays true once typing starts, or the field would vanish at the first letter.
                    property <bool> asks-client-id: false;
                    init => { self.asks-client-id = root.client_id == ""; }
                    property <[string]> tabs: root.developer_mode
                        ? ["Account", "General", "Playback", "Appearance", "Shortcuts", "Developer"]
                        : ["Account", "General", "Playback", "Appearance", "Shortcuts"];
                    property <length> furthest: max(0px, settings-scroll.viewport-height - settings-scroll.visible-height);
                    property <length> read-line: 60px - settings-scroll.viewport-y;
                    property <length> developer-y: sec-shortcuts.y + sec-shortcuts.height + 28px;
                    property <int> scrolled-tab: self.furthest > 0px && -settings-scroll.viewport-y >= self.furthest - 1px ? self.tabs.length - 1
                        : root.developer_mode && self.read-line >= self.developer-y ? 5
                        : self.read-line >= sec-shortcuts.y ? 4
                        : self.read-line >= sec-appearance.y ? 3
                        : self.read-line >= sec-playback.y ? 2
                        : self.read-line >= sec-general.y ? 1 : 0;

                    function jump-to(tab: int) {
                        let top = tab == 5 ? settings-panel.developer-y
                            : tab == 4 ? sec-shortcuts.y
                            : tab == 3 ? sec-appearance.y
                            : tab == 2 ? sec-playback.y
                            : tab == 1 ? sec-general.y : 0px;
                        settings-panel.pinned = tab;
                        settings-panel.jumping = true;
                        jump-end.running = true;
                        jump-end.restart();
                        settings-scroll.viewport-y = -min(settings-panel.furthest, top);
                    }
                    jump-end := Timer {
                        interval: 360ms;
                        running: false;
                        triggered => {
                            settings-panel.jumping = false;
                            self.running = false;
                        }
                    }

                    width: min(880px, parent.width - 96px);
                    height: min(800px, parent.height - 84px);
                    x: round((parent.width - self.width) / 2 / 1phx) * 1phx;
                    y: round((max(60px, (parent.height - self.height) / 2) + (1 - settings-overlay.open) * 14px) / 1phx) * 1phx;
                    border-radius: 16px;
                    drop-shadow-blur: 50px;
                    drop-shadow-offset-y: 14px;
                    drop-shadow-color: #00000070;

                    GlassPane {
                        radius: 16px;
                        // Dark enough to read over whatever is behind it.
                        background: AppTheme.window-bg.with-alpha(0.88);

                        TouchArea {
                            clicked => { keys.focus(); }
                            scroll-event(event) => { return accept; }
                        }

                        VerticalLayout {
                            Rectangle {
                                height: 66px;
                                Text {
                                    x: 32px;
                                    text: "Settings";
                                    color: AppTheme.text;
                                    font-size: 26px;
                                    font-weight: 700;
                                    letter-spacing: -0.3px;
                                    vertical-alignment: center;
                                }
                                QueueGlyph {
                                    x: parent.width - self.width - 20px;
                                    clicked => { root.show_settings = false; }
                                }
                            }

                            Rectangle {
                                height: 48px;
                                GlassSegments {
                                    x: 28px;
                                    y: 0px;
                                    options: settings-panel.tabs;
                                    selected: min(settings-panel.pinned >= 0 ? settings-panel.pinned : settings-panel.scrolled-tab, settings-panel.tabs.length - 1);
                                    segment-width: 98px;
                                    segment-height: 30px;
                                    text-size: 13px;
                                    chosen(tab) => {
                                        keys.focus();
                                        settings-panel.jump-to(tab);
                                    }
                                }
                                // Only once something has scrolled up behind it.
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: AppTheme.text.with-alpha(0.07);
                                    opacity: settings-scroll.viewport-y < 0px ? 1 : 0;
                                    animate opacity { duration: AppTheme.motion-spring; easing: ease-out; }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                settings-scroll := ScrollView {
                                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                    viewport-width: self.visible-width;
                                    animate viewport-y { duration: settings-panel.jumping && !AppTheme.reduce-motion ? 320ms : 0ms; easing: ease-in-out; }
                                    changed viewport-y => {
                                        if (!settings-panel.jumping) {
                                            settings-panel.pinned = -1;
                                            self.viewport-y = round(self.viewport-y / 1phx) * 1phx;
                                        }
                                    }

                                    VerticalLayout {
                                        x: 0px;
                                        width: settings-scroll.visible-width;
                                        padding-left: 28px;
                                        padding-right: 28px;
                                        padding-top: 14px;
                                        padding-bottom: 32px;
                                        alignment: start;
                                        spacing: 28px;

                                        // Only while a newer version is out.
                                        if root.update_version != "" : SettingsSection {
                                            title: "Update";
                                            scroll-y: settings-scroll.viewport-y;
                                            view-height: settings-scroll.visible-height;

                                            SettingRow {
                                                label: "Spotlight " + root.update_version + " is out";
                                                description: root.update_busy == "downloading" ? "Downloading… " + round(root.update_progress * 100) + "%"
                                                    : root.update_busy == "installing" ? "Installing…"
                                                    : root.update_confirming ? "GitHub lists no checksum for this file, so Spotlight can't check it's the real one."
                                                    : root.update_error != "" ? root.update_error
                                                    : root.update_installs_here ? "Updating restarts Spotlight, so the music stops for a moment."
                                                    : "This copy can't update itself. Download the new version from GitHub.";
                                                control-width: root.update_confirming && root.update_busy == "" ? 252px : 222px;
                                                TextButton {
                                                    x: 0px;
                                                    text: "What's new";
                                                    button-width: 106px;
                                                    clicked => { root.open_update_notes(); }
                                                }
                                                TextButton {
                                                    x: 116px;
                                                    text: !root.update_installs_here ? "Download"
                                                        : root.update_busy == "downloading" ? round(root.update_progress * 100) + "%"
                                                        : root.update_confirming ? "Update anyway"
                                                        : "Update";
                                                    primary: true;
                                                    enabled: root.update_busy == "";
                                                    button-width: root.update_confirming && root.update_busy == "" ? 136px : 106px;
                                                    clicked => { root.install_update(); }
                                                }
                                            }
                                        }

                                        sec-account := SettingsSection {
                                            title: "Account";
                                            scroll-y: settings-scroll.viewport-y;
                                            view-height: settings-scroll.visible-height;

                                            SettingRow {
                                                label: "Spotify";
                                                description: root.signed_in ? "Connected" : "Not connected";
                                                control-width: 200px;
                                                if root.signed_in : TextButton {
                                                    x: 0px;
                                                    text: "Reconnect";
                                                    button-width: 96px;
                                                    enabled: root.client_id != "";
                                                    clicked => { root.connect_spotify(); }
                                                }
                                                if root.signed_in : TextButton {
                                                    x: 104px;
                                                    text: "Sign out";
                                                    button-width: 96px;
                                                    clicked => { root.sign_out(); }
                                                }
                                                if !root.signed_in : TextButton {
                                                    x: 104px;
                                                    text: "Connect";
                                                    primary: true;
                                                    button-width: 96px;
                                                    enabled: root.client_id != "";
                                                    clicked => { root.connect_spotify(); }
                                                }
                                            }
                                            // Connecting can't work without one, developer or not.
                                            if root.client_id == "" || settings-panel.asks-client-id : SettingRow {
                                                label: "Client ID";
                                                description: "Spotlight needs this to connect. Get one free at developer.spotify.com.";
                                                control-width: 300px;
                                                GlassField {
                                                    text <=> root.client_id;
                                                    placeholder: "Paste your Client ID";
                                                    committed => { root.save_settings(); }
                                                }
                                            }
                                            // Only while signed out: once connected there's nothing to set up.
                                            if !root.signed_in : SettingRow {
                                                label: "Setup guide";
                                                description: "Go through making a Spotify app and connecting it.";
                                                control-width: 96px;
                                                TextButton {
                                                    text: "Open";
                                                    button-width: 96px;
                                                    clicked => {
                                                        root.show_settings = false;
                                                        root.onboarding_step = 1;
                                                    }
                                                }
                                            }
                                        }

                                        sec-general := SettingsSection {
                                            title: "General";
                                            scroll-y: settings-scroll.viewport-y;
                                            view-height: settings-scroll.visible-height;

                                            SettingRow {
                                                label: "Spotlight " + root.app_version;
                                                description: root.update_busy == "checking" ? "Checking for updates…"
                                                    : root.update_version != "" ? "Version " + root.update_version + " is out. It's at the top of Settings."
                                                    : root.update_note != "" ? root.update_note
                                                    : "New versions come from Spotlight's page on GitHub.";
                                                control-width: 120px;
                                                if root.is-windows : TextButton {
                                                    x: 120px - self.width;
                                                    text: root.update_busy == "checking" ? "Checking…" : "Check now";
                                                    enabled: root.update_busy == "";
                                                    button-width: 112px;
                                                    clicked => { root.check_for_update(); }
                                                }
                                            }
                                            if root.is-windows : SettingToggle { label: "Check for updates"; description: "Look for a new version when Spotlight opens, and once a day."; checked <=> root.check_for_updates; toggled => { root.save_settings(); } }

                                            if root.is-windows : SettingToggle { label: "Minimize to tray"; description: "Keep running in the tray when minimized."; checked <=> root.minimize_to_tray; toggled => { root.save_settings(); } }
                                            if root.is-windows : SettingToggle { label: "Close to tray"; description: "The close button hides the window instead of quitting."; checked <=> root.close_to_tray; toggled => { root.save_settings(); } }
                                            if root.is_linux : SettingToggle { label: "Open at sign-in"; description: "Start Spotlight, minimized, when you sign in to this computer."; checked <=> root.open_at_sign_in; toggled => { root.open_at_sign_in_changed(root.open_at_sign_in); } }
                                            SettingToggle { label: "Start minimized"; description: "Open quietly in the background."; checked <=> root.start_minimized; toggled => { root.save_settings(); } }
                                            if root.is-windows : SettingToggle { label: "Start in the tray at sign-in"; description: "When Spotlight starts with Windows, it waits in the tray."; checked <=> root.tray_at_sign_in; toggled => { root.save_settings(); } }
                                            SettingToggle { label: "Save resources in the background"; description: "Check Spotify less often when Spotlight isn't in front."; checked <=> root.low_resource_mode; toggled => { root.save_settings(); } }
                                            SettingRow {
                                                label: "Saved covers";
                                                description: root.cover_cache_note != "" ? root.cover_cache_note : "Album covers kept on " + root.this-computer + ", so they show at once.";
                                                control-width: 96px;
                                                TextButton {
                                                    text: "Clear";
                                                    button-width: 96px;
                                                    enabled: root.cover_cache_clearable;
                                                    clicked => { root.clear_cover_cache(); }
                                                }
                                            }
                                            SettingToggle { label: "Developer options"; description: "Show connection details, logs and advanced settings."; checked <=> root.developer_mode; toggled => { root.save_settings(); } }
                                        }

                                        sec-playback := SettingsSection {
                                            title: "Playback";
                                            scroll-y: settings-scroll.viewport-y;
                                            view-height: settings-scroll.visible-height;

                                            SettingRow {
                                                label: "Output device";
                                                description: root.output_device_missing ? (root.is_mac ? "Not connected right now, so Spotlight is using the Mac's own choice." : root.is_linux ? "Not connected right now, so Spotlight is using the system default." : "Not connected right now, so Spotlight is using the Windows default.") : (root.is_mac ? "Where Spotlight plays, whatever the Mac is set to." : root.is_linux ? "Where Spotlight plays, whatever the system is set to." : "Where Spotlight plays, whatever Windows is set to.");
                                                control-width: 290px;
                                                clickable: true;
                                                clicked => {
                                                    root.refresh_output_devices();
                                                    device-menu.show();
                                                }
                                                Rectangle {
                                                    x: 290px - self.width;
                                                    width: min(290px, device-label.preferred-width + 42px);
                                                    height: 32px;
                                                    border-radius: 16px;
                                                    background: AppTheme.text.with-alpha(0.06);
                                                    device-label := Text {
                                                        x: 14px;
                                                        width: parent.width - 42px;
                                                        text: root.output_device == "" ? root.default-device-label : root.output_device;
                                                        color: AppTheme.text;
                                                        font-size: 12px;
                                                        font-weight: 600;
                                                        horizontal-alignment: left;
                                                        overflow: elide;
                                                    }
                                                    Path {
                                                        x: parent.width - 24px;
                                                        width: 10px;
                                                        height: 10px;
                                                        commands: "M2 4 L6 8 L10 4";
                                                        viewbox-width: 12;
                                                        viewbox-height: 12;
                                                        fill: transparent;
                                                        stroke: AppTheme.subtle-text;
                                                        stroke-width: 1.4px;
                                                    }
                                                }
                                                device-menu := PopupWindow {
                                                    close-policy: close-on-click-outside;
                                                    width: 320px;
                                                    height: min(374px, 47px + root.output_devices.length * 34px);
                                                    x: parent.width - self.width - 14px;
                                                    y: 48px;

                                                    MenuSurface {
                                                        // Bright toggles sit right behind this one.
                                                        density: 0.92;
                                                        device-list := ScrollView {
                                                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                                            viewport-width: self.visible-width;
                                                            VerticalLayout {
                                                                x: 0px;
                                                                width: device-list.visible-width;
                                                                padding: 6px;
                                                                spacing: 2px;
                                                                alignment: start;
                                                                MenuItem {
                                                                    text: root.default-device-label;
                                                                    hint: root.output_device == "" ? "✓" : "";
                                                                    clicked => {
                                                                        // Last: closing destroys this row and its name.
                                                                        root.output_device = "";
                                                                        root.output_device_missing = false;
                                                                        root.save_settings();
                                                                        device-menu.close();
                                                                    }
                                                                }
                                                                Divider { height: 1px; background: AppTheme.text.transparentize(0.9); }
                                                                for name in root.output_devices : MenuItem {
                                                                    text: name;
                                                                    hint: root.output_device == name ? "✓" : "";
                                                                    clicked => {
                                                                        // Last: closing destroys this row and its name.
                                                                        root.output_device = name;
                                                                        root.output_device_missing = false;
                                                                        root.save_settings();
                                                                        device-menu.close();
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            SettingSegments {
                                                label: "Audio quality";
                                                description: "Higher quality uses more data.";
                                                options: ["Low", "Normal", "High"];
                                                selected: root.audio_quality == "Low" ? 0 : (root.audio_quality == "Normal" ? 1 : 2);
                                                chosen(index) => {
                                                    root.audio_quality = index == 0 ? "Low" : (index == 1 ? "Normal" : "High");
                                                    root.save_settings();
                                                }
                                            }
                                            SettingToggle { label: "Even out volume"; description: "Keep songs at a similar loudness."; checked <=> root.normalize_volume; toggled => { root.save_settings(); } }
                                            SettingToggle { label: "Keep playing the list"; description: "After the song you pick, carry on with the rest of the list."; checked <=> root.autoplay_similar; toggled => { root.save_settings(); } }
                                            SettingSegments {
                                                label: "Crossfade";
                                                description: "Fade each song into the next. Albums played in order run on.";
                                                options: ["Off", "3 s", "5 s", "8 s", "12 s"];
                                                segment-width: 56px;
                                                selected: root.crossfade_seconds <= 0 ? 0 : (root.crossfade_seconds <= 3 ? 1 : (root.crossfade_seconds <= 5 ? 2 : (root.crossfade_seconds <= 8 ? 3 : 4)));
                                                chosen(index) => {
                                                    root.crossfade_seconds = [0, 3, 5, 8, 12][index];
                                                    root.save_settings();
                                                }
                                            }
                                            SettingToggle { label: "Remember volume"; description: "Start at the volume you last used."; checked <=> root.remember_volume; toggled => { root.save_settings(); } }
                                            SettingToggle { label: "Resume when Spotlight opens"; description: "Picks up where you left off, even if another device is playing."; checked <=> root.resume_on_startup; toggled => { root.save_settings(); } }
                                        }

                                        sec-appearance := SettingsSection {
                                            title: "Appearance";
                                            scroll-y: settings-scroll.viewport-y;
                                            view-height: settings-scroll.visible-height;

                                            SettingSegments {
                                                label: "Theme";
                                                description: root.is_mac ? "Follow the Mac, or stay dark or light." : root.is_linux ? "Follow the desktop, or stay dark or light." : "Follow Windows, or stay dark or light.";
                                                options: ["System", "Dark", "Light"];
                                                selected: root.theme_mode == "System" ? 0 : (root.theme_mode == "Dark" ? 1 : 2);
                                                chosen(index) => {
                                                    root.theme_mode = index == 0 ? "System" : (index == 1 ? "Dark" : "Light");
                                                    root.save_settings();
                                                }
                                            }
                                            SettingRow {
                                                label: "Accent color";
                                                description: "Used for what's playing and for main buttons.";
                                                control-width: 124px;
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    alignment: end;
                                                    for swatch in [
                                                        { name: "Green", tint: #1ed760 },
                                                        { name: "Blue", tint: #4e9cff },
                                                        { name: "Purple", tint: #ab84ff },
                                                        { name: "White", tint: AppTheme.is-light ? #18181b : #e6e6e6 },
                                                    ] : VerticalLayout {
                                                        alignment: center;
                                                        AccentSwatch {
                                                            tint: swatch.tint;
                                                            chosen: root.accent_color == swatch.name;
                                                            clicked => {
                                                                root.accent_color = swatch.name;
                                                                root.save_settings();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            SettingToggle { label: "Album colors"; description: "Tint the window with the current album's color."; checked <=> root.album_colors; toggled => { root.save_settings(); } }
                                            SettingToggle { label: "Reduce motion"; description: "Fewer animations and no smooth scrolling."; checked <=> root.reduce_animations; toggled => { root.save_settings(); } }
                                        }

                                        sec-shortcuts := SettingsSection {
                                            title: "Shortcuts";
                                            scroll-y: settings-scroll.viewport-y;
                                            view-height: settings-scroll.visible-height;

                                            SettingToggle { label: "Media keys"; description: root.is_mac ? "Show the song in the Mac's Now Playing, so play and skip keys reach Spotlight when it played last." : root.is_linux ? "Show the song in the desktop's media controls, so play and skip keys reach Spotlight." : "Show the song in Windows' media controls, so play and skip keys reach Spotlight when it played last."; checked <=> root.media_keys_enabled; toggled => { root.save_settings(); } }
                                            if root.is-windows : SettingToggle { label: "Shortcuts in the background"; description: "The keys below work even when Spotlight isn't in front."; checked <=> root.global_hotkeys; toggled => { root.save_settings(); } }
                                            if root.is-windows : SettingRow {
                                                label: "Play or pause";
                                                control-width: 170px;
                                                ShortcutField {
                                                    text: root.play_pause_hotkey;
                                                    listening: root.recording_shortcut == "play-pause";
                                                    keys: root.shortcut_keys;
                                                    refused: root.shortcut_refused;
                                                    pressed => { root.shortcut-field-pressed = true; }
                                                    clicked => { root.record_shortcut("play-pause"); }
                                                }
                                            }
                                            if root.is-windows : SettingRow {
                                                label: "Next song";
                                                control-width: 170px;
                                                ShortcutField {
                                                    text: root.next_hotkey;
                                                    listening: root.recording_shortcut == "next";
                                                    keys: root.shortcut_keys;
                                                    refused: root.shortcut_refused;
                                                    pressed => { root.shortcut-field-pressed = true; }
                                                    clicked => { root.record_shortcut("next"); }
                                                }
                                            }
                                            if root.is-windows : SettingRow {
                                                label: "Previous song";
                                                control-width: 170px;
                                                ShortcutField {
                                                    text: root.previous_hotkey;
                                                    listening: root.recording_shortcut == "previous";
                                                    keys: root.shortcut_keys;
                                                    refused: root.shortcut_refused;
                                                    pressed => { root.shortcut-field-pressed = true; }
                                                    clicked => { root.record_shortcut("previous"); }
                                                }
                                            }
                                            if root.is-windows : SettingRow {
                                                label: "Shuffle";
                                                control-width: 170px;
                                                ShortcutField {
                                                    text: root.shuffle_hotkey;
                                                    listening: root.recording_shortcut == "shuffle";
                                                    keys: root.shortcut_keys;
                                                    refused: root.shortcut_refused;
                                                    pressed => { root.shortcut-field-pressed = true; }
                                                    clicked => { root.record_shortcut("shuffle"); }
                                                }
                                            }
                                            if root.is-windows : SettingRow {
                                                label: "Repeat";
                                                control-width: 170px;
                                                ShortcutField {
                                                    text: root.repeat_hotkey;
                                                    listening: root.recording_shortcut == "repeat";
                                                    keys: root.shortcut_keys;
                                                    refused: root.shortcut_refused;
                                                    pressed => { root.shortcut-field-pressed = true; }
                                                    clicked => { root.record_shortcut("repeat"); }
                                                }
                                            }
                                            if root.hotkey_warning != "" : HorizontalLayout {
                                                padding: 10px;
                                                padding-left: 14px;
                                                Text { text: root.hotkey_warning; color: AppTheme.warning; font-size: 12px; wrap: word-wrap; }
                                            }
                                        }

                                        SettingsSection {
                                            title: "Keys inside Spotlight";
                                            scroll-y: settings-scroll.viewport-y;
                                            view-height: settings-scroll.visible-height;

                                            keys-grid := Rectangle {
                                                height: 5 * 36px + 8px;
                                                for hint[i] in [
                                                    { action: "Play or pause", keys: "Space" },
                                                    { action: "Search", keys: root.command-key + "K" },
                                                    { action: "Filter the list", keys: root.command-key + "F" },
                                                    { action: "Move through songs", keys: "↑  ↓" },
                                                    { action: "Play the selected song", keys: "Enter" },
                                                    { action: "Play it next", keys: "Shift+Enter" },
                                                    { action: "Next or previous song", keys: root.command-key + "→  " + root.command-key + "←" },
                                                    { action: "Volume", keys: root.command-key + "↑  " + root.command-key + "↓" },
                                                    { action: "Go back", keys: root.is_mac ? "Esc  ⌥←" : "Esc  Alt+←" },
                                                    { action: "Open Settings", keys: root.command-key + "," },
                                                ] : Rectangle {
                                                    x: mod(i, 2) * floor(keys-grid.width / 2 / 1phx) * 1phx;
                                                    y: 4px + floor(i / 2) * 36px;
                                                    width: floor(keys-grid.width / 2 / 1phx) * 1phx;
                                                    height: 36px;
                                                    Text {
                                                        x: 14px;
                                                        width: parent.width - 150px;
                                                        text: hint.action;
                                                        color: AppTheme.secondary-text;
                                                        font-size: 13px;
                                                        horizontal-alignment: left;
                                                        overflow: elide;
                                                    }
                                                    Rectangle {
                                                        x: parent.width - self.width - 14px;
                                                        width: key-label.preferred-width + 16px;
                                                        height: 24px;
                                                        border-radius: 7px;
                                                        background: AppTheme.text.with-alpha(0.06);
                                                        border-width: 1px;
                                                        border-color: AppTheme.text.with-alpha(0.06);
                                                        key-label := Text {
                                                            text: hint.keys;
                                                            color: AppTheme.text;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        if root.developer_mode : SettingsSection {
                                            title: "Developer";
                                            scroll-y: settings-scroll.viewport-y;
                                            view-height: settings-scroll.visible-height;

                                            SettingRow {
                                                label: "Connection";
                                                description: root.connection_status + " • " + root.player_status;
                                            }
                                            SettingRow {
                                                label: "Client ID";
                                                description: "From developer.spotify.com/dashboard.";
                                                control-width: 300px;
                                                GlassField { text <=> root.client_id; committed => { root.save_settings(); } }
                                            }
                                            SettingRow {
                                                label: "Redirect URI";
                                                control-width: 300px;
                                                GlassField { text <=> root.redirect_uri; committed => { root.save_settings(); } }
                                            }
                                            SettingSegments {
                                                label: "Log detail";
                                                description: "How much the log below keeps.";
                                                options: ["Error", "Warn", "Info", "Debug"];
                                                selected: root.log_level == "Error" ? 0 : (root.log_level == "Warn" ? 1 : (root.log_level == "Info" ? 2 : 3));
                                                segment-width: 62px;
                                                chosen(index) => {
                                                    root.log_level = index == 0 ? "Error" : (index == 1 ? "Warn" : (index == 2 ? "Info" : "Debug"));
                                                    root.save_settings();
                                                }
                                            }
                                            HorizontalLayout {
                                                padding: 9px;
                                                Rectangle {
                                                    height: 190px;
                                                    border-radius: 9px;
                                                    clip: true;
                                                    background: AppTheme.text.with-alpha(0.04);
                                                    log-scroll := ScrollView {
                                                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                                        viewport-width: self.visible-width;
                                                        viewport-height: log-text.preferred-height + 20px;
                                                        log-text := TextInput {
                                                            x: 12px;
                                                            y: 10px;
                                                            width: log-scroll.visible-width - 24px;
                                                            height: self.preferred-height;
                                                            text: root.status_log;
                                                            read-only: true;
                                                            single-line: false;
                                                            wrap: word-wrap;
                                                            color: AppTheme.subtle-text;
                                                            font-size: 12px;
                                                        }
                                                    }
                                                }
                                            }
                                            SettingRow {
                                                label: "Reset app data";
                                                description: "Erases your settings and sign-in on " + root.this-computer + ".";
                                                control-width: 170px;
                                                TextButton {
                                                    x: 170px - self.width;
                                                    text: root.reset-armed ? "Click again to erase" : "Reset";
                                                    button-width: root.reset-armed ? 170px : 96px;
                                                    clicked => {
                                                        if (root.reset-armed) {
                                                            root.reset-armed = false;
                                                            root.reset_app_data();
                                                        } else {
                                                            root.reset-armed = true;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                OverlayScrollBar {
                                    x: parent.width - self.width;
                                    y: 0px;
                                    height: parent.height;
                                    bottom-inset: 12px;
                                    viewport-y: settings-scroll.viewport-y;
                                    viewport-height: settings-scroll.viewport-height;
                                    visible-height: settings-scroll.visible-height;
                                    scroll-to(y) => { settings-scroll.viewport-y = y; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Setup guide ──────────────────────────────────────────────────────
    // Over everything under the top bar, which keeps the window's buttons and settings.
    if root.onboarding-shown : guide := Rectangle {
        y: 56px;
        height: root.height - 56px;
        background: AppTheme.window-bg;
        property <float> reveal: 0;
        init => {
            self.reveal = 1;
            guide-keys.focus();
        }
        animate reveal { duration: AppTheme.motion-slow; easing: ease-out; }
        opacity: self.reveal;

        // Takes the pointer, so nothing behind lights up or scrolls.
        TouchArea { }
        // A faint glow of the accent behind the card.
        Rectangle {
            width: 1000px;
            height: 1000px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 30px;
            background: @radial-gradient(circle, AppTheme.accent.with-alpha(AppTheme.is-light ? 0.1 : 0.08) 0%, AppTheme.accent.with-alpha(0) 55%);
        }

        guide-keys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape && root.signed_in) {
                    root.close-onboarding();
                    return accept;
                }
                return reject;
            }

            card := Rectangle {
                width: min(560px, parent.width - 48px);
                height: card-body.preferred-height;
                x: (parent.width - self.width) / 2;
                // Its top stays put as pages of different heights come and go, as if centred
                // for the tallest.
                y: max(12px, min((parent.height - self.height) / 2, (parent.height - 580px) / 2));
                GlassPane { radius: 18px; strength: 1.2; }

                card-body := VerticalLayout {
                    padding: 34px;
                    padding-top: 26px;
                    spacing: 0px;

                    HorizontalLayout {
                        height: 28px;
                        GuidePills { count: 4; current: root.onboarding_step; }
                        Rectangle { horizontal-stretch: 1; }
                        // Someone already signed in is only looking, and can leave at any point.
                        if root.signed_in : VerticalLayout {
                            alignment: center;
                            TextButton {
                                text: "Close";
                                ghost: true;
                                button-width: 72px;
                                clicked => { root.close-onboarding(); }
                            }
                        }
                    }
                    Rectangle { height: 16px; }

                    // Welcome
                    if root.onboarding_step == 1 : GuidePage {
                        title: "Welcome to Spotlight";
                        lead: "Your Spotify music in a player that opens in an instant and stays light while it plays.";

                        VerticalLayout {
                            spacing: 12px;
                            for point in [
                                { title: "Quick", text: root.is-windows ? "Made for Windows, with no browser inside, so every click lands at once." : "Made for the desktop, with no browser inside, so every click lands at once." },
                                { title: "Light", text: "Next to no memory or CPU while the music plays, and less when it's hidden." },
                                { title: root.is_mac ? "At home on the Mac" : root.is_linux ? "At home on Linux" : "At home in Windows", text: root.is_mac ? "Media keys, Now Playing and a mini player." : root.is_linux ? "Media keys, the desktop's media controls and a mini player." : "Media keys, the lock screen, a mini player and taskbar buttons." },
                            ] : HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    padding-top: 6px;
                                    alignment: start;
                                    Rectangle {
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 3.5px;
                                        background: AppTheme.accent;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 1px;
                                    Text { text: point.title; color: AppTheme.text; font-size: 14px; font-weight: 600; }
                                    Text { text: point.text; color: AppTheme.subtle-text; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }
                        Rectangle { height: 28px; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Needs Spotify Premium. Setting up takes about two minutes.";
                                color: AppTheme.muted-text;
                                font-size: 12px;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            TextButton {
                                text: "Get started";
                                primary: true;
                                button-width: 124px;
                                clicked => { root.onboarding_step = 2; }
                            }
                        }
                    }

                    // Making a Spotify app
                    if root.onboarding_step == 2 : make-app := GuidePage {
                        title: "Create a Spotify app";
                        lead: "Spotify lets players like Spotlight in through an app you create on its developer site. It's free and takes a minute.";
                        property <bool> copied: false;

                        VerticalLayout {
                            spacing: 8px;
                            GuideStep {
                                number: 1;
                                title: "Open the Spotify developer dashboard";
                                detail: "Sign in with your Spotify account.";
                                control-width: 92px;
                                TextButton {
                                    text: "Open";
                                    button-width: 92px;
                                    clicked => { root.open_link("https://developer.spotify.com/dashboard"); }
                                }
                            }
                            GuideStep {
                                number: 2;
                                title: "Press Create app";
                                detail: "Any name and description will do, such as \"Spotlight\".";
                            }
                            GuideStep {
                                number: 3;
                                title: "Add this Redirect URI, exactly";
                                detail: root.redirect_uri;
                                control-width: 92px;
                                TextButton {
                                    text: make-app.copied ? "Copied" : "Copy";
                                    button-width: 92px;
                                    clicked => {
                                        if (root.copy_text(root.redirect_uri)) {
                                            make-app.copied = true;
                                        }
                                    }
                                }
                                Timer {
                                    interval: 1600ms;
                                    running: make-app.copied;
                                    triggered => { make-app.copied = false; }
                                }
                            }
                            GuideStep {
                                number: 4;
                                title: "Tick Web API, agree and save";
                                detail: "Spotlight needs nothing else.";
                            }
                        }
                        Rectangle { height: 12px; }
                        Text {
                            text: "Made one before? You can use it: add the Redirect URI to it and tick Web API.";
                            color: AppTheme.muted-text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 24px; }
                        HorizontalLayout {
                            spacing: 10px;
                            TextButton {
                                text: "Back";
                                ghost: true;
                                button-width: 80px;
                                clicked => { root.onboarding_step = 1; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            TextButton {
                                text: "Next";
                                primary: true;
                                button-width: 112px;
                                clicked => { root.onboarding_step = 3; }
                            }
                        }
                    }

                    // Connecting
                    if root.onboarding_step == 3 : connect-page := GuidePage {
                        property <string> problem: root.client_id_problem(root.client_id);
                        title: root.connect_stage == "player" ? "Almost there" : (root.signed_in ? "Connected" : "Connect your account");
                        lead: root.connect_stage == "player" ? "Spotlight can see your music now."
                            : root.signed_in ? "Spotlight is signed in to your Spotify account."
                            : "On your app's page on the dashboard, open Settings and copy its Client ID.";

                        if !root.signed_in : VerticalLayout {
                            spacing: 6px;
                            GlassField {
                                height: 38px;
                                text <=> root.client_id;
                                placeholder: "Paste your Client ID";
                                committed => { root.save_settings(); }
                            }
                            Text {
                                text: connect-page.problem;
                                color: AppTheme.warning;
                                font-size: 12px;
                                height: 16px;
                                opacity: self.text == "" ? 0 : 1;
                                animate opacity { duration: AppTheme.motion-duration; }
                            }
                        }
                        if !root.signed_in : Rectangle { height: 8px; }

                        // What the browser is waiting on, or what went wrong.
                        if root.signed_in || root.connect_stage != "" : Rectangle {
                            height: status-rows.preferred-height + 24px;
                            border-radius: 12px;
                            background: root.connect_stage == "failed" ? AppTheme.danger.with-alpha(0.1) : AppTheme.text.with-alpha(0.04);
                            border-width: 1px;
                            border-color: root.connect_stage == "failed" ? AppTheme.danger.with-alpha(0.35) : AppTheme.text.with-alpha(0.07);

                            status-rows := HorizontalLayout {
                                x: 14px;
                                y: 12px;
                                width: parent.width - 28px;
                                height: self.preferred-height;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: start;
                                    padding-top: 2px;
                                    if root.connect-busy : WaitingDots { }
                                    if root.signed_in && !root.connect-busy : Path {
                                        width: 16px;
                                        height: 14px;
                                        viewbox-width: 16;
                                        viewbox-height: 14;
                                        commands: "M2 7.5 L6 11.5 L14 2.5";
                                        fill: transparent;
                                        stroke: AppTheme.accent;
                                        stroke-width: 2px;
                                    }
                                    if root.connect_stage == "failed" && !root.signed_in : Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: AppTheme.danger;
                                        Text { text: "!"; color: #ffffff; font-size: 11px; font-weight: 700; }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    Text {
                                        text: root.signed_in && !root.connect-busy ? "You're connected."
                                            : root.connect_stage == "library" ? "Agree in your browser to let Spotlight in."
                                            : root.connect_stage == "player" ? "One more: agree again so Spotlight can play music on " + root.this-computer + "."
                                            : "Couldn't connect.";
                                        color: AppTheme.text;
                                        font-size: 13px;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: root.signed_in && !root.connect-busy ? (root.player_ready ? "Your library is here, and music plays on " + root.this-computer + "." : "Your library is here. Playing on " + root.this-computer + " is set up the first time you press play.")
                                            : root.connect_stage == "library" ? "Seeing an error from Spotify instead? Check the Client ID, and that the Redirect URI matches exactly."
                                            : root.connect_stage == "player" ? "This second sign-in is Spotify's own, for its player."
                                            : root.connect_error;
                                        color: AppTheme.subtle-text;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    if root.connect-busy : HorizontalLayout {
                                        padding-top: 4px;
                                        alignment: start;
                                        LinkText {
                                            text: root.connect_stage == "player" ? "Skip for now" : "Start over";
                                            size: 12px;
                                            tint: AppTheme.accent;
                                            clicked => { root.cancel_sign_in(); }
                                        }
                                    }
                                }
                            }
                        }
                        if !root.signed_in && root.connect_stage == "" : Text {
                            text: "Your browser opens twice: once to let Spotlight see your music, and once to play it on " + root.this-computer + ".";
                            color: AppTheme.muted-text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 24px; }
                        HorizontalLayout {
                            spacing: 10px;
                            TextButton {
                                text: "Back";
                                ghost: true;
                                button-width: 80px;
                                enabled: !root.connect-busy;
                                clicked => { root.onboarding_step = 2; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if !root.signed_in : TextButton {
                                text: root.connect_stage == "failed" ? "Try again" : "Connect Spotify";
                                primary: true;
                                button-width: 150px;
                                enabled: root.client_id != "" && connect-page.problem == "" && !root.connect-busy;
                                clicked => {
                                    root.save_settings();
                                    root.connect_spotify();
                                }
                            }
                            if root.signed_in : TextButton {
                                text: "Next";
                                primary: true;
                                button-width: 112px;
                                enabled: !root.connect-busy;
                                clicked => { root.onboarding_step = 4; }
                            }
                        }
                    }

                    // A few choices
                    if root.onboarding_step == 4 : GuidePage {
                        title: "You're all set";
                        lead: "A few things you might like to choose now. They're all in Settings later.";

                        Rectangle {
                            height: choices.preferred-height;
                            GlassPane { radius: 13px; strength: 0.8; }
                            choices := VerticalLayout {
                                padding: 5px;
                                spacing: 1px;
                                SettingSegments {
                                    label: "Theme";
                                    options: ["System", "Dark", "Light"];
                                    selected: root.theme_mode == "System" ? 0 : (root.theme_mode == "Dark" ? 1 : 2);
                                    chosen(index) => {
                                        root.theme_mode = index == 0 ? "System" : (index == 1 ? "Dark" : "Light");
                                        root.save_settings();
                                    }
                                }
                                SettingRow {
                                    label: "Accent color";
                                    control-width: 124px;
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;
                                        for swatch in [
                                            { name: "Green", tint: #1ed760 },
                                            { name: "Blue", tint: #4e9cff },
                                            { name: "Purple", tint: #ab84ff },
                                            { name: "White", tint: AppTheme.is-light ? #18181b : #e6e6e6 },
                                        ] : VerticalLayout {
                                            alignment: center;
                                            AccentSwatch {
                                                tint: swatch.tint;
                                                chosen: root.accent_color == swatch.name;
                                                clicked => {
                                                    root.accent_color = swatch.name;
                                                    root.save_settings();
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.is-windows : SettingToggle {
                                    label: "Keep playing when closed";
                                    description: "The close button tucks Spotlight into the tray.";
                                    checked <=> root.close_to_tray;
                                    toggled => { root.save_settings(); }
                                }
                                SettingToggle {
                                    label: "Resume when Spotlight opens";
                                    description: "Carry on with the last song without pressing play.";
                                    checked <=> root.resume_on_startup;
                                    toggled => { root.save_settings(); }
                                }
                            }
                        }
                        Rectangle { height: 16px; }
                        if !root.player_ready : Text {
                            text: "Playing on " + root.this-computer + " isn't set up yet. Spotlight asks the first time you press play here.";
                            color: AppTheme.muted-text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if !root.player_ready : Rectangle { height: 12px; }
                        HorizontalLayout {
                            spacing: 18px;
                            alignment: start;
                            GuideTip { keys: [root.is_mac ? "⌘" : "Ctrl", "K"]; text: "Search"; }
                            GuideTip { keys: ["Space"]; text: "Play or pause"; }
                            GuideTip { keys: ["Right-click"]; text: "More for any song"; }
                        }
                        Rectangle { height: 26px; }
                        HorizontalLayout {
                            spacing: 10px;
                            TextButton {
                                text: "Back";
                                ghost: true;
                                button-width: 80px;
                                clicked => { root.onboarding_step = 3; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            TextButton {
                                text: "Start listening";
                                primary: true;
                                button-width: 140px;
                                clicked => { root.close-onboarding(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Mini player ──────────────────────────────────────────────────────
    // The window shrinks to a card of the song playing. Windows treats all of it but the
    // buttons and the seek strip as title bar, so it drags from anywhere and a double click
    // brings back the full window. `window_chrome.rs` keeps the same layout.
    if root.mini_mode : FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == " ") {
                root.play_pause();
                return accept;
            }
            if (event.modifiers.control && event.text == Key.RightArrow) {
                root.next_track();
                return accept;
            }
            if (event.modifiers.control && event.text == Key.LeftArrow) {
                root.previous_track();
                return accept;
            }
            return reject;
        }

        // Its buttons and the seek strip lie over this, so they take their presses first.
        if root.is_mac : TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.drag_window();
                }
            }
        }

        CrossfadeArt {
            x: 12px;
            y: 12px;
            source: root.album_art;
            artwork-size: 88px;
            radius: 8px;
        }

        Text {
            x: 112px;
            y: 17px;
            width: parent.width - 112px - 104px;
            text: root.track_title;
            color: AppTheme.text;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
        }
        ArtistLinks {
            x: 112px;
            y: 37px;
            width: parent.width - 112px - 16px;
            names: root.track_artists;
            size: 12px;
        }

        IconButton {
            x: 108px;
            y: 64px;
            width: 32px;
            height: 32px;
            icon-size: 16px;
            show-backdrop: false;
            icon: root.previous_icon;
            icon-color: AppTheme.secondary-text;
            acts-on-press: true;
            clicked => { root.previous_track(); }
        }
        PlayButton {
            x: 144px;
            y: 60px;
            size: 36px;
            icon: root.is_playing ? root.pause_icon : root.play_icon;
            clicked => { root.play_pause(); }
        }
        IconButton {
            x: 188px;
            y: 64px;
            width: 32px;
            height: 32px;
            icon-size: 16px;
            show-backdrop: false;
            icon: root.next_icon;
            icon-color: AppTheme.secondary-text;
            acts-on-press: true;
            clicked => { root.next_track(); }
        }
        if root.has-track : BarGlyph {
            x: 224px;
            y: 66px;
            commands: "M12 20.5 L4.6 13.1 A4.9 4.9 0 0 1 11.5 6.2 L12 6.7 L12.5 6.2 A4.9 4.9 0 0 1 19.4 13.1 Z";
            filled: root.track_liked;
            lit: root.track_liked;
            clicked => { root.toggle_like(); }
        }

        if root.has-track : Text {
            x: 260px;
            y: 66px;
            width: parent.width - 260px - 16px;
            height: 28px;
            text: (mini-seek.dragging ? root.format-ms(mini-seek.display-value) : root.elapsed) + " / " + root.duration;
            color: AppTheme.muted-text;
            font-size: 11px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        if root.can_keep_on_top : MiniWindowButton {
            x: parent.width - 96px;
            y: 8px;
            label: root.mini_on_top ? "Stop keeping on top" : "Keep on top";
            commands: "M4 1 L8 1 L8 5 L10 7.5 L2 7.5 L4 5 Z M6 7.5 L6 11";
            lit: root.mini_on_top;
            clicked => {
                root.mini_on_top = !root.mini_on_top;
                root.mini_on_top_changed(root.mini_on_top);
            }
        }
        MiniWindowButton {
            x: parent.width - 66px;
            y: 8px;
            label: "Full window";
            commands: "M7 1 L11 1 L11 5 M11 1 L7.5 4.5 M5 11 L1 11 L1 7 M1 11 L4.5 7.5";
            clicked => { root.toggle_mini_player(); }
        }
        MiniWindowButton {
            x: parent.width - 36px;
            y: 8px;
            label: "Close";
            danger: true;
            commands: "M1.5 1.5 L10.5 10.5 M10.5 1.5 L1.5 10.5";
            clicked => { root.close_window(); }
        }

        // The song's progress runs along the bottom edge, and the strip over it seeks.
        Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            height: mini-seek.hovering ? 4px : 2px;
            background: AppTheme.text.transparentize(mini-seek.hovering ? 0.88 : 0.94);
            animate height { duration: AppTheme.motion-duration; easing: ease-out; }
            Rectangle {
                x: 0px;
                width: parent.width * max(0.0, min(1.0, mini-seek.display-value * 1.0 / max(1, root.progress_max_ms)));
                height: parent.height;
                background: mini-seek.hovering ? AppTheme.accent : AppTheme.text.transparentize(0.25);
                animate background { duration: AppTheme.motion-duration; easing: ease-out; }
            }
        }
        mini-seek := SlimSlider {
            visible: root.has-track;
            x: 0px;
            y: parent.height - self.height;
            width: parent.width;
            height: 12px;
            show-bar: false;
            value: root.progress_ms;
            maximum: root.progress_max_ms;
            tooltip-text: root.has-track ? root.format-ms(self.pointer-value) : "";
            changed(v) => {
                root.progress_ms = v;
                root.elapsed = root.format-ms(v);
                root.seek_to(v);
            }
        }
    }

    // ── Overlays (drawn on top) ──────────────────────────────────────────

    // A cover's name, beside it in the small library.
    if root.compact_sidebars && !root.library-moving && root.library-tip >= 0 && root.library-tip < root.playlist_titles.length : Rectangle {
        property <float> shown: 0;
        init => { self.shown = 1; }
        animate shown { duration: AppTheme.motion-duration; easing: ease-out; }
        opacity: self.shown;
        x: 8px + root.library-small + 8px;
        y: root.library-tip-y + 5px;
        width: min(260px, tip-words.preferred-width);
        height: 44px;
        border-radius: 9px;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000060;
        GlassPane {
            radius: 9px;
            background: AppTheme.window-bg.with-alpha(0.92);
            tip-words := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                spacing: 0px;
                Text {
                    text: root.playlist_titles[root.library-tip];
                    color: AppTheme.text;
                    font-size: 13px;
                    overflow: elide;
                }
                Text {
                    text: root.playlist_subtitles[root.library-tip];
                    color: AppTheme.muted-text;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }
    }

    // Search suggestions
    if search-input.has-focus && root.search_query != "" : Rectangle {
        x: search-box.absolute-position.x;
        y: search-box.absolute-position.y + search-box.height + 6px;
        width: search-box.width;
        height: suggest-layout.preferred-height;
        border-radius: 11px;
        // Falls behind the glass too, which is what keeps results readable over
        // the page: only about a tenth of what's behind comes through.
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000070;

      GlassPane {
        radius: 11px;
        background: AppTheme.window-bg.with-alpha(0.8);

        suggest-layout := VerticalLayout {
            padding: 6px;
            spacing: 2px;

            if root.search_suggestions.length > 0 : Text { height: 24px; text: "   Playlists"; color: AppTheme.subtle-text; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            for suggestion[i] in root.search_suggestions : Rectangle {
                height: 48px;
                GlassHover { lit: root.search_highlight == i || s-touch.has-hover; radius: 7px; strength: 1; }
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 10px;
                    Rectangle {
                        width: 36px;
                        RoundedArtwork { source: suggestion.art; artwork-size: 36px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: -1px;
                        Text { text: suggestion.title; color: AppTheme.text; font-size: 13px; overflow: elide; }
                        Text { text: suggestion.subtitle; color: AppTheme.subtle-text; font-size: 11px; }
                    }
                }
                s-touch := TouchArea {
                    clicked => {
                        root.open-playlist(suggestion.index);
                        root.search_query = "";
                        root.search_highlight = -1;
                        root.search_changed("");
                        keys.focus();
                    }
                }
            }
            Rectangle {
                height: 40px;
                GlassHover { lit: root.search_highlight == root.search_suggestions.length || (root.search_highlight < 0 && root.search_suggestions.length == 0) || web-touch.has-hover; radius: 7px; strength: 1; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Rectangle {
                        width: 16px;
                        Image { source: root.search_icon; colorize: AppTheme.subtle-text; width: 14px; height: 14px; image-fit: contain; }
                    }
                    Text { text: "Search Spotify for “" + root.search_query + "”"; color: AppTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Text { text: "Enter"; color: AppTheme.subtle-text; font-size: 11px; vertical-alignment: center; }
                }
                web-touch := TouchArea {
                    clicked => { root.run-search(); }
                }
            }
        }
      }
    }

    // Toast
    Rectangle {
        property <float> fade: root.toast_visible ? 1 : 0;
        animate fade { duration: AppTheme.reduce-motion ? 0ms : 180ms; }
        visible: root.toast_visible || self.fade > 0.01;
        opacity: root.toast_visible || self.fade > 0.01 ? self.fade : 1;
        x: (root.width - self.width) / 2;
        y: root.mini_mode
            ? (root.height - self.height) / 2 + (root.toast_visible ? 0px : 6px)
            : root.height - 88px - self.height - (root.toast_visible ? 12px : 0px);
        animate y { duration: AppTheme.motion-spring; easing: ease-out; }
        width: min(toast-label.preferred-width + 36px, root.width - 80px);
        height: 36px;
        border-radius: 18px;
        background: root.toast_error ? AppTheme.danger : AppTheme.text;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
        toast-label := Text {
            width: parent.width - 36px;
            text: root.toast_text;
            color: root.toast_error ? #ffffff : AppTheme.window-bg;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    // Track context menu
    track-menu := PopupWindow {
        close-policy: close-on-click-outside;
        width: 228px;
        // Nine rows, or eight for a song with no album page, three dividers, the gaps and the padding.
        height: (root.track_context_has_album ? 9 : 8) * 32px + 3 * 1px + (root.track_context_has_album ? 12 : 11) * 2px + 12px;
        x: max(8px, min(root.track_context_popup_x, root.width - self.width - 8px));
        y: max(8px, min(root.track_context_popup_y, root.height - self.height - 8px));

        MenuSurface {
            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                MenuItem {
                    text: "Play";
                    hint: "Enter";
                    clicked => {
                        track-menu.close();
                        root.activate_liked_song(root.track_context_index);
                    }
                }
                MenuItem {
                    text: "Play next";
                    hint: "Shift+Enter";
                    clicked => {
                        track-menu.close();
                        root.track_context_action("play-next", root.track_context_index);
                    }
                }
                MenuItem {
                    text: "Add to queue";
                    clicked => {
                        track-menu.close();
                        root.track_context_action("queue", root.track_context_index);
                    }
                }
                Divider { height: 1px; background: AppTheme.text.transparentize(0.9); }
                MenuItem {
                    text: "Add to playlist";
                    clicked => {
                        root.open-picker(root.track_context_uri, root.track_context_title);
                        track-menu.close();
                    }
                }
                MenuItem {
                    text: root.track_context_liked ? "Remove from Liked Songs" : "Save to Liked Songs";
                    clicked => {
                        track-menu.close();
                        root.track_menu_action(root.track_context_liked ? "unlike" : "like", root.track_context_index);
                    }
                }
                Divider { height: 1px; background: AppTheme.text.transparentize(0.9); }
                MenuItem {
                    text: "Go to artist";
                    clicked => {
                        track-menu.close();
                        root.track_menu_action("artist", root.track_context_index);
                    }
                }
                if root.track_context_has_album : MenuItem {
                    text: "Go to album";
                    clicked => {
                        track-menu.close();
                        root.track_menu_action("album", root.track_context_index);
                    }
                }
                MenuItem {
                    text: "Go to song radio";
                    clicked => {
                        track-menu.close();
                        root.track_menu_action("radio", root.track_context_index);
                    }
                }
                Divider { height: 1px; background: AppTheme.text.transparentize(0.9); }
                MenuItem {
                    text: "Copy song link";
                    clicked => {
                        track-menu.close();
                        root.track_menu_action("copy-link", root.track_context_index);
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
